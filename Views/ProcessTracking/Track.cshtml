        </div>
        
        <!-- RAPORLAR TAB -->
        <div class="tab-pane" id="reports">
            <div style="margin-bottom: 24px;">
                <h4 style="margin: 0 0 8px 0; color: #0f172a; font-weight: 700; font-size: 1.25rem;"><i class="fa-solid fa-chart-pie" style="color: #0284c7;"></i> Süreç Raporları</h4>
                <p style="color: #64748b; font-size: 0.95rem; margin: 0;">Siparişin malzeme, kesim ve sevk (çıkış) durumlarını bu ekrandan detaylı olarak inceleyebilirsiniz.</p>
            </div>

            @{
                // 1. Malzeme Raporu Hesaplamaları
                var malzemeler = Model.OrderMaterials != null ? Model.OrderMaterials.ToList() : new List<UretimPlanlama.Models.OrderMaterial>();
                
                string ExtractFromOzelliklerRep(string json, string key) {
                    if (string.IsNullOrEmpty(json)) return null;
                    try {
                        var items = System.Text.Json.JsonSerializer.Deserialize<List<Dictionary<string, string>>>(json);
                        var item = items?.FirstOrDefault(x => x.ContainsKey("Key") && x["Key"].ToUpperInvariant() == key.ToUpperInvariant());
                        if (item != null && item.ContainsKey("Value")) return item["Value"];
                    } catch {}
                    return null;
                }

                var purDataRep = new Dictionary<string, string>();
                if (!string.IsNullOrEmpty(Model.PurchasingMaterialsJson)) {
                    try { purDataRep = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(Model.PurchasingMaterialsJson) ?? new Dictionary<string, string>(); } catch {}
                }
                var colorsRep = new List<string>();
                if (!string.IsNullOrEmpty(Model.Color)) {
                    colorsRep = Model.Color.Split(new[] { ',', '-' }, StringSplitOptions.RemoveEmptyEntries).Select(c => c.Trim().ToUpper()).ToList();
                }
                if (!colorsRep.Any()) colorsRep.Add("GENEL");

                var plannedQuantities = new Dictionary<int, decimal>();
                foreach(var mat in malzemeler) {
                    double totalIstenen = 0;
                    string itemKey = "stk_" + mat.StokKartiId;
                    string cat = (mat.StokKarti?.Kategori ?? "").Trim().ToUpperInvariant();
                    
                    foreach(var c in colorsRep) {
                        string sipAdetiStr = purDataRep.ContainsKey($"pur_color_{c}_siparis_adeti") ? purDataRep[$"pur_color_{c}_siparis_adeti"] : Model.Quantity.ToString();
                        double siparisAdeti = 0; double.TryParse(sipAdetiStr.Replace(",", "."), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out siparisAdeti);
                        
                        if (cat == "KUMAŞ" || cat == "KUMAS") {
                            string kumasIstenenStr = purDataRep.ContainsKey($"pur_color_{c}_beden_miktar") ? purDataRep[$"pur_color_{c}_beden_miktar"] : null;
                            double dKumas = 0;
                            if (kumasIstenenStr != null) {
                                double.TryParse(kumasIstenenStr.Replace(",", "."), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out dKumas);
                            }
                            
                            if (dKumas == 0) {
                                string kumasIhtiyacStr = purDataRep.ContainsKey($"pur_color_{c}_istenen_kumas_miktar") ? purDataRep[$"pur_color_{c}_istenen_kumas_miktar"] : null;
                                if (kumasIhtiyacStr != null) {
                                    double.TryParse(kumasIhtiyacStr.Replace(",", "."), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out dKumas);
                                }
                            }
                            
                            if (dKumas > 0) {
                                totalIstenen += dKumas;
                            } else {
                                string metrajStr = ExtractFromOzelliklerRep(mat.OzelliklerJson, "METRAJ") ?? mat.Miktar.ToString(System.Globalization.CultureInfo.InvariantCulture);
                                double metraj = 0; double.TryParse(metrajStr.Replace(",", "."), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out metraj);
                                totalIstenen += Math.Round(siparisAdeti * metraj);
                            }
                        } else if (cat == "TELA") {
                            string dynBirim = ExtractFromOzelliklerRep(mat.OzelliklerJson, "TELA BİRİM") ?? ExtractFromOzelliklerRep(mat.OzelliklerJson, "BİRİM");
                            string defBirim = !string.IsNullOrEmpty(dynBirim) ? dynBirim : mat.Miktar.ToString(System.Globalization.CultureInfo.InvariantCulture);
                            string birimStr = purDataRep.ContainsKey($"pur_color_{c}_tela_birim_{itemKey}") ? purDataRep[$"pur_color_{c}_tela_birim_{itemKey}"] : defBirim;
                            double birim = 0; double.TryParse(birimStr.Replace(",", "."), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out birim);
                            totalIstenen += Math.Round(siparisAdeti * birim);
                        } else if (cat == "ETİKET" || cat == "ETIKET") {
                            string dynFire = ExtractFromOzelliklerRep(mat.OzelliklerJson, "FİRE (%)") ?? ExtractFromOzelliklerRep(mat.OzelliklerJson, "FIRE") ?? ExtractFromOzelliklerRep(mat.OzelliklerJson, "FİRE");
                            string defFire = !string.IsNullOrEmpty(dynFire) ? dynFire : "0";
                            string fireStr = purDataRep.ContainsKey($"pur_color_{c}_label_fire_{itemKey}") ? purDataRep[$"pur_color_{c}_label_fire_{itemKey}"] : defFire;
                            double fire = 0; double.TryParse(fireStr.Replace(",", "."), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out fire);
                            double tmp = siparisAdeti * 1; 
                            totalIstenen += Math.Round(tmp + Math.Round(tmp * (fire / 100.0)));
                        } else {
                            string dynBirim = ExtractFromOzelliklerRep(mat.OzelliklerJson, "BİRİM KULLANIM") ?? ExtractFromOzelliklerRep(mat.OzelliklerJson, "BİRİM") ?? ExtractFromOzelliklerRep(mat.OzelliklerJson, "BIRIM");
                            string defBirim = !string.IsNullOrEmpty(dynBirim) ? dynBirim : mat.Miktar.ToString(System.Globalization.CultureInfo.InvariantCulture);
                            string birimStr = purDataRep.ContainsKey($"pur_color_{c}_birim_{itemKey}") ? purDataRep[$"pur_color_{c}_birim_{itemKey}"] : defBirim;
                            double birim = 0; double.TryParse(birimStr.Replace(",", "."), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out birim);
                            
                            string dynFire = ExtractFromOzelliklerRep(mat.OzelliklerJson, "FİRE (%)") ?? ExtractFromOzelliklerRep(mat.OzelliklerJson, "FIRE") ?? ExtractFromOzelliklerRep(mat.OzelliklerJson, "FİRE");
                            string defFire = !string.IsNullOrEmpty(dynFire) ? dynFire : (Model.WastageRate ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture);
                            string fireStr = purDataRep.ContainsKey($"pur_color_{c}_fire_{itemKey}") ? purDataRep[$"pur_color_{c}_fire_{itemKey}"] : defFire;
                            double fire = 0; double.TryParse(fireStr.Replace(",", "."), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out fire);
                            
                            double toplam = siparisAdeti * birim;
                            double fazla = Math.Round(toplam * (fire / 100.0));
                            totalIstenen += Math.Round(toplam + fazla);
                        }
                    }
                    decimal planlanan = totalIstenen > 0 ? (decimal)totalIstenen : mat.Miktar;
                    plannedQuantities[mat.Id] = planlanan;
                }

                // 2. Kesim Raporu Hesaplamaları
                var cutRecords = new List<dynamic>();
                int kesimToplam = 0;
                var cutSizes = new Dictionary<string, int>();
                if (!string.IsNullOrEmpty(Model.CuttingProcessJson))
                {
                    try {
                        var cItems = System.Text.Json.JsonSerializer.Deserialize<List<System.Text.Json.JsonElement>>(Model.CuttingProcessJson);
                        if (cItems != null) {
                            foreach(var ci in cItems) {
                                int qty = ci.GetProperty("TotalQuantity").GetInt32();
                                kesimToplam += qty;
                                
                                if (ci.TryGetProperty("Sizes", out var szObj)) {
                                    foreach(var p in szObj.EnumerateObject()) {
                                        if(!cutSizes.ContainsKey(p.Name)) cutSizes[p.Name] = 0;
                                        cutSizes[p.Name] += p.Value.GetInt32();
                                    }
                                }
                            }
                        }
                    } catch {}
                }

                // 3. Sevk Raporu Hesaplamaları
                var sevkListesi = ViewBag.SalesMovements as List<UretimPlanlama.Models.StokHareket> ?? new List<UretimPlanlama.Models.StokHareket>();
                var atolyeSevkleri = sevkListesi.GroupBy(x => x.Tedarikci).Select(g => new {
                    Atolye = string.IsNullOrEmpty(g.Key) ? "Bilinmeyen Atölye" : g.Key,
                    Adet = g.Sum(x => x.Miktar),
                    SonIslem = g.Max(x => x.IslemTarihi)
                }).ToList();
                decimal toplamSevk = sevkListesi.Sum(x => x.Miktar);
            }

            <!-- Özet Kartları -->
            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 30px;">
                <div style="background: white; border-left: 4px solid #10b981; border-radius: 8px; padding: 20px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);">
                    <div style="font-size: 0.85rem; color: #64748b; font-weight: 600; text-transform: uppercase;">Toplam Sipariş / Kesim</div>
                    <div style="font-size: 1.8rem; font-weight: 700; color: #0f172a; margin-top: 8px;">@kesimToplam.ToString("N0") <span style="font-size: 1rem; color: #64748b;">/ @Model.Quantity.ToString("N0")</span></div>
                    @{
                        decimal yuzdeKesim = Model.Quantity > 0 ? ((decimal)kesimToplam / Model.Quantity) * 100 : 0;
                        string kesimRenk = yuzdeKesim >= 100 ? "#10b981" : (yuzdeKesim > 0 ? "#f59e0b" : "#ef4444");
                    }
                    <div style="width: 100%; background: #e2e8f0; height: 6px; border-radius: 3px; margin-top: 10px;">
                        <div style="background: @kesimRenk; height: 6px; border-radius: 3px; width: @(Math.Min(100, yuzdeKesim).ToString(System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                    </div>
                </div>
                
                <div style="background: white; border-left: 4px solid #3b82f6; border-radius: 8px; padding: 20px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);">
                    <div style="font-size: 0.85rem; color: #64748b; font-weight: 600; text-transform: uppercase;">Toplam Sevk (Çıkış)</div>
                    <div style="font-size: 1.8rem; font-weight: 700; color: #0f172a; margin-top: 8px;">@toplamSevk.ToString("N2") <span style="font-size: 1rem; color: #64748b;">adet</span></div>
                </div>
            </div>

            <!-- Malzeme Durumu -->
            <div style="background: white; border-radius: 8px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); padding: 24px; margin-bottom: 30px;">
                <h5 style="margin: 0 0 16px 0; font-weight: 700; color: #0f172a; border-bottom: 2px solid #f1f5f9; padding-bottom: 12px;"><i class="fa-solid fa-boxes-stacked" style="color: #6366f1;"></i> Malzeme İhtiyaç Raporu</h5>
                <div style="overflow-x: auto;">
                    <table class="table" style="margin-bottom: 0;">
                        <thead>
                            <tr>
                                <th>Malzeme Kodu / Adı</th>
                                <th style="text-align: right;">Planlanan Miktar</th>
                                <th style="text-align: right;">Gerçekleşen (Alınan)</th>
                                <th style="text-align: right;">Fark</th>
                                <th>Durum</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if(malzemeler.Any()) {
                                foreach(var m in malzemeler) {
                                    decimal planlanan = plannedQuantities.ContainsKey(m.Id) ? plannedQuantities[m.Id] : m.Miktar;
                                    decimal fark = m.ActualQuantity - planlanan;
                                    string farkRenk = fark >= 0 ? (fark == 0 ? "#10b981" : "#3b82f6") : "#ef4444";
                                    string durumText = fark > 0 ? "FAZLA" : (fark < 0 ? "EKSİK" : "TAM");
                                    string durumBg = fark > 0 ? "#dbeafe" : (fark < 0 ? "#fee2e2" : "#d1fae5");
                                    string durumColor = fark > 0 ? "#1d4ed8" : (fark < 0 ? "#b91c1c" : "#047857");

                                    string dynBoyut = ExtractFromOzelliklerRep(m.OzelliklerJson, "BOYUT") ?? ExtractFromOzelliklerRep(m.OzelliklerJson, "EBAT") ?? ExtractFromOzelliklerRep(m.OzelliklerJson, "BÜYÜKLÜK") ?? ExtractFromOzelliklerRep(m.OzelliklerJson, "BOY");
                                    string extraInfo = !string.IsNullOrEmpty(dynBoyut) ? dynBoyut : m.Aciklama;
                                    string displayName = !string.IsNullOrEmpty(extraInfo) ? $"{(m.StokKarti != null ? m.StokKarti.StokKodu + " - " + m.StokKarti.StokAdi : "Bilinmeyen Malzeme")} ({extraInfo})" : (m.StokKarti != null ? m.StokKarti.StokKodu + " - " + m.StokKarti.StokAdi : "Bilinmeyen Malzeme");

                                    <tr>
                                        <td style="font-weight: 600;">@displayName</td>
                                        <td style="text-align: right; color: #64748b;">@planlanan.ToString("N2")</td>
                                        <td style="text-align: right; font-weight: bold; color: #0f172a;">@m.ActualQuantity.ToString("N2")</td>
                                        <td style="text-align: right; color: @farkRenk; font-weight: bold;">
                                            @(fark > 0 ? "+" : "")@fark.ToString("N2")
                                        </td>
                                        <td>
                                            <span style="background: @durumBg; color: @durumColor; padding: 4px 8px; border-radius: 4px; font-size: 0.75rem; font-weight: 700;">@durumText</span>
                                        </td>
                                    </tr>
                                }
                            } else {
                                <tr><td colspan="5" style="text-align: center; color: #64748b; padding: 20px;">Bu siparişe ait malzeme planlaması bulunamadı.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 30px;">
                <!-- Kesim Beden Raporu -->
                <div style="background: white; border-radius: 8px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); padding: 24px;">
                    <h5 style="margin: 0 0 16px 0; font-weight: 700; color: #0f172a; border-bottom: 2px solid #f1f5f9; padding-bottom: 12px;"><i class="fa-solid fa-scissors" style="color: #f59e0b;"></i> Kesim Detayı (Bedenlere Göre)</h5>
                    <table class="table" style="margin-bottom: 0;">
                        <thead>
                            <tr>
                                <th>Beden</th>
                                <th style="text-align: right;">Kesim Adedi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if(cutSizes.Any()) {
                                foreach(var kvp in cutSizes.OrderBy(x => x.Key)) {
                                    <tr>
                                        <td style="font-weight: bold;">@kvp.Key</td>
                                        <td style="text-align: right; font-weight: 600;">@kvp.Value.ToString("N0")</td>
                                    </tr>
                                }
                                <tr style="background: #f8fafc;">
                                    <td style="font-weight: 800; text-align: right;">TOPLAM KESİM:</td>
                                    <td style="text-align: right; font-weight: 800; color: #10b981;">@kesimToplam.ToString("N0")</td>
                                </tr>
                            } else {
                                <tr><td colspan="2" style="text-align: center; color: #64748b; padding: 20px;">Henüz kesim işlemi girilmemiş.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Sevk Atölye Raporu -->
                <div style="background: white; border-radius: 8px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); padding: 24px;">
                    <h5 style="margin: 0 0 16px 0; font-weight: 700; color: #0f172a; border-bottom: 2px solid #f1f5f9; padding-bottom: 12px;"><i class="fa-solid fa-truck-fast" style="color: #ec4899;"></i> Atölye Çıkış (Sevk) Raporu</h5>
                    <table class="table" style="margin-bottom: 0;">
                        <thead>
                            <tr>
                                <th>Atölye (Cari)</th>
                                <th>Son Çıkış</th>
                                <th style="text-align: right;">Toplam Çıkış</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if(atolyeSevkleri.Any()) {
                                foreach(var a in atolyeSevkleri.OrderByDescending(x => x.Adet)) {
                                    <tr>
                                        <td style="font-weight: 600;">@a.Atolye</td>
                                        <td style="font-size: 0.85rem; color: #64748b;">@a.SonIslem.ToString("dd.MM.yyyy")</td>
                                        <td style="text-align: right; font-weight: bold; color: #0f172a;">@a.Adet.ToString("N2")</td>
                                    </tr>
                                }
                                <tr style="background: #f8fafc;">
                                    <td colspan="2" style="font-weight: 800; text-align: right;">GENEL TOPLAM ÇIKIŞ:</td>
                                    <td style="text-align: right; font-weight: 800; color: #3b82f6;">@toplamSevk.ToString("N2")</td>
                                </tr>
                            } else {
                                <tr><td colspan="3" style="text-align: center; color: #64748b; padding: 20px;">Henüz herhangi bir atölyeye çıkış yapılmamış.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const orderId = @Model.Id;
        
        let dispatchItems = @Html.Raw(string.IsNullOrEmpty(Model.MaterialDispatchJson) ? "[]" : Model.MaterialDispatchJson);
        let cuttingItems = @Html.Raw(string.IsNullOrEmpty(Model.CuttingProcessJson) ? "[]" : Model.CuttingProcessJson);

        $(document).ready(function() {
            renderDispatchTable();
            renderCuttingTable();
            
            // Initial comparison calculation
            $('input[id^="actual_qty_"]').each(function() {
                $(this).trigger('input');
            });
        });

        // --- TAB SWITCH LOGIC ---
        function switchTab(tabId) {
            $('.nav-link').removeClass('active');
            $('.tab-pane').removeClass('active');
            
            $('#' + tabId + '-tab').addClass('active');
            $('#' + tabId).addClass('active');
        }

        // --- COMPARISON LOGIC ---
        function updateComparison(materialId, plannedQty) {
            const actualInput = $('#actual_qty_' + materialId);
            const actualQty = parseFloat(actualInput.val()) || 0;
            const compSpan = $('#comp_' + materialId);
            
            if (actualQty === 0) {
                compSpan.text("-").css({ 'background': '#f1f5f9', 'color': '#64748b' });
                return;
            }
            
            const diff = actualQty - plannedQty;
            if (Math.abs(diff) < 0.01) {
                compSpan.text("TAM").css({ 'background': '#dcfce7', 'color': '#166534' });
            } else if (diff > 0) {
                compSpan.text("FAZLA (+" + diff.toLocaleString('tr-TR', { maximumFractionDigits: 2 }) + ")").css({ 'background': '#e0e7ff', 'color': '#3730a3' });
            } else {
                compSpan.text("EKSİK (" + diff.toLocaleString('tr-TR', { maximumFractionDigits: 2 }) + ")").css({ 'background': '#fee2e2', 'color': '#991b1b' });
            }
        }

        // --- TAB 1: SATIN ALMA ONAYI ---
        function updateMaterialApproval(materialId) {
            const isChecked = $('#chk_mat_' + materialId).is(':checked');
            const actualQty = parseFloat($('#actual_qty_' + materialId).val()) || 0;
            
            // Update wrapper div styling
            $('#div_mat_' + materialId)
                .css('background', isChecked ? "#dcfce7" : "#fffbeb")
                .css('border-color', isChecked ? "#bbf7d0" : "#fef08a");
                
            // Update row background color dynamically
            $('#chk_mat_' + materialId).closest('tr').css('background', isChecked ? "#f0fdf4" : "transparent");
            
            $.post('/ProcessTracking/UpdateMaterialApproval', { materialId: materialId, actualQuantity: actualQty, isApproved: isChecked }, function(res) {
                if(res.success) {
                    showToast("Malzeme onayı güncellendi.", "success");
                } else {
                    showToast("Hata: " + res.message, "danger");
                }
            });
        }

        // --- TAB 2: MALZEME SEVK (Cari Satış Onayı) ---
        function updateDispatchApproval(hareketId) {
            const isChecked = $('#chk_disp_' + hareketId).is(':checked');
            
            // Update wrapper div styling
            $('#div_disp_' + hareketId)
                .css('background', isChecked ? "#dcfce7" : "#fffbeb")
                .css('border-color', isChecked ? "#bbf7d0" : "#fef08a");
                
            // Update row background color dynamically
            $('#chk_disp_' + hareketId).closest('tr').css('background', isChecked ? "#f0fdf4" : "transparent");
            
            $.post('/ProcessTracking/UpdateDispatchApproval', { hareketId: hareketId, isApproved: isChecked }, function(res) {
                if(res.success) {
                    showToast("Sevk onayı güncellendi.", "success");
                } else {
                    showToast("Hata: " + res.message, "danger");
                }
            });
        }

        // --- TAB 3: KESİM SÜRECİ ---
        function calculateCutting() {
            const multiplier = parseFloat($('#txtCutMultiplier').val()) || 1;
            const markerLength = parseFloat($('#txtMarkerLength').val()) || 0;
            
            let totalQty = 0;
            const sizes = {};
            $('.cut-size-input').each(function() {
                const sizeName = $(this).data('size');
                const val = parseFloat($(this).val()) || 0;
                sizes[sizeName] = val;
                totalQty += val;
            });
            
            $('#txtCutTotal').val(totalQty);
            
            if (totalQty > 0) {
                const unitMet = (markerLength * multiplier) / totalQty;
                $('#txtCutUnitMeterage').val(unitMet.toFixed(2));
            } else {
                $('#txtCutUnitMeterage').val('0');
            }
        }

        function addCuttingItem() {
            const date = $('#txtCutDate').val();
            const multiplier = parseFloat($('#txtCutMultiplier').val()) || 1;
            const markerLength = parseFloat($('#txtMarkerLength').val()) || 0;
            const totalQty = parseFloat($('#txtCutTotal').val()) || 0;
            const unitMeterage = parseFloat($('#txtCutUnitMeterage').val()) || 0;

            if (totalQty <= 0) {
                showToast("Lütfen en az bir beden için kesim adeti giriniz.", "warning");
                return;
            }

            const sizes = {};
            $('.cut-size-input').each(function() {
                const sizeName = $(this).data('size');
                const val = parseFloat($(this).val()) || 0;
                if(val > 0) sizes[sizeName] = val;
            });

            cuttingItems.push({
                Date: date,
                Multiplier: multiplier,
                Sizes: sizes,
                TotalQuantity: totalQty,
                MarkerLength: markerLength,
                UnitMeterage: unitMeterage
            });

            renderCuttingTable();
            // Reset
            $('.cut-size-input').val('0');
            calculateCutting();
        }

        function removeCuttingItem(index) {
            cuttingItems.splice(index, 1);
            renderCuttingTable();
        }

        function renderCuttingTable() {
            let html = '';
            cuttingItems.forEach((item, index) => {
                let sizesStr = Object.entries(item.Sizes).map(([k, v]) => `${k}:${v}`).join(', ');
                html += `
                    <tr>
                        <td>${item.Date}</td>
                        <td>${item.Multiplier}</td>
                        <td><small>${sizesStr}</small></td>
                        <td><strong>${item.TotalQuantity}</strong></td>
                        <td>${item.MarkerLength}</td>
                        <td>${item.UnitMeterage}</td>
                        <td><button class="btn btn-sm btn-danger" onclick="removeCuttingItem(${index})"><i class="fa-solid fa-trash"></i></button></td>
                    </tr>
                `;
            });
            $('#cuttingBody').html(html);
        }

        function saveCutting() {
            $.ajax({
                url: '/ProcessTracking/UpdateCuttingProcess',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ Id: orderId, CuttingProcessJson: JSON.stringify(cuttingItems) }),
                success: function(res) {
                    if(res.success) showToast("Kesim bilgileri kaydedildi.", "success");
                    else showToast("Hata: " + res.message, "danger");
                }
            });
        }

        function showToast(message, type) {
            $("#floatingToast").remove();
            var bgColor = type === "success" ? "#d1fae5" : "#fee2e2";
            var textColor = type === "success" ? "#065f46" : "#991b1b";
            var borderClr = type === "success" ? "rgba(52, 211, 153, 0.4)" : "rgba(248, 113, 113, 0.4)";
            var icon = type === "success" ? "fa-solid fa-circle-check" : "fa-solid fa-circle-exclamation";
            var toast = $('<div id="floatingToast" style="position: fixed; top: 20px; right: 20px; background-color: ' + bgColor + '; color: ' + textColor + '; border: 1px solid ' + borderClr + '; padding: 16px 24px; border-radius: 12px; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); z-index: 9999; display: flex; align-items: center; gap: 10px; font-weight: 500; font-size: 0.95rem; min-width: 300px; transition: opacity 0.5s;">' +
                '<i class="' + icon + '" style="font-size: 1.2rem;"></i>' +
                '<span>' + message + '</span>' +
                '</div>');
            $("body").append(toast);
            setTimeout(function () {
                toast.css('opacity', '0');
                setTimeout(function () { toast.remove(); }, 500);
            }, 3000);
        }
    </script>
}
