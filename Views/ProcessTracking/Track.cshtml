<div class="tabs-container">
    <ul class="nav nav-tabs" id="trackTabs">
        <li class="nav-item">
            <button class="nav-link active" onclick="switchTab('purchase')" id="purchase-tab">Satın Alma Onay</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" onclick="switchTab('dispatch')" id="dispatch-tab">Malzeme Sevk</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" onclick="switchTab('cutting')" id="cutting-tab">Kesim Süreci</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" onclick="switchTab('packing')" id="packing-tab">Çeki Listesi</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" onclick="switchTab('reports')" id="reports-tab" style="background: #e0f2fe; color: #0284c7;">Raporlar <i class="fa-solid fa-chart-pie"></i></button>
        </li>
    </ul>

    <div class="tab-content" id="trackTabsContent">
        
        <!-- SATIN ALMA ONAYI TAB -->
        <div class="tab-pane active" id="purchase">
            <div style="margin-bottom: 24px;">
                <h4 style="margin: 0 0 8px 0; color: #0f172a; font-weight: 700; font-size: 1.25rem;"><i class="fa-solid fa-check-double" style="color: var(--primary-color);"></i> Satın Alma Onayı</h4>
                <p style="color: #64748b; font-size: 0.95rem; margin: 0;">Satın alma planlamasında girilen ürünlerin girişleri (alış faturası / depo fişi) yapıldıysa aşağıdan gerçekleşen miktarı girip onaylayınız.</p>
            </div>

            <div style="background: white; border-radius: 8px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); border: 1px solid #e2e8f0; overflow: hidden; margin-top: 16px;">
                <table style="margin: 0; width: 100%; border-collapse: collapse;">
                    <thead style="background: #f8fafc; border-bottom: 2px solid #e2e8f0;">
                        <tr>
                            <th style="padding: 16px; text-align: left; font-weight: 600; color: #475569; font-size: 0.85rem; border-right: 1px solid #e2e8f0;">MALZEME</th>
                            <th style="padding: 16px; text-align: right; font-weight: 600; color: #b45309; font-size: 0.85rem; background: #fef08a; border-right: 1px solid #e2e8f0;">PLANLANAN MİKTAR</th>
                            <th style="padding: 16px; text-align: center; font-weight: 600; color: #0284c7; font-size: 0.85rem; background: #e0f2fe; border-right: 1px solid #e2e8f0;">GERÇEKLEŞEN MİKTAR</th>
                            <th style="padding: 16px; text-align: center; font-weight: 600; color: #475569; font-size: 0.85rem; border-right: 1px solid #e2e8f0;">KARŞILAŞTIRMA</th>
                            <th style="padding: 16px; text-align: center; font-weight: 600; color: #475569; font-size: 0.85rem;">DURUM / ONAY</th>
                        </tr>
                    </thead>
                    <tbody>
                    @{
                        string ExtractFromOzellikler(string json, string key) {
                            if (string.IsNullOrEmpty(json)) return null;
                            try {
                                var items = System.Text.Json.JsonSerializer.Deserialize<List<Dictionary<string, string>>>(json);
                                var item = items?.FirstOrDefault(x => x.ContainsKey("Key") && x["Key"].ToUpperInvariant() == key.ToUpperInvariant());
                                if (item != null && item.ContainsKey("Value")) return item["Value"];
                            } catch {}
                            return null;
                        }

                        var purDataTrack = new Dictionary<string, string>();
                        if (!string.IsNullOrEmpty(Model.PurchasingMaterialsJson)) {
                            try { purDataTrack = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(Model.PurchasingMaterialsJson) ?? new Dictionary<string, string>(); } catch {}
                        }
                        var trackColors = new List<string>();
                        if (!string.IsNullOrEmpty(Model.Color)) {
                            trackColors = Model.Color.Split(new[] { ',', '-' }, StringSplitOptions.RemoveEmptyEntries).Select(c => c.Trim().ToUpper()).ToList();
                        }
                        if (!trackColors.Any()) trackColors.Add("GENEL");
                    }
                    @foreach(var mat in Model.OrderMaterials) {
                        double totalIstenen = 0;
                        string itemKey = "stk_" + mat.StokKartiId;
                        string cat = (mat.StokKarti?.Kategori ?? "").Trim().ToUpperInvariant();
                        
                        foreach(var c in trackColors) {
                            string sipAdetiStr = purDataTrack.ContainsKey($"pur_color_{c}_siparis_adeti") ? purDataTrack[$"pur_color_{c}_siparis_adeti"] : Model.Quantity.ToString();
                            double siparisAdeti = 0; double.TryParse(sipAdetiStr.Replace(",", "."), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out siparisAdeti);
                            
                            if (cat == "KUMAŞ" || cat == "KUMAS") {
                                string kumasIstenenStr = purDataTrack.ContainsKey($"pur_color_{c}_beden_miktar") ? purDataTrack[$"pur_color_{c}_beden_miktar"] : null;
                                double dKumas = 0;
                                if (kumasIstenenStr != null) {
                                    double.TryParse(kumasIstenenStr.Replace(",", "."), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out dKumas);
                                }
                                
                                if (dKumas == 0) {
                                    string kumasIhtiyacStr = purDataTrack.ContainsKey($"pur_color_{c}_istenen_kumas_miktar") ? purDataTrack[$"pur_color_{c}_istenen_kumas_miktar"] : null;
                                    if (kumasIhtiyacStr != null) {
                                        double.TryParse(kumasIhtiyacStr.Replace(",", "."), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out dKumas);
                                    }
                                }
                                
                                if (dKumas > 0) {
                                    totalIstenen += dKumas;
                                } else {
                                    string metrajStr = ExtractFromOzellikler(mat.OzelliklerJson, "METRAJ") ?? mat.Miktar.ToString(System.Globalization.CultureInfo.InvariantCulture);
                                    double metraj = 0; double.TryParse(metrajStr.Replace(",", "."), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out metraj);
                                    totalIstenen += Math.Round(siparisAdeti * metraj);
                                }
                            } else if (cat == "TELA") {
                                string dynBirim = ExtractFromOzellikler(mat.OzelliklerJson, "TELA BİRİM") ?? ExtractFromOzellikler(mat.OzelliklerJson, "BİRİM");
                                string defBirim = !string.IsNullOrEmpty(dynBirim) ? dynBirim : mat.Miktar.ToString(System.Globalization.CultureInfo.InvariantCulture);
                                string birimStr = purDataTrack.ContainsKey($"pur_color_{c}_tela_birim_{itemKey}") ? purDataTrack[$"pur_color_{c}_tela_birim_{itemKey}"] : defBirim;
                                double birim = 0; double.TryParse(birimStr.Replace(",", "."), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out birim);
                                totalIstenen += Math.Round(siparisAdeti * birim);
                            } else if (cat == "ETİKET" || cat == "ETIKET") {
                                string dynFire = ExtractFromOzellikler(mat.OzelliklerJson, "FİRE (%)") ?? ExtractFromOzellikler(mat.OzelliklerJson, "FIRE") ?? ExtractFromOzellikler(mat.OzelliklerJson, "FİRE");
                                string defFire = !string.IsNullOrEmpty(dynFire) ? dynFire : "0";
                                string fireStr = purDataTrack.ContainsKey($"pur_color_{c}_label_fire_{itemKey}") ? purDataTrack[$"pur_color_{c}_label_fire_{itemKey}"] : defFire;
                                double fire = 0; double.TryParse(fireStr.Replace(",", "."), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out fire);
                                double tmp = siparisAdeti * 1; 
                                totalIstenen += Math.Round(tmp + Math.Round(tmp * (fire / 100.0)));
                            } else {
                                string dynBirim = ExtractFromOzellikler(mat.OzelliklerJson, "BİRİM KULLANIM") ?? ExtractFromOzellikler(mat.OzelliklerJson, "BİRİM") ?? ExtractFromOzellikler(mat.OzelliklerJson, "BIRIM");
                                string defBirim = !string.IsNullOrEmpty(dynBirim) ? dynBirim : mat.Miktar.ToString(System.Globalization.CultureInfo.InvariantCulture);
                                string birimStr = purDataTrack.ContainsKey($"pur_color_{c}_birim_{itemKey}") ? purDataTrack[$"pur_color_{c}_birim_{itemKey}"] : defBirim;
                                double birim = 0; double.TryParse(birimStr.Replace(",", "."), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out birim);
                                
                                string dynFire = ExtractFromOzellikler(mat.OzelliklerJson, "FİRE (%)") ?? ExtractFromOzellikler(mat.OzelliklerJson, "FIRE") ?? ExtractFromOzellikler(mat.OzelliklerJson, "FİRE");
                                string defFire = !string.IsNullOrEmpty(dynFire) ? dynFire : (Model.WastageRate ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture);
                                string fireStr = purDataTrack.ContainsKey($"pur_color_{c}_fire_{itemKey}") ? purDataTrack[$"pur_color_{c}_fire_{itemKey}"] : defFire;
                                double fire = 0; double.TryParse(fireStr.Replace(",", "."), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out fire);
                                
                                double toplam = siparisAdeti * birim;
                                double fazla = Math.Round(toplam * (fire / 100.0));
                                totalIstenen += Math.Round(toplam + fazla);
                            }
                        }
                        
                        string displayPlanlanan = totalIstenen > 0 ? totalIstenen.ToString("N0") : mat.Miktar.ToString("N2");
                        
                        string dynBoyut = ExtractFromOzellikler(mat.OzelliklerJson, "BOYUT") ?? ExtractFromOzellikler(mat.OzelliklerJson, "EBAT") ?? ExtractFromOzellikler(mat.OzelliklerJson, "BÜYÜKLÜK") ?? ExtractFromOzellikler(mat.OzelliklerJson, "BOY");
                        string extraInfo = !string.IsNullOrEmpty(dynBoyut) ? dynBoyut : mat.Aciklama;
                        string displayName = !string.IsNullOrEmpty(extraInfo) ? $"{mat.StokKarti?.StokAdi ?? "Bilinmeyen"} ({extraInfo})" : (mat.StokKarti?.StokAdi ?? "Bilinmeyen");

                        <tr style="background: @(mat.IsApproved ? "#f0fdf4" : "white"); border-bottom: 1px solid #f1f5f9; transition: background 0.3s ease;">
                            <td style="padding: 16px; font-weight: 600; color: #334155; border-right: 1px solid #f1f5f9;">@displayName</td>
                            <td style="padding: 16px; font-weight: 700; color: #b45309; text-align: right; background: #fdf6e3; border-right: 1px solid #f1f5f9; font-size: 1.1rem;">@displayPlanlanan</td>
                            <td style="padding: 16px; width: 250px; background: #f0f9ff; border-right: 1px solid #f1f5f9;">
                                <div style="display: flex; align-items: center; justify-content: center;">
                                    <input type="number" step="0.01" style="width: 120px; padding: 8px 12px; border: 1px solid #bae6fd; border-radius: 6px; text-align: right; font-weight: 600; color: #0284c7; outline: none; box-shadow: inset 0 1px 2px rgba(0,0,0,0.05);" id="actual_qty_@mat.Id" value="@mat.ActualQuantity.ToString("F2").Replace(',', '.')" oninput="updateComparison(@mat.Id, @(totalIstenen > 0 ? totalIstenen.ToString(System.Globalization.CultureInfo.InvariantCulture) : mat.Miktar.ToString(System.Globalization.CultureInfo.InvariantCulture)))" />
                                </div>
                            </td>
                            <td style="padding: 16px; text-align: center; border-right: 1px solid #f1f5f9; vertical-align: middle;">
                                <span id="comp_@mat.Id" style="font-weight: 700; font-size: 0.9rem; padding: 6px 12px; border-radius: 6px; display: inline-block; min-width: 80px;">-</span>
                            </td>
                            <td style="padding: 16px; text-align: center;">
