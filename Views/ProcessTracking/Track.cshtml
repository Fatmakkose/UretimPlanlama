@model UretimPlanlama.Models.Order
@{
    ViewData["Title"] = "Süreç Takip Detay";
    var stokKartlari = ViewBag.StokKartlari as List<UretimPlanlama.Models.StokKarti> ?? new List<UretimPlanlama.Models.StokKarti>();
    var workshops = ViewBag.Workshops as List<UretimPlanlama.Models.Workshop> ?? new List<UretimPlanlama.Models.Workshop>();

    var prodData = new System.Collections.Generic.Dictionary<string, string>();
    if (!string.IsNullOrEmpty(Model.ProductionJson))
    {
        try {
            prodData = System.Text.Json.JsonSerializer.Deserialize<System.Collections.Generic.Dictionary<string, string>>(Model.ProductionJson);
        } catch {}
    }
    string GetProdVal(string key) => prodData != null && prodData.ContainsKey(key) ? prodData[key] : "";

    var purData = new System.Collections.Generic.Dictionary<string, string>();
    if (!string.IsNullOrEmpty(Model.PurchasingMaterialsJson))
    {
        try {
            purData = System.Text.Json.JsonSerializer.Deserialize<System.Collections.Generic.Dictionary<string, string>>(Model.PurchasingMaterialsJson);
        } catch {}
    }
    string GetPurVal(string key) => purData != null && purData.ContainsKey(key) ? purData[key] : "";

    string colorKey = string.IsNullOrEmpty(Model.Color) ? "GENEL" : Model.Color;
    string plannedCutQtyStr = GetPurVal($"pur_color_{colorKey}_beden_cikacak");
    if (string.IsNullOrEmpty(plannedCutQtyStr)) {
        plannedCutQtyStr = GetPurVal("pur_color_GENEL_beden_cikacak");
    }
    int plannedCutQty = Model.CalculatedQuantity;
    if (!string.IsNullOrEmpty(plannedCutQtyStr) && int.TryParse(plannedCutQtyStr.Replace(".", ""), out int parsedVal) && parsedVal > 0)
    {
        plannedCutQty = parsedVal;
    }

    int totalCutQty = 0;
    if (!string.IsNullOrEmpty(Model.CuttingProcessJson))
    {
        try {
            using var doc = System.Text.Json.JsonDocument.Parse(Model.CuttingProcessJson);
            foreach(var item in doc.RootElement.EnumerateArray())
            {
                if(item.TryGetProperty("TotalQuantity", out var tq)) {
                    if (tq.ValueKind == System.Text.Json.JsonValueKind.Number) {
                        totalCutQty += tq.GetInt32();
                    } else if (tq.ValueKind == System.Text.Json.JsonValueKind.String && int.TryParse(tq.GetString(), out int q)) {
                        totalCutQty += q;
                    }
                }
            }
        } catch {}
    }
    int packingQty = totalCutQty > 0 ? totalCutQty : Model.Quantity;
}

