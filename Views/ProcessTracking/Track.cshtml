                                        if (Model.SizeM > 0) sizesObj.Add("M", Model.SizeM.ToString());
                                        if (Model.SizeL > 0) sizesObj.Add("L", Model.SizeL.ToString());
                                        if (Model.SizeXL > 0) sizesObj.Add("XL", Model.SizeXL.ToString());
                                        if (Model.Size2XL > 0) sizesObj.Add("2XL", Model.Size2XL.ToString());
                                        if (Model.Size3XL > 0) sizesObj.Add("3XL", Model.Size3XL.ToString());
