                                    <td style="border: 1px solid black; padding: 8px; background-color: #fefce8; cursor: text;" contenteditable="true" title="Manuel düzenleyebilirsiniz"></td>
                                    <td style="border: 1px solid black; padding: 8px; background-color: #fefce8; cursor: text;" contenteditable="true" title="Manuel düzenleyebilirsiniz"></td>
                                    <td style="border: 1px solid black; padding: 8px; background-color: #fefce8; cursor: text;" contenteditable="true" title="Manuel düzenleyebilirsiniz"></td>
                                </tr>
                            }
                        } else {
                            <tr>
                                <td style="border: 1px solid black; padding: 8px; font-weight: bold;">@Model.OrderCode</td>
                                <td style="border: 1px solid black; padding: 8px; font-weight: bold;">BUB</td>
                                <td style="border: 1px solid black; padding: 8px; font-weight: bold;">@Model.OptionCode</td>
                                <td style="border: 1px solid black; padding: 8px; font-weight: bold;">@Model.Color</td>
                                <td style="border: 1px solid black; padding: 8px; font-weight: bold;">@Model.ModelName</td>
                                <td style="border: 1px solid black; padding: 8px;"></td>
                                <td style="border: 1px solid black; padding: 8px; background-color: #fefce8; cursor: text;" contenteditable="true" title="Manuel düzenleyebilirsiniz"></td>
                                <td style="border: 1px solid black; padding: 8px; background-color: #fefce8; cursor: text;" contenteditable="true" title="Manuel düzenleyebilirsiniz"></td>
                                <td style="border: 1px solid black; padding: 8px; background-color: #fefce8; cursor: text;" contenteditable="true" title="Manuel düzenleyebilirsiniz"></td>
                                <td style="border: 1px solid black; padding: 8px; background-color: #fefce8; cursor: text;" contenteditable="true" title="Manuel düzenleyebilirsiniz"></td>
                            </tr>
                        }
                        <tr>
                            <td colspan="6" style="border: 1px solid black;"></td>
                            <td colspan="2" style="border: 1px solid black; padding: 8px; text-align: right; font-weight: bold;">TOPLAM ADET</td>
                            <td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold; background-color: #fefce8; cursor: text;" contenteditable="true" title="Manuel düzenleyebilirsiniz"></td>
                        </tr>
                        <tr>
                            <td colspan="6" style="border: 1px solid black;"></td>
                            <td colspan="2" style="border: 1px solid black; padding: 8px; text-align: right; font-weight: bold;">TOPLAM KOLİ SAYISI</td>
                            <td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold; background-color: #fefce8; cursor: text;" contenteditable="true" title="Manuel düzenleyebilirsiniz"></td>
