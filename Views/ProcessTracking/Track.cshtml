                                        <td rowspan="@rowSpan" style="border: 1px solid black; padding: 8px; font-weight: bold;">@Model.OptionCode</td>
                                        <td rowspan="@rowSpan" style="border: 1px solid black; padding: 8px; font-weight: bold;">@Model.Color</td>
                                        <td rowspan="@rowSpan" style="border: 1px solid black; padding: 8px; font-weight: bold;">@Model.ModelName</td>
                                        <td rowspan="@rowSpan" style="border: 1px solid black; padding: 8px; font-weight: bold;"></td>
                                        <td rowspan="@rowSpan" style="border: 1px solid black; padding: 8px; font-weight: bold; background-color: #fefce8; cursor: text;" contenteditable="true" title="Manuel düzenleyebilirsiniz"></td>
                                        isFirst = false;
