                                if (Model.SizeS > 0) packingSizesObj.Add("S", Model.SizeS.ToString());
                                if (Model.SizeM > 0) packingSizesObj.Add("M", Model.SizeM.ToString());
                                if (Model.SizeL > 0) packingSizesObj.Add("L", Model.SizeL.ToString());
                                if (Model.SizeXL > 0) packingSizesObj.Add("XL", Model.SizeXL.ToString());
                                if (Model.Size2XL > 0) packingSizesObj.Add("2XL", Model.Size2XL.ToString());
                                if (Model.Size3XL > 0) packingSizesObj.Add("3XL", Model.Size3XL.ToString());
