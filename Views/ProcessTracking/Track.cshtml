    .col-md-2 { width: 16.666%; padding: 0 10px; }
    .col-md-4 { width: 33.333%; padding: 0 10px; }
    .mb-3 { margin-bottom: 1rem; }
    
    .form-control, .form-select {
        width: 100%;
        padding: 10px 14px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font-size: 0.95rem;
        transition: all 0.2s ease;
        background-color: #f8fafc;
