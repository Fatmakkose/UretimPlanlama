                <!-- AÇIK ADET BÖLÜMÜ -->
                <h5 style="font-weight: bold; margin-bottom: 5px;">AÇIK ADET</h5>
                <table style="border-collapse: collapse; width: 100%; text-align: center; font-size: 0.9rem; margin-bottom: 50px;">
                    <thead>
                        <tr style="background: #f0f0f0;">
                            <th style="border: 1px solid black; padding: 8px;">SİPARİŞ NUMARASI</th>
                            <th style="border: 1px solid black; padding: 8px;">MERC ALT GURUBU</th>
                            <th style="border: 1px solid black; padding: 8px;">ÖZEL KOD</th>
                            <th style="border: 1px solid black; padding: 8px;">RENK ADI</th>
                            <th style="border: 1px solid black; padding: 8px;">MODEL ADI</th>
                            <th style="border: 1px solid black; padding: 8px;">RENK KODU</th>
                            <th style="border: 1px solid black; padding: 8px;">KOLİ SAYISI</th>
