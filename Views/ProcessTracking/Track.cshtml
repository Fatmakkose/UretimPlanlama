                                if (Model.SizeM > 0) packingSizesObj.Add("M", Model.SizeM.ToString());
                                if (Model.SizeL > 0) packingSizesObj.Add("L", Model.SizeL.ToString());
                                if (Model.SizeXL > 0) packingSizesObj.Add("XL", Model.SizeXL.ToString());
