@model List<UretimPlanlama.Models.Order>
@{
    ViewData["Title"] = "Sipariş Yönetimi";
}

<style>
   
    .premium-table {
        width: 100%;
        border-collapse: collapse;
    }
    .premium-table tr:hover {
        background-color: #f8fafc;
    }
    
    
    .custom-dropdown-menu {
        display: none;
        border: 1px solid var(--border-color);
        box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -2px rgba(0,0,0,0.05);
        background-color: white;
    }
    
    .dropdown-item:hover {
        background-color: #f1f5f9 !important;
        color: var(--text-main) !important;
    }
    
    
    .modal-overlay {
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .modal-overlay.active {
        display: flex !important;
        opacity: 1 !important;
    }
    .modal-overlay.active .modal-content {
        transform: scale(1) !important;
    }
</style>

<div class="dashboard-header" style="margin-bottom: 25px;">
    <div class="header-title">
        <h1 style="font-size: 1.8rem; margin: 0; color: var(--text-main);">Sipariş Yönetimi (LCW Portal)</h1>
        <p style="color: var(--text-muted); margin-top: 5px;">Müşterilerden gelen siparişlerin listelenmesi, durum yönetimi ve kumaş entegrasyonu.</p>
    </div>
    <div class="header-actions" style="display: flex; gap: 12px;">
        <a href="/Order/ExportToExcel" class="btn-secondary" style="background: #10b981; color: white; border-color: #059669; border-radius: 8px; font-size: 0.95rem; padding: 10px 18px; text-decoration: none; display: flex; align-items: center;">
            <i class="fa-solid fa-file-excel" style="margin-right: 6px;"></i> Excel Çıktısı Al
        </a>
        <button class="btn-planner" id="btnOpenNewOrderModal" style="border-radius: 8px; font-size: 0.95rem; padding: 10px 18px;"><i class="fa-solid fa-plus"></i> Yeni Sipariş (LCW)</button>
    </div>
</div>


<div class="stat-cards" style="margin-bottom: 25px;">
    <div class="stat-card">
        <div class="stat-icon icon-teal">
            <i class="fa-solid fa-briefcase"></i>
        </div>
        <div class="stat-title">Toplam Sipariş</div>
        <div class="stat-value">@Model.Count</div>
        <div class="stat-desc">Sistemdeki toplam iş emri</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon icon-light-teal" style="background: #e0f2fe; color: #0284c7;">
            <i class="fa-solid fa-circle-info"></i>
        </div>
        <div class="stat-title">Yeni Kayıt / Bekleyen</div>
        <div class="stat-value">@Model.Count(o => o.Status == "Yeni Kayıt" || string.IsNullOrEmpty(o.Status))</div>
        <div class="stat-desc text-info">Üretime başlamayı bekleyenler</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon icon-light-teal" style="background: #fef3c7; color: #d97706;">
            <i class="fa-solid fa-spinner"></i>
        </div>
        <div class="stat-title">Aktif Üretimde</div>
        <div class="stat-value">@Model.Count(o => o.Status != "Yeni Kayıt" && o.Status != "Tamamlandı" && o.Status != "İptal Edildi" && !string.IsNullOrEmpty(o.Status))</div>
        <div class="stat-desc text-warning">Atölyelerde dikim/kesim aşamasında</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon icon-light-teal" style="background: #ecfdf5; color: #10b981;">
            <i class="fa-solid fa-circle-check"></i>
        </div>
        <div class="stat-title">Tamamlanan</div>
        <div class="stat-value">@Model.Count(o => o.Status == "Tamamlandı")</div>
        <div class="stat-desc text-success">Sevkiyatı yapılmış siparişler</div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div style="background-color: var(--success-bg); color: var(--success-text); padding: 15px; border-radius: 8px; margin-bottom: 20px; border: 1px solid rgba(13, 148, 136, 0.2);">
        <i class="fa-solid fa-circle-check" style="margin-right: 8px;"></i> @TempData["SuccessMessage"]
    </div>
}

<div class="schedule-section">
    <div class="section-header">
        <div>
            <h2>Sipariş Listesi</h2>
            <p>Gelen sipariş bilgileri, üretim yerleri, kumaş bilgileri ve durum takipleri</p>
        </div>
        <div class="search-box" style="width: 320px;">
            <i class="fa-solid fa-search"></i>
            <input type="text" id="orderSearchInput" placeholder="Model, Sipariş Kodu veya Atölye Ara..." />
        </div>
    </div>

    <div class="schedule-list" style="overflow-x: auto; background: transparent; border: none; padding: 0;">
        @if (Model == null || Model.Count == 0)
        {
            <div style="text-align: center; color: var(--text-muted); padding: 60px 10px;">
                <i class="fa-solid fa-clipboard-list" style="font-size: 3.5rem; margin-bottom: 15px; opacity: 0.5; color: var(--primary-color);"></i>
                <p style="font-size: 1.2rem; margin: 0; font-weight: 500;">Henüz aktif bir sipariş kaydı bulunmuyor.</p>
                <p style="font-size: 0.95rem; margin-top: 5px;">Yeni bir sipariş oluşturarak planlamaya başlayabilirsiniz.</p>
            </div>
        }
        else
        {
            <table class="premium-table" style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
                <thead>
                    <tr style="border-bottom: 2px solid var(--border-color); color: var(--text-muted); font-weight: 600; text-transform: uppercase; font-size: 0.8rem; letter-spacing: 0.5px;">
                        <th style="padding: 14px 16px;">Sipariş Kodu</th>
                        <th style="padding: 14px 16px;">Model / Detay</th>
                        <th style="padding: 14px 16px;">Üretim Yeri & Kumaşçı</th>
                        <th style="padding: 14px 16px; text-align: right;">Miktar</th>
                        <th style="padding: 14px 16px;">Kumaş Durumu</th>
                        <th style="padding: 14px 16px; text-align: center; min-width: 160px;">Sipariş Durumu</th>
                    </tr>
                </thead>
                <tbody id="orderTableBody">
                    @foreach (var order in Model)
                    {
                        <tr style="border-bottom: 1px solid var(--border-color); transition: background-color 0.2s;" class="order-row">
                           
                            <td style="padding: 16px;">
                                <strong style="color: var(--text-main); font-size: 0.95rem; display: block;">@order.OrderCode</strong>
                                <span style="font-size: 0.8rem; color: var(--text-muted); display: block; margin-top: 4px;">
                                    <i class="fa-regular fa-calendar" style="margin-right: 4px;"></i>@order.OrderDate.ToString("dd.MM.yyyy")
                                </span>
                            </td>

                         
                            <td style="padding: 16px;">
                                <strong style="color: var(--text-main); font-size: 0.95rem; display: block;">@order.ModelName</strong>
                                <span style="font-size: 0.8rem; color: var(--text-muted); display: block;">@(string.IsNullOrEmpty(order.ModelNo) ? "-" : order.ModelNo)</span>
                                <div style="display: flex; gap: 6px; margin-top: 6px; align-items: center; flex-wrap: wrap;">
                                    <span class="badge" style="background-color: #f1f5f9; color: #475569; font-weight: 500;">@order.Color</span>
                                    <span class="badge" style="background-color: #e0e7ff; color: #4f46e5; font-weight: 500;">@order.Brand</span>
                                </div>
                            </td>

                            
                            <td style="padding: 16px;">
                                <div style="display: flex; flex-direction: column; gap: 4px; font-size: 0.85rem;">
                                    <span><i class="fa-solid fa-industry" style="margin-right: 6px; color: var(--text-muted); width: 14px;"></i>@order.ProductionPlace</span>
                                    <span><i class="fa-solid fa-truck" style="margin-right: 6px; color: var(--text-muted); width: 14px;"></i>@order.FabricSupplier</span>
                                </div>
                            </td>

                           
                            <td style="padding: 16px; text-align: right; font-weight: 600; color: var(--text-main); font-size: 0.95rem;">
                                @order.Quantity.ToString("N0") <span style="font-weight: 400; font-size: 0.8rem; color: var(--text-muted);">Adet</span>
                            </td>

                         
                            <td style="padding: 16px;">
                                @{
                                    var fs = order.FabricStatus ?? "Bekleniyor";
                                    var fsClass = "badge-scheduled";
                                    if (fs == "Tamamlandı" || fs == "Kumaş Tam") fsClass = "badge-progress";
                                    else if (fs == "Kısmi Geldi" || fs == "Gecikti") fsClass = "badge-medium";
                                    else if (fs == "Bekleniyor" || fs == "Eksik") fsClass = "badge-high";
                                }
                                <div class="custom-dropdown-container" style="position: relative; display: inline-block;">
                                    <span class="badge @fsClass fabric-status-badge" data-id="@order.Id" style="cursor: pointer; display: flex; align-items: center; gap: 6px; font-size: 0.8rem; padding: 6px 12px; border-radius: 20px;">
                                        @fs <i class="fa-solid fa-chevron-down" style="font-size: 0.65rem;"></i>
                                    </span>
                                    <div class="custom-dropdown-menu fabric-status-menu" style="display: none; position: absolute; top: 100%; left: 0; background: white; border: 1px solid var(--border-color); border-radius: 8px; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); z-index: 50; width: 150px; margin-top: 6px; padding: 4px 0;">
                                        <a href="#" class="dropdown-item" data-id="@order.Id" data-status="Bekleniyor" style="display: block; padding: 8px 16px; color: var(--text-main); text-decoration: none; font-size: 0.85rem; transition: background 0.2s;"><i class="fa-regular fa-clock" style="margin-right: 8px; color: #dc2626;"></i>Bekleniyor</a>
                                        <a href="#" class="dropdown-item" data-id="@order.Id" data-status="Kısmi Geldi" style="display: block; padding: 8px 16px; color: var(--text-main); text-decoration: none; font-size: 0.85rem; transition: background 0.2s;"><i class="fa-solid fa-circle-exclamation" style="margin-right: 8px; color: #d97706;"></i>Kısmi Geldi</a>
                                        <a href="#" class="dropdown-item" data-id="@order.Id" data-status="Tamamlandı" style="display: block; padding: 8px 16px; color: var(--text-main); text-decoration: none; font-size: 0.85rem; transition: background 0.2s;"><i class="fa-regular fa-circle-check" style="margin-right: 8px; color: #0d9488;"></i>Tamamlandı</a>
                                    </div>
                                </div>

                                @if (order.TargetFabricQty.HasValue && order.ActualFabricQty.HasValue)
                                {
                                    var diff = order.TargetFabricQty.Value - order.ActualFabricQty.Value;
                                    <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 6px; font-weight: 500;">
                                        @if (diff > 0)
                                        {
                                            <span style="color: var(--danger-text);"><i class="fa-solid fa-triangle-exclamation" style="margin-right: 4px;"></i>Eksik: @Math.Round(diff, 1) kg</span>
                                        }
                                        else
                                        {
                                            <span style="color: var(--success-text);"><i class="fa-solid fa-check" style="margin-right: 4px;"></i>Eksiksiz</span>
                                        }
                                        <span style="display: block; opacity: 0.7; font-size: 0.7rem; margin-top: 2px;">Hedef: @order.TargetFabricQty.Value.ToString("N1") kg</span>
                                    </div>
                                }
                            </td>

                           
                            <td style="padding: 16px; text-align: center;">
                                @{
                                    var status = order.Status ?? "Yeni Kayıt";
                                    var statusClass = "badge-high";
                                    if (status == "Tamamlandı") statusClass = "badge-progress";
                                    else if (status == "İptal Edildi") statusClass = "badge-high";
                                    else if (status == "Yeni Kayıt") statusClass = "badge-scheduled";
                                    else statusClass = "badge-medium"; // Kesimde, Dikimde, Ütü Pakette
                                }
                                <div class="custom-dropdown-container" style="position: relative; display: inline-block;">
                                    <span class="badge @statusClass order-status-badge" data-id="@order.Id" style="cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 0.85rem; padding: 8px 14px; border-radius: 20px; font-weight: 600; min-width: 120px;">
                                        @status <i class="fa-solid fa-chevron-down" style="font-size: 0.65rem;"></i>
                                    </span>
                                    <div class="custom-dropdown-menu order-status-menu" style="display: none; position: absolute; top: 100%; left: 50%; transform: translateX(-50%); background: white; border: 1px solid var(--border-color); border-radius: 8px; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); z-index: 50; width: 170px; margin-top: 6px; padding: 4px 0; text-align: left;">
                                        <a href="#" class="dropdown-item" data-id="@order.Id" data-status="Yeni Kayıt" style="display: block; padding: 8px 16px; color: var(--text-main); text-decoration: none; font-size: 0.85rem; transition: background 0.2s;"><i class="fa-regular fa-plus" style="margin-right: 8px; color: #4338ca;"></i>Yeni Kayıt</a>
                                        <a href="#" class="dropdown-item" data-id="@order.Id" data-status="Planlandı" style="display: block; padding: 8px 16px; color: var(--text-main); text-decoration: none; font-size: 0.85rem; transition: background 0.2s;"><i class="fa-regular fa-calendar-check" style="margin-right: 8px; color: #0284c7;"></i>Planlandı</a>
                                        <a href="#" class="dropdown-item" data-id="@order.Id" data-status="Kesimde" style="display: block; padding: 8px 16px; color: var(--text-main); text-decoration: none; font-size: 0.85rem; transition: background 0.2s;"><i class="fa-solid fa-scissors" style="margin-right: 8px; color: #d97706;"></i>Kesimde</a>
                                        <a href="#" class="dropdown-item" data-id="@order.Id" data-status="Dikimde" style="display: block; padding: 8px 16px; color: var(--text-main); text-decoration: none; font-size: 0.85rem; transition: background 0.2s;"><i class="fa-solid fa-shirt" style="margin-right: 8px; color: #d97706;"></i>Dikimde</a>
                                        <a href="#" class="dropdown-item" data-id="@order.Id" data-status="Ütü Pakette" style="display: block; padding: 8px 16px; color: var(--text-main); text-decoration: none; font-size: 0.85rem; transition: background 0.2s;"><i class="fa-solid fa-box-open" style="margin-right: 8px; color: #d97706;"></i>Ütü Pakette</a>
                                        <div style="border-top: 1px solid var(--border-color); margin: 4px 0;"></div>
                                        <a href="#" class="dropdown-item" data-id="@order.Id" data-status="Tamamlandı" style="display: block; padding: 8px 16px; color: var(--text-main); text-decoration: none; font-size: 0.85rem; transition: background 0.2s;"><i class="fa-solid fa-circle-check" style="margin-right: 8px; color: #0d9488;"></i>Tamamlandı</a>
                                        <a href="#" class="dropdown-item" data-id="@order.Id" data-status="İptal Edildi" style="display: block; padding: 8px 16px; color: var(--text-main); text-decoration: none; font-size: 0.85rem; transition: background 0.2s;"><i class="fa-solid fa-ban" style="margin-right: 8px; color: #dc2626;"></i>İptal Edildi</a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>


<div id="newOrderModal" class="modal-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.4); backdrop-filter: blur(8px); z-index: 1000; justify-content: center; align-items: center; transition: all 0.3s ease;">
    <div class="modal-content" style="background: white; width: 85%; max-width: 900px; border-radius: 16px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25); overflow: hidden; transform: scale(0.95); transition: transform 0.3s ease; display: flex; flex-direction: column; max-height: 90%;">
        
        <div style="padding: 20px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; background: #fafafa;">
            <div>
                <h3 style="margin: 0; font-size: 1.3rem; font-weight: 700; color: var(--text-main); display: flex; align-items: center; gap: 8px;">
                    <i class="fa-solid fa-briefcase" style="color: var(--primary-color);"></i> Yeni Sipariş Oluştur (LCW Formu)
                </h3>
                <p style="margin: 4px 0 0 0; font-size: 0.85rem; color: var(--text-muted);">Sisteme yeni bir sipariş ve üretim kaydı ekleyin</p>
            </div>
            <button id="btnCloseModal" style="background: transparent; border: none; font-size: 1.5rem; color: var(--text-muted); cursor: pointer; padding: 4px; display: flex; align-items: center; justify-content: center; transition: color 0.2s;"><i class="fa-solid fa-xmark"></i></button>
        </div>

        
        <div style="overflow-y: auto; padding: 24px; flex-grow: 1;">
            <form id="newOrderForm" action="/Order/Create" method="post">
                @Html.AntiForgeryToken()
                
               
                <div style="margin-bottom: 24px;">
                    <h4 style="margin: 0 0 16px 0; padding-bottom: 8px; border-bottom: 1px solid var(--border-color); font-size: 1rem; color: var(--primary-color); font-weight: 600;"><i class="fa-solid fa-circle-info" style="margin-right: 6px;"></i> Genel Bilgiler</h4>
                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px;">
                        <div class="form-group">
                            <label>Sipariş Tarihi</label>
                            <input name="OrderDate" class="form-control" type="date" required value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="form-group">
                            <label>Sipariş Kodu</label>
                            <input name="OrderCode" class="form-control" placeholder="Örn: LCW-99238" required />
                        </div>
                        <div class="form-group">
                            <label>Ödeme Şekli</label>
                            <select name="PaymentMethod" class="form-control">
                                <option value="">- Seçiniz -</option>
                                <option value="Peşin">Peşin</option>
                                <option value="Nakit">Nakit</option>
                                <option value="Vadeli">Vadeli</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Üretici Cari Kod</label>
                            <input name="ManufacturerCode" class="form-control" placeholder="Örn: CARI-01" />
                        </div>
                        <div class="form-group">
                            <label>Üretici Firma</label>
                            <input name="ManufacturerCompany" class="form-control" placeholder="Örn: CPS Tekstil" />
                        </div>
                        <div class="form-group">
                            <label>Alıcı</label>
                            <input name="Customer" class="form-control" value="LC Waikiki" readonly />
                        </div>
                    </div>
                </div>

                
                <div style="margin-bottom: 24px;">
                    <h4 style="margin: 0 0 16px 0; padding-bottom: 8px; border-bottom: 1px solid var(--border-color); font-size: 1rem; color: var(--primary-color); font-weight: 600;"><i class="fa-solid fa-shirt" style="margin-right: 6px;"></i> Ürün & Operasyon Bilgileri</h4>
                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px;">
                        <div class="form-group">
                            <label>Model Adı</label>
                            <input name="ModelName" class="form-control" placeholder="Örn: Basic Sweatshirt" required />
                        </div>
                        <div class="form-group">
                            <label>Model Numarası</label>
                            <input name="ModelNo" class="form-control" placeholder="Örn: S6T477Z8" />
                        </div>
                        <div class="form-group" style="display: none;">
                            <label>Renk / Option</label>
                            <input name="Color" class="form-control" id="commonColor" />
                        </div>
                        <div class="form-group">
                            <label>Mal Tanımı</label>
                            <input name="GoodsDescription" class="form-control" placeholder="Örn: Örme Erkek Sweatshirt" />
                        </div>
                        <div class="form-group">
                            <label>Marka</label>
                            <input name="Brand" class="form-control" value="LC WAIKIKI" readonly />
                        </div>
                        <div class="form-group">
                            <label>Inspection Tipi</label>
                            <select name="InspectionType" class="form-control" id="modalInspectionType">
                                <option value="">-- Seçiniz --</option>
                                <option value="Yurt İçi">Yurt İçi (Yİ)</option>
                                <option value="Yurt Dışı">Yurt Dışı (YD)</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Inspection Tarihi</label>
                            <input name="InspectionDate" class="form-control" type="date" id="modalInspectionDate" disabled />
                        </div>
                        <div class="form-group">
                            <label>Kumaşçı</label>
                            <select name="FabricSupplier" class="form-control" required>
                                <option value="">-- Kumaşçı Seçiniz --</option>
                                @if (ViewBag.Fabricators != null)
                                {
                                    foreach (var f in (List<UretimPlanlama.Models.Fabricator>)ViewBag.Fabricators)
                                    {
                                        <option value="@f.Name">@f.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Teslim Yeri</label>
                            <input name="DeliveryPlace" class="form-control" value="LCWaikiki Depoları" />
                        </div>
                    </div>
                </div>

        
                <div style="margin-bottom: 24px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); margin-bottom: 16px; padding-bottom: 8px;">
                        <h4 style="margin: 0; font-size: 1rem; color: var(--primary-color); font-weight: 600;"><i class="fa-solid fa-layer-group" style="margin-right: 6px;"></i> Renk ve Beden Dağılımları</h4>
                        <button type="button" id="btnAddColorRow" class="btn-secondary" style="padding: 6px 14px; font-size: 0.85rem;"><i class="fa-solid fa-plus"></i> Yeni Renk Ekle</button>
                    </div>
                    
                    <div id="colorRowsContainer" style="display: flex; flex-direction: column; gap: 16px;">
                        <!-- Dinamik satırlar buraya gelecek -->
                    </div>
                </div>

                <div style="margin-bottom: 12px;">
                    <h4 style="margin: 0 0 16px 0; padding-bottom: 8px; border-bottom: 1px solid var(--border-color); font-size: 1rem; color: var(--primary-color); font-weight: 600;"><i class="fa-solid fa-coins" style="margin-right: 6px;"></i> Finansal Bilgiler</h4>
                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px;">
                        <div class="form-group">
                            <label>Toplam Sipariş Miktarı (Adet)</label>
                            <input name="Quantity" class="form-control calc-trigger-modal" type="number" id="modalQty" readonly style="background:#eef2ff; font-weight:bold;" value="0" />
                        </div>
                        <div class="form-group">
                            <label>Komponent Birim Fiyatı (₺)</label>
                            <input name="ComponentUnitPrice" class="form-control calc-trigger-modal" type="number" step="0.01" id="modalUnitPrice" placeholder="Örn: 45.50" />
                        </div>
                        <div class="form-group">
                            <label>Toplam Tutar (₺)</label>
                            <input name="TotalAmount" class="form-control" type="number" step="0.01" id="modalTotalAmt" readonly />
                        </div>
                        <div class="form-group">
                            <label>%10 KDV (₺)</label>
                            <input name="VatAmount" class="form-control" type="number" step="0.01" id="modalVatAmt" readonly />
                        </div>
                        <div class="form-group">
                            <label style="color:var(--primary-color);">KDV'li Toplam Tutar (₺)</label>
                            <input name="TotalAmountWithVat" class="form-control" type="number" step="0.01" id="modalGrandTotal" readonly style="border-color:var(--primary-color); font-weight:bold; color:var(--primary-color); background:#ccfbf1;" />
                        </div>
                    </div>
                </div>

                
                <div style="margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border-color); display: flex; justify-content: flex-end; gap: 12px;">
                    <button type="button" id="btnCancelModal" class="btn-secondary" style="padding: 10px 20px;">İptal</button>
                    <button type="submit" class="btn-planner" style="padding: 10px 24px;"><i class="fa-solid fa-save"></i> Siparişi Kaydet ve Plana Al</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            var colorOptionsHtml = '<option value="">-- Renk Seçin --</option>';
            @if(ViewBag.Colors != null) {
                foreach(var c in (List<UretimPlanlama.Models.ColorDef>)ViewBag.Colors) {
                    <text>colorOptionsHtml += '<option value="@c.Name">@c.Name</option>';</text>
                }
            }
            
            $("#orderSearchInput").on("keyup", function() {
                var value = $(this).val().toLowerCase();
                $("#orderTableBody tr").filter(function() {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });

            
            $("#btnOpenNewOrderModal").click(function() {
                $("#newOrderModal").css("display", "flex").hide().fadeIn(200, function() {
                    $(this).addClass("active");
                });
            });

            function closeModal() {
                $("#newOrderModal").removeClass("active").fadeOut(200);
                $("#newOrderForm")[0].reset();
                $("#colorRowsContainer").empty();
                $("#modalInspectionDate").prop('disabled', true);
            }

            $("#btnCloseModal, #btnCancelModal, #newOrderModal").click(function(e) {
                if(e.target === this || $(e.target).closest('#btnCloseModal, #btnCancelModal').length > 0) {
                    closeModal();
                }
            });

            
            $('#modalInspectionType').change(function() {
                if($(this).val()) {
                    $('#modalInspectionDate').prop('disabled', false);
                } else {
                    $('#modalInspectionDate').prop('disabled', true);
                    $('#modalInspectionDate').val('');
                }
            });

            // --- YENİ DİNAMİK RENK/BEDEN SİSTEMİ ---
            
            function calculateRowTotals(row) {
                // Açık Adetlerin Toplamı
                var openQty = 0;
                row.find('.open-size').each(function() { openQty += (parseInt($(this).val()) || 0); });
                row.find('.row-open-total').val(openQty);
                
                // Asorti Oranlarının Toplamı (Toplam Asorti Sayısı)
                var asortiRatioSum = 0;
                row.find('.asorti-size').each(function() { asortiRatioSum += (parseInt($(this).val()) || 0); });
                row.find('.row-asorti-total').val(asortiRatioSum);
                
                // Toplam Asorti Sipariş (Çarpan)
                var asortiMultiplier = parseInt(row.find('.row-asorti-count').val()) || 0;
                
                // Toplam Asorti Adet
                var totalAsortiQty = asortiRatioSum * asortiMultiplier;
                row.find('.row-asorti-final').val(totalAsortiQty);
                
                // Nihai Toplam
                var rowTotal = openQty + totalAsortiQty;
                row.find('.row-total-qty').val(rowTotal);
                
                // Toplam Sipariş Miktarını (Tüm Satırlar) Hesapla
                calculateGrandTotalQuantity();
            }

            function calculateGrandTotalQuantity() {
                var grandTotalQty = 0;
                $('.row-total-qty').each(function() {
                    grandTotalQty += (parseInt($(this).val()) || 0);
                });
                $('#modalQty').val(grandTotalQty).trigger('input');
            }

            $(document).on('input', '.open-size, .asorti-size, .asorti-count', function() {
                var row = $(this).closest('.color-row');
                calculateRowTotals(row);
            });
            
            $(document).on('click', '.btnRemoveRow', function() {
                $(this).closest('.color-row').fadeOut(200, function() {
                    $(this).remove();
                    calculateGrandTotalQuantity();
                });
            });

            $("#btnAddColorRow").click(function() {
                var rowHtml = `
                <div class="color-row" style="background: #f8f9fa; border: 1px solid var(--border-color); border-radius: 8px; padding: 16px; position: relative;">
                    <button type="button" class="btnRemoveRow" style="position: absolute; top: 10px; right: 10px; background: transparent; border: none; color: #dc2626; cursor: pointer;"><i class="fa-solid fa-trash"></i></button>
                    
                    <div style="display: grid; grid-template-columns: 1.5fr 1fr 1.5fr; gap: 16px; margin-bottom: 12px;">
                        <div>
                            <label style="font-size: 0.85rem; font-weight: 600;">Renk / Option</label>
                            <select class="form-control row-color" required>
                                ${colorOptionsHtml}
                            </select>
                        </div>
                        <div>
                            <label style="font-size: 0.85rem; font-weight: 600;">Option Kodu</label>
                            <input type="text" class="form-control row-option-code" placeholder="Örn: HDB" />
                        </div>
                        <div style="display: flex; gap: 10px;">
                            <div style="flex: 1;">
                                <label style="font-size: 0.85rem; font-weight: 600;">JIT</label>
                                <select class="form-control row-jit"><option value="false">Hayır</option><option value="true">Evet</option></select>
                            </div>
                            <div style="flex: 1;">
                                <label style="font-size: 0.85rem; font-weight: 600;">Bölge</label>
                                <select class="form-control row-region"><option value="Yurt İçi">Yurt İçi</option><option value="İhracat">İhracat</option></select>
                            </div>
                        </div>
                    </div>

                    <div style="margin-bottom: 8px; font-size: 0.85rem; font-weight: 600; color: #0284c7;">Açık Adetler</div>
                    <div style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; margin-bottom: 12px;">
                        <div><small style="display:block; text-align:center;">S</small><input type="number" min="0" class="form-control open-size row-size-s" value="0" /></div>
                        <div><small style="display:block; text-align:center;">M</small><input type="number" min="0" class="form-control open-size row-size-m" value="0" /></div>
                        <div><small style="display:block; text-align:center;">L</small><input type="number" min="0" class="form-control open-size row-size-l" value="0" /></div>
                        <div><small style="display:block; text-align:center;">XL</small><input type="number" min="0" class="form-control open-size row-size-xl" value="0" /></div>
                        <div><small style="display:block; text-align:center;">2XL</small><input type="number" min="0" class="form-control open-size row-size-2xl" value="0" /></div>
                        <div><small style="display:block; text-align:center;">3XL</small><input type="number" min="0" class="form-control open-size row-size-3xl" value="0" /></div>
                        <div><small style="display:block; text-align:center; color:#0284c7;">Açık Toplam</small><input type="number" class="form-control row-open-total" readonly style="background:#e0f2fe; font-weight:bold; color:#0284c7;" value="0" /></div>
                    </div>

                    <div style="margin-bottom: 8px; font-size: 0.85rem; font-weight: 600; color: #16a34a;">Asorti Adetleri (Oran)</div>
                    <div style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; margin-bottom: 12px;">
                        <div><small style="display:block; text-align:center;">S</small><input type="number" min="0" class="form-control asorti-size row-asorti-s" value="0" /></div>
                        <div><small style="display:block; text-align:center;">M</small><input type="number" min="0" class="form-control asorti-size row-asorti-m" value="0" /></div>
                        <div><small style="display:block; text-align:center;">L</small><input type="number" min="0" class="form-control asorti-size row-asorti-l" value="0" /></div>
                        <div><small style="display:block; text-align:center;">XL</small><input type="number" min="0" class="form-control asorti-size row-asorti-xl" value="0" /></div>
                        <div><small style="display:block; text-align:center;">2XL</small><input type="number" min="0" class="form-control asorti-size row-asorti-2xl" value="0" /></div>
                        <div><small style="display:block; text-align:center;">3XL</small><input type="number" min="0" class="form-control asorti-size row-asorti-3xl" value="0" /></div>
                        <div><small style="display:block; text-align:center; color:#16a34a;">T.Asorti Sayısı</small><input type="number" class="form-control row-asorti-total" readonly style="background:#dcfce7; font-weight:bold; color:#16a34a;" value="0" /></div>
                    </div>

                    <div style="display: flex; gap: 16px; align-items: flex-end; background: #f1f5f9; padding: 12px; border-radius: 6px; border: 1px solid #cbd5e1;">
                        <div style="flex: 1;">
                            <label style="font-size: 0.85rem; font-weight: 600;">Toplam Asorti Sipariş (Çarpan)</label>
                            <input type="number" min="0" class="form-control asorti-count row-asorti-count" value="0" placeholder="Örn: 595" />
                        </div>
                        <div style="flex: 1;">
                            <label style="font-size: 0.85rem; font-weight: 600;">Toplam Asorti Adet</label>
                            <input type="number" class="form-control row-asorti-final" readonly style="background: transparent; font-weight: bold; border: none; padding-left: 0;" value="0" />
                        </div>
                        <div style="flex: 1; border-left: 2px solid #cbd5e1; padding-left: 16px;">
                            <label style="font-size: 0.85rem; font-weight: 700; color:var(--primary-color);">Nihai Toplam</label>
                            <input type="number" class="form-control row-total-qty" readonly style="background: transparent; font-weight: bold; font-size: 1.1rem; color:var(--primary-color); border: none; padding-left: 0;" value="0" />
                        </div>
                    </div>
                </div>
                `;
                $("#colorRowsContainer").append(rowHtml);
            });

            // İlk satırı otomatik ekle
            $("#btnAddColorRow").click();

            // Form Gönderimini AJAX ile Toplu Gönderme
            $("#newOrderForm").on("submit", function(e) {
                e.preventDefault();
                
                var rows = $(".color-row");
                if (rows.length === 0) {
                    showToast("Lütfen en az bir renk/satır ekleyin.", "danger");
                    return;
                }

                var formData = new FormData(this);
                var commonData = Object.fromEntries(formData.entries());
                
                var orders = [];
                rows.each(function() {
                    var row = $(this);
                    // Base order object
                    var orderObj = Object.assign({}, commonData);
                    
                    // Row specific mappings
                    orderObj.Color = row.find('.row-color').val();
                    orderObj.OptionCode = row.find('.row-option-code').val();
                    orderObj.IsJIT = row.find('.row-jit').val() === "true";
                    orderObj.SalesRegion = row.find('.row-region').val();
                    
                    orderObj.SizeS = parseInt(row.find('.row-size-s').val()) || 0;
                    orderObj.SizeM = parseInt(row.find('.row-size-m').val()) || 0;
                    orderObj.SizeL = parseInt(row.find('.row-size-l').val()) || 0;
                    orderObj.SizeXL = parseInt(row.find('.row-size-xl').val()) || 0;
                    orderObj.Size2XL = parseInt(row.find('.row-size-2xl').val()) || 0;
                    orderObj.Size3XL = parseInt(row.find('.row-size-3xl').val()) || 0;
                    
                    orderObj.AsortiSizeS = parseInt(row.find('.row-asorti-s').val()) || 0;
                    orderObj.AsortiSizeM = parseInt(row.find('.row-asorti-m').val()) || 0;
                    orderObj.AsortiSizeL = parseInt(row.find('.row-asorti-l').val()) || 0;
                    orderObj.AsortiSizeXL = parseInt(row.find('.row-asorti-xl').val()) || 0;
                    orderObj.AsortiSize2XL = parseInt(row.find('.row-asorti-2xl').val()) || 0;
                    orderObj.AsortiSize3XL = parseInt(row.find('.row-asorti-3xl').val()) || 0;
                    
                    orderObj.AsortiCount = parseInt(row.find('.row-asorti-count').val()) || 0;
                    orderObj.Quantity = parseInt(row.find('.row-total-qty').val()) || 0;
                    
                    orders.push(orderObj);
                });

                $.ajax({
                    url: '/Order/CreateMultiple',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(orders),
                    success: function(res) {
                        if (res.success) {
                            window.location.reload();
                        } else {
                            showToast("Hata: " + res.message, "danger");
                        }
                    },
                    error: function() {
                        showToast("Kayıt sırasında sunucu hatası oluştu.", "danger");
                    }
                });
            });

            // Finansal Tetikleyiciler
            $('.calc-trigger-modal').on('input', function() {
                var qty = parseFloat($('#modalQty').val()) || 0;
                var price = parseFloat($('#modalUnitPrice').val()) || 0;
                
                var total = qty * price;
                var vat = total * 0.10; 
                var grand = total + vat;

                $('#modalTotalAmt').val(total.toFixed(2));
                $('#modalVatAmt').val(vat.toFixed(2));
                $('#modalGrandTotal').val(grand.toFixed(2));
            });

            
            $(document).on("click", ".fabric-status-badge, .order-status-badge", function(e) {
                e.stopPropagation();
                var menu = $(this).siblings(".custom-dropdown-menu");
                $(".custom-dropdown-menu").not(menu).fadeOut(100); 
                menu.fadeToggle(150);
            });

            $(document).click(function() {
                $(".custom-dropdown-menu").fadeOut(150);
            });

           
            $(document).on("click", ".order-status-menu .dropdown-item", function(e) {
                e.preventDefault();
                var orderId = $(this).data("id");
                var newStatus = $(this).data("status");
                var badge = $(this).closest(".custom-dropdown-container").find(".order-status-badge");
                
                $.ajax({
                    url: "/Order/UpdateStatus",
                    type: "POST",
                    data: { id: orderId, status: newStatus },
                    success: function(response) {
                        if (response.success) {
                            
                            badge.html(newStatus + ' <i class="fa-solid fa-chevron-down" style="font-size: 0.65rem;"></i>');
                            
                          
                            badge.removeClass("badge-progress badge-medium badge-high badge-scheduled");
                            if (newStatus === "Tamamlandı") {
                                badge.addClass("badge-progress");
                            } else if (newStatus === "İptal Edildi") {
                                badge.addClass("badge-high");
                            } else if (newStatus === "Yeni Kayıt") {
                                badge.addClass("badge-scheduled");
                            } else {
                                badge.addClass("badge-medium");
                            }
                            
                            showToast("Sipariş durumu başarıyla güncellendi: " + newStatus, "success");
                        } else {
                            showToast("Güncelleme başarısız: " + response.message, "danger");
                        }
                    },
                    error: function() {
                        showToast("Sunucuyla bağlantı kurulurken hata oluştu.", "danger");
                    }
                });
            });

            $(document).on("click", ".fabric-status-menu .dropdown-item", function(e) {
                e.preventDefault();
                var orderId = $(this).data("id");
                var newStatus = $(this).data("status");
                var badge = $(this).closest(".custom-dropdown-container").find(".fabric-status-badge");
                
                $.ajax({
                    url: "/Order/UpdateFabricStatus",
                    type: "POST",
                    data: { id: orderId, status: newStatus },
                    success: function(response) {
                        if (response.success) {
                            badge.html(newStatus + ' <i class="fa-solid fa-chevron-down" style="font-size: 0.65rem;"></i>');
                            
                            badge.removeClass("badge-progress badge-medium badge-high badge-scheduled");
                            if (newStatus === "Tamamlandı") {
                                badge.addClass("badge-progress");
                            } else if (newStatus === "Kısmi Geldi") {
                                badge.addClass("badge-medium");
                            } else {
                                badge.addClass("badge-high");
                            }
                            
                            showToast("Kumaş durumu başarıyla güncellendi: " + newStatus, "success");
                        } else {
                            showToast("Güncelleme başarısız: " + response.message, "danger");
                        }
                    },
                    error: function() {
                        showToast("Sunucuyla bağlantı kurulurken hata oluştu.", "danger");
                    }
                });
            });

            
            function showToast(message, type) {
              
                $("#floatingToast").remove();
                
                var bgColor = type === "success" ? "var(--success-bg)" : "var(--danger-bg)";
                var textColor = type === "success" ? "var(--success-text)" : "var(--danger-text)";
                var borderClr = type === "success" ? "rgba(13, 148, 136, 0.2)" : "rgba(220, 38, 38, 0.2)";
                var icon = type === "success" ? "fa-solid fa-circle-check" : "fa-solid fa-circle-exclamation";
                
                var toast = $('<div id="floatingToast" style="position: fixed; top: 20px; right: 20px; background-color: ' + bgColor + '; color: ' + textColor + '; border: 1px solid ' + borderClr + '; padding: 16px 24px; border-radius: 12px; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); z-index: 9999; display: flex; align-items: center; gap: 10px; font-weight: 500; font-size: 0.95rem; min-width: 300px; animation: slideInRight 0.3s cubic-bezier(0.16, 1, 0.3, 1);">' +
                    '<i class="' + icon + '" style="font-size: 1.2rem;"></i>' +
                    '<span>' + message + '</span>' +
                    '</div>');
                    
                $("body").append(toast);
                
               
                if ($("#toastStyles").length === 0) {
                    $("head").append('<style id="toastStyles">' +
                        '@@keyframes slideInRight {' +
                        'from { transform: translateX(100%); opacity: 0; }' +
                        'to { transform: translateX(0); opacity: 1; }' +
                        '}' +
                        '</style>');
                }
                
        
                setTimeout(function() {
                    $("#floatingToast").fadeOut(400, function() {
                        $(this).remove();
                    });
                }, 3000);
            }
        });
    </script>
}
