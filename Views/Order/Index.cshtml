                        var siparisKodu = $(this).find("td:eq(0)").text().toLowerCase();
                        var modelDetay = $(this).find("td:eq(2)").text().toLowerCase();
                        $(this).toggle(siparisKodu.indexOf(value) > -1 || modelDetay.indexOf(value) > -1);
                    });
                });

            });
