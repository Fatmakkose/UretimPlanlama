                                <td id="detSizeM" style="padding: 12px 8px;">0</td>
                                <td id="detSizeL" style="padding: 12px 8px;">0</td>
                                <td id="detSizeXL" style="padding: 12px 8px;">0</td>
                                <td id="detSize2XL" style="padding: 12px 8px;">0</td>
                                <td id="detSize3XL" style="padding: 12px 8px;">0</td>
                                <td id="detOpenTotal" style="padding: 12px 8px; border-left: 1px solid var(--border-color); font-weight: 700; color: #0284c7; background: #e0f2fe;">0</td>
