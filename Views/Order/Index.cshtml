                            <strong id="detPaymentMethod" style="color: var(--text-main);">...</strong>
                        </div>
                        <div style="display: flex; justify-content: space-between; border-bottom: 1px dashed #e2e8f0; padding-bottom: 8px;">
                            <span style="color: var(--text-muted);"><i class="fa-solid fa-id-card" style="margin-right: 8px; width: 14px;"></i>Üretici Cari Kodu</span>
