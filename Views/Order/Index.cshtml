                                <td id="detAsSizeM" style="padding: 12px 8px;">0</td>
                                <td id="detAsSizeL" style="padding: 12px 8px;">0</td>
                                <td id="detAsSizeXL" style="padding: 12px 8px;">0</td>
                                <td id="detAsSize2XL" style="padding: 12px 8px;">0</td>
                                <td id="detAsSize3XL" style="padding: 12px 8px;">0</td>
                                <td id="detAsRatioTotal" style="padding: 12px 8px; border-left: 1px solid var(--border-color); font-weight: 700; color: #16a34a; background: #dcfce7;">0</td>
                            </tr>
