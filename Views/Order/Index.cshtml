                                        <option value="@c.Name">@c.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Model Detay</label>
                            <input name="GoodsDescription" id="editGoodsDescription" class="form-control" placeholder="Örn: Örme Erkek Sweatshirt" />
                        </div>
