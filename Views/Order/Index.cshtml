                                    <option value="genis_standart">Geniş Standart (XS - 3XL)</option>
                                    <option value="buyuk_beden">Büyük Beden (3XL - 6XL)</option>
                                    <option value="cocuk">Çocuk Beden (2-12 Yaş)</option>
                                    <option value="numerik">Nümerik Beden (36 - 46)</option>
                                    <option value="ozel">Özel Beden Tanımla...</option>
                                </select>
                            </div>
                            <button type="button" id="btnAddColorRow" class="btn-secondary" style="padding: 6px 14px; font-size: 0.85rem;"><i class="fa-solid fa-plus"></i> Yeni Renk Ekle</button>
