                                {
                                    foreach (var c in (List<UretimPlanlama.Models.Customer>)ViewBag.Customers)
                                    {
                                        <option value="@c.Name">@c.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>

                
                <div style="margin-bottom: 24px;">
                    <h4 style="margin: 0 0 16px 0; padding-bottom: 8px; border-bottom: 1px solid var(--border-color); font-size: 1rem; color: var(--primary-color); font-weight: 600;"><i class="fa-solid fa-shirt" style="margin-right: 6px;"></i> Ürün & Operasyon Bilgileri</h4>
                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px;">
                        <div class="form-group">
                            <label>Model Adı</label>
                            <input name="ModelName" class="form-control" placeholder="Örn: Basic Sweatshirt" required />
                        </div>
                        <div class="form-group" style="display: none;">
                            <label>Renk / Option</label>
                            <input name="Color" class="form-control" id="commonColor" />
                        </div>
                        <div class="form-group">
                            <label>Model Detay</label>
                            <input name="GoodsDescription" class="form-control" placeholder="Örn: Örme Erkek Sweatshirt" />
                        </div>
                        <div class="form-group">
                            <label>Marka</label>
                            <input name="Brand" class="form-control" value="LC WAIKIKI" readonly />
                        </div>
                        <div class="form-group">
                            <label>Inspection Tipi</label>
                            <select name="InspectionType" class="form-control" id="modalInspectionType">
