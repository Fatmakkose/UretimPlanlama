            function getSavedRowsData() {
                var data = [];
                $(".color-row").each(function() {
                    var row = $(this);
                    var rowData = {
                        color: row.find('.row-color').val() || "",
                        jit: row.find('.row-jit').val() || "false",
                        region: row.find('.row-region').val() || "Yurt İçi",
                        openSizes: row.data('openSizes') || {},
                        asortiSizes: row.data('asortiSizes') || {},
                        asortiCount: row.find('.row-asorti-count').val() || "0"
                    };
                    data.push(rowData);
                });
                return data;
            }

            
            function createRowHtml(savedData) {
                var color = savedData ? savedData.color : "";
                var jit = savedData ? savedData.jit : "false";
                var region = savedData ? savedData.region : "Yurt İçi";
                var asortiCount = savedData ? savedData.asortiCount : "0";
                
                var openSizes = (savedData && savedData.openSizes) ? savedData.openSizes : {};
                var asortiSizes = (savedData && savedData.asortiSizes) ? savedData.asortiSizes : {};
                
                var openSizesHtml = "";
                activeSizes.forEach(function(size) {
                    var val = openSizes[size] || 0;
                    openSizesHtml += `<div><small style="display:block; text-align:center; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${size}</small><input type="number" min="0" data-size="${size}" class="form-control open-size" value="${val}" /></div>`;
                });
                openSizesHtml += `<div><small style="display:block; text-align:center; color:#0284c7; font-weight:600;">Açık Toplam</small><input type="number" class="form-control row-open-total" readonly style="background:#e0f2fe; font-weight:bold; color:#0284c7;" value="0" /></div>`;

                var asortiSizesHtml = "";
                activeSizes.forEach(function(size) {
                    var val = asortiSizes[size] || 0;
                    asortiSizesHtml += `<div><small style="display:block; text-align:center; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${size}</small><input type="number" min="0" data-size="${size}" class="form-control asorti-size" value="${val}" /></div>`;
                });
                asortiSizesHtml += `<div><small style="display:block; text-align:center; color:#16a34a; font-weight:600;">T.Asorti Sayısı</small><input type="number" class="form-control row-asorti-total" readonly style="background:#dcfce7; font-weight:bold; color:#16a34a;" value="0" /></div>`;

                var gridCols = activeSizes.length + 1;

                var rowHtml = `
                <div class="color-row" style="background: #f8f9fa; border: 1px solid var(--border-color); border-radius: 8px; padding: 16px; position: relative; margin-bottom: 16px;">
                    <button type="button" class="btnRemoveRow" style="position: absolute; top: 10px; right: 10px; background: transparent; border: none; color: #dc2626; cursor: pointer;"><i class="fa-solid fa-trash"></i></button>
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 12px;">
                        <div>
                            <label style="font-size: 0.85rem; font-weight: 600;">Renk / Option</label>
                            <select class="form-control row-color" required>
                                ${colorOptionsHtml}
                            </select>
                        </div>
                        <div style="display: flex; gap: 10px;">
                            <div style="flex: 1;">
                                <label style="font-size: 0.85rem; font-weight: 600;">JIT</label>
                                <select class="form-control row-jit">
                                    <option value="false" ${jit === "false" ? "selected" : ""}>Hayır</option>
                                    <option value="true" ${jit === "true" ? "selected" : ""}>Evet</option>
                                </select>
                            </div>
                            <div style="flex: 1;">
                                <label style="font-size: 0.85rem; font-weight: 600;">Bölge</label>
                                <select class="form-control row-region">
                                    <option value="Yurt İçi" ${region === "Yurt İçi" ? "selected" : ""}>Yurt İçi</option>
                                    <option value="İhracat" ${region === "İhracat" ? "selected" : ""}>İhracat</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div style="margin-bottom: 8px; font-size: 0.85rem; font-weight: 600; color: #0284c7;">Açık Adetler</div>
                    <div class="open-sizes-grid" style="display: grid; grid-template-columns: repeat(${gridCols}, 1fr); gap: 8px; margin-bottom: 12px;">
                        ${openSizesHtml}
                    </div>

                    <div style="margin-bottom: 8px; font-size: 0.85rem; font-weight: 600; color: #16a34a;">Asorti Adetleri (Oran)</div>
                    <div class="asorti-sizes-grid" style="display: grid; grid-template-columns: repeat(${gridCols}, 1fr); gap: 8px; margin-bottom: 12px;">
                        ${asortiSizesHtml}
                    </div>

                    <div style="display: flex; gap: 16px; align-items: flex-end; background: #f1f5f9; padding: 12px; border-radius: 6px; border: 1px solid #cbd5e1;">
                        <div style="flex: 1;">
                            <label style="font-size: 0.85rem; font-weight: 600;">Toplam Asorti Adet</label>
                            <input type="number" min="0" class="form-control asorti-count row-asorti-count" value="${asortiCount}" placeholder="Örn: 595" />
                        </div>
                        <div style="flex: 1;">
                            <label style="font-size: 0.85rem; font-weight: 600;">Toplam Asorti Sipariş</label>
                            <input type="number" class="form-control row-asorti-final" readonly style="background: transparent; font-weight: bold; border: none; padding-left: 0;" value="0" />
                        </div>
                        <div style="flex: 1; border-left: 2px solid #cbd5e1; padding-left: 16px;">
                            <label style="font-size: 0.85rem; font-weight: 700; color:var(--primary-color);">Toplam Adet</label>
                            <input type="number" class="form-control row-total-qty" readonly style="background: transparent; font-weight: bold; font-size: 1.1rem; color:var(--primary-color); border: none; padding-left: 0;" value="0" />
                        </div>
                    </div>
                </div>
                `;
                
                var rowElement = $(rowHtml);
                rowElement.data('openSizes', openSizes);
                rowElement.data('asortiSizes', asortiSizes);
                if (color) {
                    rowElement.find('.row-color').val(color);
                }
                return rowElement;
            }

            
            function reRenderAllRows() {
                var savedData = getSavedRowsData();
                $("#colorRowsContainer").empty();
                if (savedData.length === 0) {
                    var rowElement = createRowHtml(null);
                    $("#colorRowsContainer").append(rowElement);
                    calculateRowTotals(rowElement);
                } else {
                    savedData.forEach(function(data) {
                        var rowElement = createRowHtml(data);
                        $("#colorRowsContainer").append(rowElement);
                        calculateRowTotals(rowElement);
                    });
                }
            }

           
            $("#globalSizeTemplate").change(function() {
                var template = $(this).val();
                if (template === "ozel") {
                    $("#customSizeContainer").css("display", "flex");
                    activeSizes = [...sizeTemplates.ozel];
                } else {
                    $("#customSizeContainer").hide();
                    activeSizes = [...sizeTemplates[template]];
                }
                reRenderAllRows();
            });

           
            $("#btnApplyCustomSize").click(function() {
                var newSize = $("#txtCustomSize").val().trim().toUpperCase();
                if (!newSize) return;
                
                if (sizeTemplates.ozel.indexOf(newSize) === -1) {
                    sizeTemplates.ozel.push(newSize);
                    activeSizes = [...sizeTemplates.ozel];
                    
                    
                    var badgesHtml = "";
                    sizeTemplates.ozel.forEach(function(size, idx) {
                        badgesHtml += `<span class="badge" style="background:#bbf7d0; color:#16a34a; font-weight:600; padding: 6px 12px; border-radius: 12px; display:flex; align-items:center; gap:6px;">
                            ${size}
                            <i class="fa-solid fa-xmark btnRemoveCustomSize" data-index="${idx}" style="cursor:pointer; color:#dc2626;"></i>
                        </span>`;
                    });
                    $("#customSizeBadges").html(badgesHtml);
                    $("#txtCustomSize").val("");
                    
                    reRenderAllRows();
                } else {
                    showToast("Bu beden zaten eklenmiş.", "danger");
                }
            });

            
            $(document).on("click", ".btnRemoveCustomSize", function() {
                var idx = $(this).data("index");
                sizeTemplates.ozel.splice(idx, 1);
                activeSizes = [...sizeTemplates.ozel];
                
                
                var badgesHtml = "";
                sizeTemplates.ozel.forEach(function(size, i) {
                    badgesHtml += `<span class="badge" style="background:#bbf7d0; color:#16a34a; font-weight:600; padding: 6px 12px; border-radius: 12px; display:flex; align-items:center; gap:6px;">
                        ${size}
                        <i class="fa-solid fa-xmark btnRemoveCustomSize" data-index="${i}" style="cursor:pointer; color:#dc2626;"></i>
                    </span>`;
                });
                $("#customSizeBadges").html(badgesHtml);
                reRenderAllRows();
            });

            function calculateRowTotals(row) {
                var openSizes = row.data('openSizes') || {};
                var asortiSizes = row.data('asortiSizes') || {};

               
                var openQty = 0;
                Object.keys(openSizes).forEach(function(key) {
                    openQty += (parseInt(openSizes[key]) || 0);
                });
                row.find('.row-open-total').val(openQty);
                
              
                var asortiRatioSum = 0;
                Object.keys(asortiSizes).forEach(function(key) {
                    asortiRatioSum += (parseInt(asortiSizes[key]) || 0);
                });
                row.find('.row-asorti-total').val(asortiRatioSum);
                
                
                var asortiMultiplier = parseInt(row.find('.row-asorti-count').val()) || 0;
                
               
                var totalAsortiQty = asortiRatioSum * asortiMultiplier;
                row.find('.row-asorti-final').val(totalAsortiQty);
                
             
                var rowTotal = openQty + totalAsortiQty;
                row.find('.row-total-qty').val(rowTotal);
                
                calculateGrandTotalQuantity();
            }

            function calculateGrandTotalQuantity() {
                var grandTotalQty = 0;
                $('.row-total-qty').each(function() {
                    grandTotalQty += (parseInt($(this).val()) || 0);
                });
                $('#modalQty').val(grandTotalQty).trigger('input');
            }

            $(document).on('input', '.open-size, .asorti-size, .asorti-count', function() {
                var row = $(this).closest('.color-row');
                
                if ($(this).hasClass('open-size')) {
                    var size = $(this).data('size');
                    var val = parseInt($(this).val()) || 0;
                    var openSizes = row.data('openSizes') || {};
                    openSizes[size] = val;
                    row.data('openSizes', openSizes);
                } else if ($(this).hasClass('asorti-size')) {
                    var size = $(this).data('size');
                    var val = parseInt($(this).val()) || 0;
                    var asortiSizes = row.data('asortiSizes') || {};
                    asortiSizes[size] = val;
                    row.data('asortiSizes', asortiSizes);
                }

                calculateRowTotals(row);
            });
            
            $(document).on('click', '.btnRemoveRow', function() {
                $(this).closest('.color-row').fadeOut(200, function() {
                    $(this).remove();
                    calculateGrandTotalQuantity();
                });
            });

            $("#btnAddColorRow").click(function() {
                var rowElement = createRowHtml(null);
                $("#colorRowsContainer").append(rowElement);
                calculateRowTotals(rowElement);
            });

            
            $("#btnAddColorRow").click();

          
            $("#newOrderForm").on("submit", function(e) {
                e.preventDefault();
                
                var rows = $(".color-row");
                if (rows.length === 0) {
                    showToast("Lütfen en az bir renk/satır ekleyin.", "danger");
                    return;
                }

                var formData = new FormData(this);
                var commonData = Object.fromEntries(formData.entries());
                
                var orders = [];
                rows.each(function() {
                    var row = $(this);
                    var orderObj = Object.assign({}, commonData);
                    
                    orderObj.Color = row.find('.row-color').val();
                    orderObj.OptionCode = "";
                    orderObj.IsJIT = row.find('.row-jit').val() === "true";
                    orderObj.SalesRegion = row.find('.row-region').val();
                    
                    
                    var openDist = Object.assign({}, row.data('openSizes') || {});
                    Object.keys(openDist).forEach(function(key) {
                        if ((parseInt(openDist[key]) || 0) <= 0) {
                            delete openDist[key];
                        }
                    });
                    orderObj.SizeDistributionJson = JSON.stringify(openDist);
                    
                    var asortiDist = Object.assign({}, row.data('asortiSizes') || {});
                    Object.keys(asortiDist).forEach(function(key) {
                        if ((parseInt(asortiDist[key]) || 0) <= 0) {
                            delete asortiDist[key];
                        }
                    });
                    orderObj.AsortiDistributionJson = JSON.stringify(asortiDist);

                 
                    orderObj.SizeS = openDist["S"] || 0;
                    orderObj.SizeM = openDist["M"] || 0;
                    orderObj.SizeL = openDist["L"] || 0;
                    orderObj.SizeXL = openDist["XL"] || 0;
                    orderObj.Size2XL = openDist["2XL"] || 0;
                    orderObj.Size3XL = openDist["3XL"] || 0;
                    
                    orderObj.AsortiSizeS = asortiDist["S"] || 0;
                    orderObj.AsortiSizeM = asortiDist["M"] || 0;
                    orderObj.AsortiSizeL = asortiDist["L"] || 0;
                    orderObj.AsortiSizeXL = asortiDist["XL"] || 0;
                    orderObj.AsortiSize2XL = asortiDist["2XL"] || 0;
                    orderObj.AsortiSize3XL = asortiDist["3XL"] || 0;
                    
                    orderObj.AsortiCount = parseInt(row.find('.row-asorti-count').val()) || 0;
                    orderObj.Quantity = parseInt(row.find('.row-total-qty').val()) || 0;
                    
                    orders.push(orderObj);
                });

                $.ajax({
                    url: '/Order/CreateMultiple',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(orders),
                    success: function(res) {
                        if (res.success) {
                            window.location.reload();
                        } else {
                            showToast("Hata: " + res.message, "danger");
                        }
                    },
                    error: function() {
                        showToast("Kayıt sırasında sunucu hatası oluştu.", "danger");
                    }
                });
            });

           
            $('.calc-trigger-modal').on('input', function() {
                var qty = parseFloat($('#modalQty').val()) || 0;
                var price = parseFloat($('#modalUnitPrice').val()) || 0;
                
                var total = qty * price;
                var vat = total * 0.10; 
                var grand = total + vat;

                $('#modalTotalAmt').val(total.toFixed(2));
                $('#modalVatAmt').val(vat.toFixed(2));
                $('#modalGrandTotal').val(grand.toFixed(2));
            });

            
            $(document).on("click", ".fabric-status-badge, .order-status-badge", function(e) {
                e.stopPropagation();
                var menu = $(this).siblings(".custom-dropdown-menu");
                $(".custom-dropdown-menu").not(menu).fadeOut(100); 
                menu.fadeToggle(150);
