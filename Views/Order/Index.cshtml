                    </div>

                
                    <div id="customSizeContainer" style="display: none; align-items: center; gap: 8px; margin-bottom: 16px; background: #f0fdf4; border: 1px dashed #bbf7d0; padding: 10px; border-radius: 8px; flex-wrap: wrap;">
