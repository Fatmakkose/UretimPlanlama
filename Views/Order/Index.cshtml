                        </div>
                        <div class="form-group">
                            <label>Ödeme Şekli</label>
                            <select name="PaymentMethod" class="form-control">
                                <option value="">- Seçiniz -</option>
                                <option value="Peşin">Peşin</option>
                                <option value="Vadeli">Vadeli</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Üretici Cari Kod</label>
                            <input name="ManufacturerCode" class="form-control" value="S0.TRLC-S0013909" readonly />
                        </div>
                        <div class="form-group">
                            <label>Üretici Firma</label>
                            <input name="ManufacturerCompany" class="form-control" placeholder="Örn: Kanuni Tekstil" />
                        </div>
                        <div class="form-group">
                            <label>Alıcı (Müşteri)</label>
                            <select name="Customer" class="form-control" required>
                                <option value="">-- Müşteri Seçin --</option>
