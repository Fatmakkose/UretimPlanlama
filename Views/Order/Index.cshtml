                genis_standart: ["XS", "S", "M", "L", "XL", "2XL", "3XL"],
                buyuk_beden: ["3XL", "4XL", "5XL", "6XL"],
                cocuk: ["2 Yaş", "4 Yaş", "6 Yaş", "8 Yaş", "10 Yaş", "12 Yaş"],
                numerik: ["36", "38", "40", "42", "44", "46"],
                ozel: []
            };
