            </h3>
            <button type="button" class="close-modal" id="btnCloseTrackingModal" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--text-muted); display: flex; align-items: center; justify-content: center; padding: 4px; transition: color 0.2s;" onmouseover="this.style.color='var(--text-main)';" onmouseout="this.style.color='var(--text-muted)';"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <form id="trackingForm" method="post" action="/Planning/UpdateTracking">
            <input type="hidden" name="Id" id="trackOrderId" />
            
            <div class="modal-body">
                
                <!-- 1. Kumaş Gerçekleşen -->
                <div class="modal-card" style="border-left: 4px solid #4f46e5;">
                    <h4 style="color: #4f46e5; border-color: rgba(79, 70, 229, 0.15);"><i class="fa-solid fa-truck"></i> 1. Kumaş & Tedarik (Gerçekleşen)</h4>
                    
                    <div class="form-group">
                        <label style="margin-bottom: 6px;"><i class="fa-regular fa-calendar-days"></i> Gerçekleşen Geliş Tarihi</label>
                        <div style="display: flex; gap: 10px; align-items: center;">
                            <input type="date" name="FabricArrivalActualDate" id="trackFabricActual" class="form-control" style="flex: 1;" />
                            <div class="plan-badge-pill fabric-theme">
                                <i class="fa-regular fa-calendar"></i>
                                <span id="trackFabricPlannedText">Plan: -</span>
                            </div>
                        </div>
                    </div>
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 16px;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label><i class="fa-solid fa-ruler"></i> Metraj (m)</label>
                            <input type="number" step="0.1" name="FabricMeterage" id="trackFabricMeterage" class="form-control" placeholder="Metraj girin" />
                        </div>
                        <div class="form-group" style="margin-bottom: 0;">
                            <label><i class="fa-solid fa-weight-hanging"></i> Kumaş Ağırlık (kg)</label>
                            <input type="number" step="0.1" name="ActualFabricQty" id="trackActualFabricQty" class="form-control" placeholder="Ağırlık girin" />
                        </div>
                    </div>
                </div>

                <!-- 2. Kesim Gerçekleşen -->
                <div class="modal-card" style="border-left: 4px solid #d97706;">
                    <h4 style="color: #d97706; border-color: rgba(217, 119, 6, 0.15);"><i class="fa-solid fa-scissors"></i> 2. Kesim (Gerçekleşen)</h4>
                    
                    <div style="display: flex; flex-direction: column; gap: 16px;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label style="margin-bottom: 6px;"><i class="fa-regular fa-calendar-check"></i> Kesim Başlangıç</label>
                            <div style="display: flex; gap: 10px; align-items: center;">
                                <input type="date" name="CuttingStartDate" id="trackCuttingStart" class="form-control" style="flex: 1;" />
                                <div class="plan-badge-pill cutting-theme">
                                    <i class="fa-regular fa-calendar"></i>
                                    <span id="trackCuttingStartPlannedText">Plan: -</span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" style="margin-bottom: 0;">
                            <label style="margin-bottom: 6px;"><i class="fa-regular fa-calendar-xmark"></i> Kesim Bitiş</label>
                            <div style="display: flex; gap: 10px; align-items: center;">
                                <input type="date" name="CuttingEndDate" id="trackCuttingEnd" class="form-control" style="flex: 1;" />
                                <div class="plan-badge-pill cutting-theme">
                                    <i class="fa-regular fa-calendar"></i>
                                    <span id="trackCuttingEndPlannedText">Plan: -</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. Dikim Gerçekleşen -->
                <div class="modal-card" style="border-left: 4px solid #0d9488;">
                    <h4 style="color: #0d9488; border-color: rgba(13, 148, 136, 0.15);"><i class="fa-solid fa-shirt"></i> 3. Dikim (Gerçekleşen)</h4>
                    
                    <div style="display: flex; flex-direction: column; gap: 16px;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label style="margin-bottom: 6px;"><i class="fa-regular fa-calendar-check"></i> Dikim Başlangıç</label>
                            <div style="display: flex; gap: 10px; align-items: center;">
                                <input type="date" name="SewingStartDate" id="trackSewingStart" class="form-control" style="flex: 1;" />
                                <div class="plan-badge-pill sewing-theme">
                                    <i class="fa-regular fa-calendar"></i>
                                    <span id="trackSewingStartPlannedText">Plan: -</span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" style="margin-bottom: 0;">
                            <label style="margin-bottom: 6px;"><i class="fa-regular fa-calendar-xmark"></i> Dikim Bitiş</label>
                            <div style="display: flex; gap: 10px; align-items: center;">
                                <input type="date" name="SewingEndDate" id="trackSewingEnd" class="form-control" style="flex: 1;" />
                                <div class="plan-badge-pill sewing-theme">
                                    <i class="fa-regular fa-calendar"></i>
                                    <span id="trackSewingEndPlannedText">Plan: -</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 4. Paket & Muayene Gerçekleşen -->
                <div class="modal-card" style="border-left: 4px solid #db2777;">
                    <h4 style="color: #db2777; border-color: rgba(219, 39, 119, 0.15);"><i class="fa-solid fa-box-open"></i> 4. Paket & Muayene (Gerçekleşen)</h4>
                    
                    <div style="display: flex; flex-direction: column; gap: 16px;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label style="margin-bottom: 6px;"><i class="fa-regular fa-calendar-check"></i> Paket Başlangıç</label>
                            <div style="display: flex; gap: 10px; align-items: center;">
                                <input type="date" name="PackagingStartDate" id="trackPackStart" class="form-control" style="flex: 1;" />
                                <div class="plan-badge-pill pack-theme">
                                    <i class="fa-regular fa-calendar"></i>
                                    <span id="trackPackStartPlannedText">Plan: -</span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" style="margin-bottom: 0;">
                            <label style="margin-bottom: 6px;"><i class="fa-regular fa-calendar-xmark"></i> Paket Bitiş</label>
                            <div style="display: flex; gap: 10px; align-items: center;">
                                <input type="date" name="PackagingEndDate" id="trackPackEnd" class="form-control" style="flex: 1;" />
                                <div class="plan-badge-pill pack-theme">
                                    <i class="fa-regular fa-calendar"></i>
                                    <span id="trackPackEndPlannedText">Plan: -</span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" style="margin-bottom: 0;">
                            <label style="margin-bottom: 6px;"><i class="fa-solid fa-magnifying-glass-chart"></i> Son Inspection</label>
                            <div style="display: flex; gap: 10px; align-items: center;">
                                <input type="date" name="LastInspectionDate" id="trackInspc" class="form-control" style="flex: 1;" />
                                <div class="plan-badge-pill pack-theme">
                                    <i class="fa-regular fa-calendar"></i>
                                    <span id="trackInspcPlannedText">Plan: -</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 5. Sevkiyat Gerçekleşen -->
                <div class="modal-card" style="border-left: 4px solid #2563eb; grid-column: span 2;">
                    <h4 style="color: #2563eb; border-color: rgba(37, 99, 235, 0.15);"><i class="fa-solid fa-circle-check"></i> 5. Sevkiyat & Depo (Gerçekleşen)</h4>
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label style="margin-bottom: 6px;"><i class="fa-solid fa-truck-moving"></i> Yola Çıkış</label>
                            <input type="date" name="DepartureDate" id="trackDepart" class="form-control" />
                        </div>
                        <div class="form-group" style="margin-bottom: 0;">
                            <label style="margin-bottom: 6px;"><i class="fa-solid fa-warehouse"></i> Depo Varış</label>
                            <input type="date" name="WarehouseArrivalDate" id="trackArrive" class="form-control" />
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary" id="btnCancelTrackingModal" style="padding: 10px 20px; border-radius: 8px;">İptal</button>
                <button type="submit" class="btn-planner" style="padding: 10px 20px; border-radius: 8px;">Takip Detaylarını Kaydet</button>
            </div>
        </form>
    </div>
</div>

<!-- Sipariş Detay Modal (Ortak) -->
<div id="orderDetailModal" class="modal-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.4); backdrop-filter: blur(8px); z-index: 1000; justify-content: center; align-items: center; transition: all 0.3s ease;">
    <div class="modal-content" style="background: white; width: 90%; max-width: 1000px; border-radius: 16px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25); overflow: hidden; transform: scale(0.95); transition: transform 0.3s ease; display: flex; flex-direction: column; max-height: 90%;">
        
        <!-- Header -->
        <div style="padding: 20px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; background: #fafafa;">
            <div>
                <h3 style="margin: 0; font-size: 1.3rem; font-weight: 700; color: var(--text-main); display: flex; align-items: center; gap: 10px;">
                    <i class="fa-solid fa-folder-open" style="color: var(--primary-color);"></i> Sipariş Detayı: <span id="detOrderCode" style="color: var(--primary-color);">...</span>
                </h3>
                <p style="margin: 4px 0 0 0; font-size: 0.85rem; color: var(--text-muted);">
                    <i class="fa-regular fa-calendar"></i> Sipariş Tarihi: <span id="detOrderDate">...</span>
                </p>
            </div>
            <div style="display: flex; align-items: center; gap: 10px; margin-right: 20px;">
                <span id="detStatusBadge" class="badge" style="font-size: 0.85rem; padding: 6px 14px; border-radius: 20px; font-weight: 600;">...</span>
                <span id="detFabricBadge" class="badge" style="font-size: 0.85rem; padding: 6px 14px; border-radius: 20px; font-weight: 600;">...</span>
                <span id="detJITBadge" class="badge" style="font-size: 0.85rem; padding: 6px 14px; border-radius: 20px; font-weight: 600; display: none;">JIT</span>
            </div>
            <button id="btnCloseDetailModal" style="background: transparent; border: none; font-size: 1.5rem; color: var(--text-muted); cursor: pointer; padding: 4px; display: flex; align-items: center; justify-content: center; transition: color 0.2s;"><i class="fa-solid fa-xmark"></i></button>
        </div>

        <!-- Body -->
        <div style="overflow-y: auto; padding: 24px; flex-grow: 1;">
            
            <div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 24px; margin-bottom: 24px;">
                <!-- Genel & Ürün Bilgileri Kartı -->
