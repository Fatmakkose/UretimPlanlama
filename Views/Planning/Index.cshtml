@model List<UretimPlanlama.Models.Order>
@{
    ViewData["Title"] = "Planlama";
}

<style>
    .premium-table {
        width: 100%;
        border-collapse: collapse;
    }
    .premium-table tr:hover {
        background-color: #f8fafc;
    }
    .status-badge {
        display: inline-block;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
    }
    
    .timeline-container {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.8rem;
    }
    .timeline-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        color: var(--text-muted);
        position: relative;
    }
    .timeline-step.active {
        color: var(--primary-color);
        font-weight: 600;
    }
    .timeline-step.completed {
        color: #10b981;
    }
    .timeline-line {
        height: 2px;
        width: 25px;
        background-color: var(--border-color);
        margin-top: -15px;
    }
    .timeline-line.active {
        background-color: #10b981;
    }
    .btn-plan {
        background-color: #0369a1;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.85rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: background-color 0.2s;
    }
    .btn-plan:hover {
        background-color: #0284c7;
        color: white;
    }
</style>

<div class="dashboard-header" style="margin-bottom: 25px;">
    <div class="header-title">
        <h1 style="font-size: 1.8rem; margin: 0; color: var(--text-main);">Planlama</h1>
    </div>
    <div class="header-actions" style="display: flex; gap: 12px; align-items: center;">
        <a href="/Planning/ExportToExcel" class="btn-planner" style="border-radius: 8px; font-size: 0.95rem; padding: 10px 18px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; background-color: #16a34a; border-color: #16a34a; color: white;">
            <i class="fa-solid fa-file-excel"></i> Excel Raporu
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div style="background-color: var(--success-bg); color: var(--success-text); padding: 15px; border-radius: 8px; margin-bottom: 20px; border: 1px solid rgba(13, 148, 136, 0.2);">
        <i class="fa-solid fa-circle-check" style="margin-right: 8px;"></i> @TempData["SuccessMessage"]
    </div>
}

<div class="schedule-list" style="overflow-x: auto; background: transparent; border: none; padding: 0;">
    <table class="premium-table" style="table-layout: fixed; width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem; background: white; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); border-radius: 8px; overflow: hidden;">
        <colgroup>
            <col style="width: 25%;" />
            <col style="width: 25%;" />
            <col style="width: 35%;" />
            <col style="width: 15%;" />
        </colgroup>
        <thead>
            <tr style="background: #f8fafc; border-bottom: 2px solid var(--border-color); color: var(--text-muted); font-weight: 600; text-transform: uppercase; font-size: 0.8rem; letter-spacing: 0.5px;">
                <th style="padding: 14px 16px; width: 25%;">SİPARİŞ BİLGİSİ</th>
                <th style="padding: 14px 16px; width: 25%;">KUMAŞ DURUMU</th>
                <th style="padding: 14px 16px; width: 35%;">PLANLANAN ÜRETİM SÜRECİ</th>
                <th style="padding: 14px 16px; width: 15%; text-align: center;">AKSİYON</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr style="border-bottom: 1px solid var(--border-color);">
                    <td style="padding: 16px;">
                        <a href="/Planning/Plan/@order.Id" style="color: var(--text-main); font-size: 0.95rem; font-weight: 700; display: block; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='var(--primary-color)';" onmouseout="this.style.color='var(--text-main)';">@order.OrderCode</a>
                        <span style="font-size: 0.85rem; color: var(--text-muted);">@order.ModelName - <span style="color:#0284c7; font-weight:600;">@order.Color</span></span>
                        <div style="margin-top: 4px; font-size: 0.8rem;">
                            <span style="color: #64748b;">@(order.Quantity) Adet</span>
                        </div>
                        @{
                            bool hasMissingMaterials = false;
                            if (!string.IsNullOrEmpty(order.PurchasingMaterialsJson))
                            {
                                try {
                                    var purDict = System.Text.Json.JsonSerializer.Deserialize<System.Collections.Generic.Dictionary<string, string>>(order.PurchasingMaterialsJson);
                                    if (purDict != null && purDict.TryGetValue("pur_has_missing_materials", out string missingVal) && missingVal == "true")
                                    {
                                        hasMissingMaterials = true;
                                    }
                                } catch {}
                            }
                        }
                        @if (hasMissingMaterials)
                        {
                            <div style="margin-top: 8px;">
                                <span style="background-color: #fef2f2; color: #dc2626; padding: 4px 8px; border-radius: 4px; font-size: 0.75rem; font-weight: 600; display: inline-flex; align-items: center; gap: 4px; border: 1px solid #fecaca; box-shadow: 0 1px 2px rgba(0,0,0,0.05);">
                                    <i class="fa-solid fa-triangle-exclamation"></i> Eksik Malzeme
                                </span>
                            </div>
                        }
                    </td>
                    
                    <td style="padding: 16px;">
                        <div style="font-size: 0.85rem;">
                            @if (!string.IsNullOrEmpty(order.FabricSupplier))
                            {
                                <strong><i class="fa-solid fa-truck" style="margin-right:4px;"></i>@order.FabricSupplier</strong>
                                <br />
                            }
                            else
                            {
                                <span style="color:var(--danger-text);">Kumaşçı Atanmadı</span>
                                <br />
                            }
                            
                            @if(order.FabricArrivalAgreedDate.HasValue)
                            {
                                <span style="color:var(--text-muted);">Hedef: @order.FabricArrivalAgreedDate.Value.ToString("dd.MM.yyyy")</span>
                                <br />
                            }
                            
                            @{
                                var fs = order.FabricStatus ?? "Bekleniyor";
                                var fsClass = "badge-scheduled";
                                if (fs == "Tamamlandı" || fs == "Kumaş Tam") fsClass = "badge-progress";
                                else if (fs == "Kısmi Geldi" || fs == "Gecikti") fsClass = "badge-medium";
                                else if (fs == "Bekleniyor" || fs == "Eksik") fsClass = "badge-high";
                            }
                            <div style="margin-top: 6px;">
                                <span class="badge @fsClass" style="font-size: 0.75rem; padding: 4px 10px; border-radius: 12px; font-weight: 600; display: inline-block; background-color: #fee2e2; color: #ef4444;">
                                    @fs
                                </span>
                            </div>
                        </div>
                    </td>
                    
                    <td style="padding: 16px;">
                        <div class="timeline-container">
                            <div class="timeline-step @(order.PlannedCuttingStartDate.HasValue ? "completed" : "")">
                                <i class="fa-solid fa-scissors" style="font-size: 1.1rem; margin-bottom: 4px;"></i>
                                <span>Kesim</span>
                                @if (order.PlannedCuttingStartDate.HasValue) {
                                    <span style="font-size: 0.7rem; color: var(--text-muted); margin-top: 2px;">@order.PlannedCuttingStartDate.Value.ToString("dd.MM")</span>
                                }
                            </div>
                            <div class="timeline-line @(order.PlannedCuttingEndDate.HasValue ? "active" : "")"></div>
                            
                            <div class="timeline-step @(order.PlannedSewingStartDate.HasValue ? "completed" : "")">
                                <i class="fa-solid fa-shirt" style="font-size: 1.1rem; margin-bottom: 4px;"></i>
                                <span>Dikim</span>
                                @if(!string.IsNullOrEmpty(order.SewingWorkshop))
                                {
                                    <span style="font-size: 0.65rem; color: #0284c7; font-weight: 600; margin-top:2px;">@order.SewingWorkshop.ToUpper()</span>
                                }
                                @if (order.PlannedSewingStartDate.HasValue) {
                                    <span style="font-size: 0.7rem; color: var(--text-muted); margin-top: 2px;">@order.PlannedSewingStartDate.Value.ToString("dd.MM")</span>
                                }
                            </div>
                            <div class="timeline-line @(order.PlannedSewingEndDate.HasValue ? "active" : "")"></div>
                            
                            <div class="timeline-step @(order.PlannedPackagingStartDate.HasValue ? "completed" : "")">
                                <i class="fa-solid fa-box" style="font-size: 1.1rem; margin-bottom: 4px;"></i>
                                <span>Paket</span>
                                @if (order.PlannedPackagingStartDate.HasValue) {
                                    <span style="font-size: 0.7rem; color: var(--text-muted); margin-top: 2px;">@order.PlannedPackagingStartDate.Value.ToString("dd.MM")</span>
                                }
                            </div>
                        </div>
                    </td>
                    
                    <td style="padding: 16px; text-align: center;">
                        <a href="/Planning/Plan/@order.Id" class="btn-plan">
                            <i class="fa-solid fa-calendar-days"></i> Planla
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
