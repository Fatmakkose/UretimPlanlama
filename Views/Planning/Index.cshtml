                        </div>
                        <div style="display: flex; justify-content: space-between; border-bottom: 1px dashed #e2e8f0; padding-bottom: 8px;">
                            <span style="color: var(--text-muted);"><i class="fa-solid fa-money-bill-wave" style="margin-right: 8px; width: 14px;"></i>KDV'siz Toplam</span>
                            <strong id="detTotalAmount" style="color: var(--text-main);">...</strong>
                        </div>
                        <div style="display: flex; justify-content: space-between; border-bottom: 1px dashed #e2e8f0; padding-bottom: 8px;">
                            <span style="color: var(--text-muted);"><i class="fa-solid fa-percent" style="margin-right: 8px; width: 14px;"></i>KDV Tutarı (%10)</span>
                            <strong id="detVatAmount" style="color: var(--text-main);">...</strong>
                        </div>
                        <div style="display: flex; justify-content: space-between; border-bottom: 1px dashed #e2e8f0; padding-bottom: 8px;">
                            <span style="color: var(--text-muted);"><i class="fa-solid fa-credit-card" style="margin-right: 8px; width: 14px;"></i>Ödeme Şekli</span>
