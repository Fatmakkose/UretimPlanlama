@model UretimPlanlama.Models.Order
@{
    ViewData["Title"] = "Sipariş Planlama";
    var allOrders = ViewBag.AllOrders as List<UretimPlanlama.Models.Order>;
}

<style>
    .planning-layout {
        display: flex;
        gap: 20px;
        align-items: flex-start;
    }
    
    .sidebar-orders {
        width: 300px;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
        overflow: hidden;
        flex-shrink: 0;
    }
    
    .sidebar-header {
        padding: 16px;
        border-bottom: 1px solid var(--border-color);
        background: #f8fafc;
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
        color: var(--text-main);
    }
    
    .order-list-item {
        padding: 16px;
        border-bottom: 1px solid var(--border-color);
        cursor: pointer;
        transition: background-color 0.2s;
        text-decoration: none;
        display: block;
        color: inherit;
    }
    
    .order-list-item:hover {
        background-color: #f1f5f9;
    }
    
    .order-list-item.active {
        border-left: 4px solid var(--primary-color);
        background-color: #f0f9ff;
    }
    
    .main-planning {
        flex-grow: 1;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
        padding: 24px;
    }
    
    .plan-tabs {
        display: flex;
        gap: 16px;
        margin-bottom: 24px;
    }
    
    .plan-tab {
        flex: 1;
        background: #f8fafc;
        border: 2px solid transparent;
        border-radius: 8px;
        padding: 20px;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
    }
    
    .plan-tab:hover {
        background: #f1f5f9;
    }
    
    .plan-tab.active {
        border-color: var(--primary-color);
        background: #f0f9ff;
    }
    
    .plan-tab i {
        font-size: 1.5rem;
        color: #64748b;
    }
    
    .plan-tab.active i {
        color: var(--primary-color);
    }
    
    .plan-tab-title {
        font-weight: 700;
        font-size: 0.9rem;
        color: var(--text-main);
    }
    
    .plan-tab-status {
        font-size: 0.75rem;
        font-weight: 700;
    }
    
    .status-complete { color: #16a34a; }
    .status-progress { color: #d97706; }
    .status-notstarted { color: #64748b; }
    
    .tab-content {
        display: none;
    }
    
    .tab-content.active {
        display: block;
    }
    
    .content-section {
        background: #fff;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 20px;
    }
    
    .section-title {
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-main);
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    
    .data-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
    }
    
    .data-item {
        background: #f8fafc;
        padding: 12px;
        border-radius: 6px;
        border: 1px solid #e2e8f0;
    }
    
    .data-label {
        font-size: 0.75rem;
        color: #64748b;
        margin-bottom: 4px;
        font-weight: 600;
        text-transform: uppercase;
    }
    
    .data-value {
        font-size: 1.1rem;
        font-weight: 700;
        color: #0f172a;
    }
    
    .input-field {
        width: 100%;
        padding: 8px;
        border: 1px solid #cbd5e1;
        border-radius: 4px;
        font-size: 0.9rem;
    }
    
    .table-details {
        width: 100%;
        border-collapse: collapse;
        margin-top: 16px;
    }
    
    .table-details th {
        background: #f8fafc;
        padding: 12px;
        text-align: left;
        font-size: 0.8rem;
        color: #64748b;
        font-weight: 600;
        border-bottom: 2px solid #e2e8f0;
    }
    
    .table-details td {
        padding: 12px;
        border-bottom: 1px solid #e2e8f0;
        font-size: 0.9rem;
    }
</style>

<div class="planning-layout">
    <!-- Sol Menü: Sipariş Listesi -->
    <div class="sidebar-orders">
        <div class="sidebar-header">
            <i class="fa-solid fa-list"></i> SİPARİŞ LİSTESİ
        </div>
        <div style="padding: 12px; border-bottom: 1px solid var(--border-color);">
            <div class="search-box" style="position: relative; margin-bottom: 8px;">
                <i class="fa-solid fa-search" style="position: absolute; left: 10px; top: 10px; color: #94a3b8;"></i>
                <input type="text" id="orderSearch" placeholder="Sipariş Ara..." class="input-field" style="padding-left: 32px;" />
            </div>
            <label style="font-size: 0.8rem; display: flex; align-items: center; gap: 6px; cursor: pointer; color: #475569;">
                <input type="checkbox" id="showAllOrders" /> Tümünü Gör
            </label>
        </div>
        <div class="order-list" style="max-height: calc(100vh - 200px); overflow-y: auto;">
            @if(allOrders != null)
            {
                foreach (var o in allOrders)
                {
                    bool isActive = o.Status != "Tamamlandı" && o.Status != "İptal Edildi";
                    string displayStyle = isActive ? "block" : "none";
                    <a href="/Planning/Plan/@o.Id" class="order-list-item @(o.Id == Model.Id ? "active" : "")" data-active="@isActive.ToString().ToLower()" style="display: @displayStyle;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                            <strong style="font-size: 1rem; color: #0f172a;">@o.OrderCode</strong>
                            @if(isActive) {
                                <span style="font-size: 0.7rem; font-weight: 700; color: #16a34a;">AKTİF</span>
                            } else {
                                <span style="font-size: 0.7rem; font-weight: 700; color: #64748b;">PASİF</span>
                            }
                        </div>
                        <div style="font-size: 0.8rem; color: #64748b; margin-bottom: 8px;">
                            @o.ModelName - @o.Color
                        </div>
                        <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: #475569; font-weight: 600;">
                            <span>MÜŞTERİ: @o.Customer</span>
                            <span>ADET: @o.Quantity.ToString("N0")</span>
                        </div>
                        <div style="font-size: 0.75rem; color: #475569; font-weight: 600; margin-top: 4px;">
                            TARİH: @o.OrderDate.ToString("dd.MM.yyyy")
                        </div>
                    </a>
                }
            }
        </div>
    </div>

    <!-- Sağ İçerik: Planlama Detayı -->
    @if (Model != null && Model.Id > 0)
    {
        <div class="main-planning">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
            <div>
                <span style="font-size: 0.75rem; color: #64748b; font-weight: 600; text-transform: uppercase;">PLANLAMA DETAYI</span>
                <h2 style="margin: 4px 0 0 0; color: #0f172a;">@Model.OrderCode</h2>
            </div>
            <div style="display: flex; gap: 8px;">
                <button class="btn-planner" style="background: #16a34a; border-color: #16a34a;"><i class="fa-solid fa-file-excel"></i> Excel</button>
                <button class="btn-secondary"><i class="fa-solid fa-clock-rotate-left"></i> Geçmiş</button>
            </div>
        </div>

        @{
            var activeTab = TempData["ActiveTab"]?.ToString() ?? "numune";
        }

        <!-- Aşama Kartları -->
        <div class="plan-tabs">
            <div class="plan-tab @(activeTab == "numune" ? "active" : "")" onclick="switchTab('numune', this)">
                <i class="fa-solid fa-clipboard-check"></i>
                <div class="plan-tab-title">1. NUMUNE/TEST PLANLAMA</div>
                @if (Model.IsSampleTestCompleted) {
                    <div class="plan-tab-status status-complete">%100 TAMAM</div>
                } else {
                    <div class="plan-tab-status status-notstarted">BEKLİYOR</div>
                }
            </div>
            <div class="plan-tab @(activeTab == "satinalma" ? "active" : "")" onclick="switchTab('satinalma', this)">
                <i class="fa-solid fa-cart-shopping"></i>
                <div class="plan-tab-title">2. SATIN ALMA PLANLAMA</div>
                @if (Model.IsPurchasingCompleted) {
                    <div class="plan-tab-status status-complete">%100 TAMAM</div>
                } else {
                    <div class="plan-tab-status status-notstarted">BEKLİYOR</div>
                }
            </div>
            <div class="plan-tab @(activeTab == "uretim" ? "active" : "")" onclick="switchTab('uretim', this)">
                <i class="fa-solid fa-industry"></i>
                <div class="plan-tab-title">3. ÜRETİM PLANLAMA</div>
                @if (Model.IsProductionCompleted) {
                    <div class="plan-tab-status status-complete">%100 TAMAM</div>
                } else {
                    <div class="plan-tab-status status-notstarted">BEKLİYOR</div>
                }
            </div>
        </div>

        <!-- Sekme 1: Numune/Test -->
        <div id="tab-numune" class="tab-content @(activeTab == "numune" ? "active" : "")">
            <form action="/Planning/UpdateSampleTestPlan" method="post">
                <input type="hidden" name="Id" value="@Model.Id" />
                <h3 style="font-size: 1.1rem; margin-bottom: 16px; color: #1e293b;">Numune ve Test Planlama Detayları</h3>
                
                @{
                    var sampleData = new System.Collections.Generic.Dictionary<string, string>();
                    if (!string.IsNullOrEmpty(Model.SampleTestJson))
                    {
                        try {
                            sampleData = System.Text.Json.JsonSerializer.Deserialize<System.Collections.Generic.Dictionary<string, string>>(Model.SampleTestJson);
                        } catch {}
                    }
                    string GetSampleVal(string key) => sampleData.ContainsKey(key) ? sampleData[key] : "";
                }

                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px;">
                    <!-- Ana Kumaş Kartı -->
                    <div class="content-section">
                        <div class="section-title">
                            <i class="fa-solid fa-layer-group"></i> Ana Kumaş
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 16px;">
                            <div>
                                <div class="data-label">NUMUNE KUMAŞ Y-TESTİ</div>
                                <input type="date" name="sample_kumas_ytesti" class="input-field" value="@GetSampleVal("sample_kumas_ytesti")" />
                            </div>
                            <div>
                                <div class="data-label">K-TUŞE RENK ONAYI test vr tarihi</div>
                                <input type="date" name="sample_tuse_renk" class="input-field" value="@GetSampleVal("sample_tuse_renk")" />
                            </div>
                            <div>
                                <div class="data-label">KUMAŞ KARIŞIMI</div>
                                <input type="text" name="sample_kumas_karisim" class="input-field" placeholder="Örn: %80 Pamuk %20 Polyester" value="@GetSampleVal("sample_kumas_karisim")" />
                            </div>
                        </div>
                    </div>

                    <!-- Düğme Kartı -->
                    <div class="content-section">
                        <div class="section-title">
                            <i class="fa-solid fa-circle-dot"></i> Düğme
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 16px;">
                            <div>
                                <div class="data-label">DÜĞME RENK KALİTE ONAY</div>
                                <input type="date" name="sample_dugme_renk" class="input-field" value="@GetSampleVal("sample_dugme_renk")" />
                            </div>
                            <div>
                                <div class="data-label">DÜĞME TESTİ</div>
                                <input type="date" name="sample_dugme_test" class="input-field" value="@GetSampleVal("sample_dugme_test")" />
                            </div>
                        </div>
                    </div>

                    <!-- FIT / PPS Numunesi Kartı -->
                    <div class="content-section">
                        <div class="section-title">
                            <i class="fa-solid fa-shirt"></i> FIT / PPS Numunesi
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 16px;">
                            <div>
                                <div class="data-label">PP ONAY (Üretim öncesi en kritik onay)</div>
                                <input type="date" name="sample_pp_onay" class="input-field" value="@GetSampleVal("sample_pp_onay")" />
                            </div>
                        </div>
                    </div>
                </div>
                
                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 20px;">
                    <label style="display: flex; align-items: center; gap: 8px; font-weight: 600; color: #0f172a;">
                        <input type="checkbox" name="IsSampleTestCompleted" value="true" @(Model.IsSampleTestCompleted ? "checked" : "") /> 
                        <span style="color: #16a34a;"><i class="fa-solid fa-check-circle"></i> Numune Aşaması Tamamlandı</span>
                    </label>
                    <button type="submit" class="btn-planner" style="background: var(--primary-color); color: white; border: none; padding: 10px 24px; border-radius: 6px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px;"><i class="fa-solid fa-save"></i> Numune/Test Planını Kaydet</button>
                </div>
            </form>
        </div>

        <!-- Sekme 2: Satın Alma -->
        <div id="tab-satinalma" class="tab-content @(activeTab == "satinalma" ? "active" : "")">
            <form action="/Planning/UpdatePurchasingPlan" method="post">
                <input type="hidden" name="Id" value="@Model.Id" />
                <h3 style="font-size: 1.1rem; margin-bottom: 16px; color: #1e293b;">Satın Alma & Tedarik Detayları <span style="font-size: 0.85rem; color: #64748b; font-weight: normal;">Kumaş ve aksesuar stok durumu ve terminleri</span></h3>
            
            @{
                var purData = new System.Collections.Generic.Dictionary<string, string>();
                if (!string.IsNullOrEmpty(Model.PurchasingMaterialsJson))
                {
                    try {
                        purData = System.Text.Json.JsonSerializer.Deserialize<System.Collections.Generic.Dictionary<string, string>>(Model.PurchasingMaterialsJson);
                    } catch {}
                }
                string GetPurVal(string key) => purData.ContainsKey(key) ? purData[key] : "";
            }

            <input type="hidden" name="ActualFabricMeterage" value="@Model.ActualFabricMeterage" />
            <input type="hidden" name="ActualFabricQty" value="@Model.ActualFabricQty" />
            <input type="hidden" name="AccessoryCompletionDate" value="@(Model.AccessoryCompletionDate?.ToString("yyyy-MM-dd"))" />

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                <!-- Ana Kumaş Kartı -->
                <div class="content-section">
                    <div class="section-title">
                        <i class="fa-solid fa-layer-group"></i> Ana Kumaş
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 16px;">
                        <div>
                            <div class="data-label">KUMAŞÇI</div>
                            <select name="FabricSupplier" class="input-field">
                                <option value="">-- Kumaşçı Seçin --</option>
                                @if (ViewBag.Fabricators != null)
                                {
                                    foreach (var f in (System.Collections.Generic.List<UretimPlanlama.Models.Fabricator>)ViewBag.Fabricators)
                                    {
                                        if (Model.FabricSupplier == f.Name)
                                        {
                                            <option value="@f.Name" selected>@f.Name</option>
                                        }
                                        else
                                        {
                                            <option value="@f.Name">@f.Name</option>
                                        }
                                    }
                                }
                            </select>
                        </div>
                        <div>
                            <div class="data-label">KUMAŞ SEVK-ANLAŞILAN</div>
                            <input type="date" name="FabricArrivalAgreedDate" class="input-field" value="@(Model.FabricArrivalAgreedDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div>
                            <div class="data-label">KUMAŞ GELİŞ TARİHİ</div>
                            <input type="date" name="FabricArrivalActualDate" class="input-field" value="@(Model.FabricArrivalActualDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                    </div>
                </div>

                <!-- Düğme Kartı -->
                <div class="content-section">
                    <div class="section-title">
                        <i class="fa-solid fa-circle-dot"></i> Düğme
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 16px;">
                        <div>
                            <div class="data-label">DÜĞME-GELİŞİ</div>
                            <input type="date" name="pur_dugme_gelisi" class="input-field" value="@GetPurVal("pur_dugme_gelisi")" />
                        </div>
                        <div>
                            <div class="data-label">DÜĞME DİKİŞ İPİ</div>
                            <input type="date" name="pur_dugme_dikis_ipi" class="input-field" value="@GetPurVal("pur_dugme_dikis_ipi")" />
                        </div>
                    </div>
                </div>

                <!-- Aksesuar Kartı -->
                <div class="content-section">
                    <div class="section-title">
                        <i class="fa-solid fa-tags"></i> Aksesuar
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 16px;">
                        <div>
                            <div class="data-label">ETİKET-GELİŞİ</div>
                            <input type="date" name="pur_etiket_gelisi" class="input-field" value="@GetPurVal("pur_etiket_gelisi")" />
                        </div>
                        <div>
                            <div class="data-label">YIK-TALİMAT-GELİŞİ</div>
                            <input type="date" name="pur_yik_talimat_gelisi" class="input-field" value="@GetPurVal("pur_yik_talimat_gelisi")" />
                        </div>
                        <div>
                            <div class="data-label">FİYAT KART-GELİŞİ</div>
                            <input type="date" name="pur_fiyat_kart_gelisi" class="input-field" value="@GetPurVal("pur_fiyat_kart_gelisi")" />
                        </div>
                    </div>
                </div>

                <!-- UKP Malzeme Kartı -->
                <div class="content-section">
                    <div class="section-title">
                        <i class="fa-solid fa-box"></i> UKP Malzeme
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 16px;">
                        <div>
                            <div class="data-label">YK-İÇ GELİŞİ</div>
                            <input type="date" name="pur_yk_ic_gelisi" class="input-field" value="@GetPurVal("pur_yk_ic_gelisi")" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Malzeme Tablosu (JSON Simülasyonu İçin Gizli Alan) -->
            <input type="hidden" name="PurchasingMaterialsJson" id="PurchasingMaterialsJson" value="@Model.PurchasingMaterialsJson" />
            <table class="table-details">
                <thead>
                    <tr>
                        <th>MALZEME TÜRÜ</th>
                        <th>BİRİM</th>
                        <th>PLAN</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var materials = new List<dynamic>();

                        if (Model.LargeButtonCount.HasValue && Model.LargeButtonCount > 0)
                            materials.Add(new { Name = "Büyük Düğme", DefaultPlan = (decimal)(Model.Quantity * Model.LargeButtonCount.Value), Unit = "ADET", Key = "pur_plan_buyuk_dugme" });

                        if (Model.SmallButtonCount.HasValue && Model.SmallButtonCount > 0)
                            materials.Add(new { Name = "Küçük Düğme", DefaultPlan = (decimal)(Model.Quantity * Model.SmallButtonCount.Value), Unit = "ADET", Key = "pur_plan_kucuk_dugme" });

                        if (Model.HasPriceCard)
                            materials.Add(new { Name = "Fiyat Kartı", DefaultPlan = (decimal)Model.Quantity, Unit = "ADET", Key = "pur_plan_fiyat_karti" });

                        if (Model.HasWashingInstruction)
                            materials.Add(new { Name = "Yıkama Talimatı", DefaultPlan = (decimal)Model.Quantity, Unit = "ADET", Key = "pur_plan_yikama_talimat" });

                        if (Model.HasInnerBarcode)
                            materials.Add(new { Name = "İç Barkod", DefaultPlan = (decimal)Model.Quantity, Unit = "ADET", Key = "pur_plan_ic_barkod" });

                        if (Model.HasYokeLabel)
                            materials.Add(new { Name = "Roba Etiketi", DefaultPlan = (decimal)Model.Quantity, Unit = "ADET", Key = "pur_plan_roba_etiket" });

                        if (Model.HasFifLabel)
                            materials.Add(new { Name = "Fif Etiketi", DefaultPlan = (decimal)Model.Quantity, Unit = "ADET", Key = "pur_plan_fif_etiket" });

                        if (Model.HasOtherCard)
                            materials.Add(new { Name = "Diğer Kart", DefaultPlan = (decimal)Model.Quantity, Unit = "ADET", Key = "pur_plan_diger_kart" });

                        if (Model.CollarInterliningMeterage.HasValue && Model.CollarInterliningMeterage > 0)
                            materials.Add(new { Name = "Yaka Telası", DefaultPlan = (decimal)(Model.Quantity * Model.CollarInterliningMeterage.Value), Unit = "METRE", Key = "pur_plan_yaka_tela" });

                        if (Model.CuffInterliningMeterage.HasValue && Model.CuffInterliningMeterage > 0)
                            materials.Add(new { Name = "Manşet Telası", DefaultPlan = (decimal)(Model.Quantity * Model.CuffInterliningMeterage.Value), Unit = "METRE", Key = "pur_plan_manset_tela" });

                        if (Model.PlacketInterliningMeterage.HasValue && Model.PlacketInterliningMeterage > 0)
                            materials.Add(new { Name = "Pat Telası", DefaultPlan = (decimal)(Model.Quantity * Model.PlacketInterliningMeterage.Value), Unit = "METRE", Key = "pur_plan_pat_tela" });

                        if (!materials.Any())
                        {
                            <tr>
                                <td colspan="3" style="text-align: center; color: #64748b; padding: 20px;">Model detayında seçilmiş herhangi bir aksesuar/malzeme bulunmamaktadır.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in materials)
                            {
                                string valStr = GetPurVal(item.Key);

                                <tr>
                                    <td>@item.Name</td>
                                    <td style="font-weight: 600; color: #64748b;">@item.Unit</td>
                                    <td><input type="text" name="@item.Key" class="input-field" value="@valStr" style="width: 150px; padding: 4px;" /></td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
            
            <div style="display: flex; justify-content: space-between; margin-top: 20px; align-items: center;">
                <label style="display: flex; align-items: center; gap: 8px; font-weight: 600; color: #0f172a;">
                    <input type="checkbox" name="IsPurchasingCompleted" value="true" @(Model.IsPurchasingCompleted ? "checked" : "") /> 
                    <span style="color: #16a34a;"><i class="fa-solid fa-check-circle"></i> Satın Alma Aşaması Tamamlandı</span>
                </label>
                <button type="submit" class="btn-planner" style="background: #1d4ed8; color: white; border: none; padding: 10px 24px; border-radius: 6px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px;"><i class="fa-solid fa-save"></i> Satın Alma Planını Kaydet</button>
            </div>
            </form>
        </div>

        <!-- Sekme 3: Üretim -->
        <div id="tab-uretim" class="tab-content @(activeTab == "uretim" ? "active" : "")">
            <form action="/Planning/UpdateProductionPlan" method="post">
                <input type="hidden" name="Id" value="@Model.Id" />
                <h3 style="font-size: 1.1rem; margin-bottom: 16px; color: #1e293b;">Üretim Planlama Detayları</h3>
                
                @{
                    var prodData = new System.Collections.Generic.Dictionary<string, string>();
                    if (!string.IsNullOrEmpty(Model.ProductionJson))
                    {
                        try {
                            prodData = System.Text.Json.JsonSerializer.Deserialize<System.Collections.Generic.Dictionary<string, string>>(Model.ProductionJson);
                        } catch {}
                    }
                    string GetProdVal(string key) => prodData.ContainsKey(key) ? prodData[key] : "";
                }

                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px;">
                    <!-- Kesim ve Dikim Kartı -->
                    <div class="content-section">
                        <div class="section-title">
                            <i class="fa-solid fa-scissors"></i> Kesim ve Dikim
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 16px;">
                            <div>
                                <div class="data-label">DİKİM ATÖLYESİ</div>
                                <select name="prod_dikim_atolyesi" class="input-field">
                                    <option value="">-- Atölye Seçin --</option>
                                    @if (ViewBag.Workshops != null)
                                    {
                                        var prodDikim = GetProdVal("prod_dikim_atolyesi");
                                        foreach (var w in (System.Collections.Generic.List<UretimPlanlama.Models.Workshop>)ViewBag.Workshops)
                                        {
                                            if (prodDikim == w.Name)
                                            {
                                                <option value="@w.Name" selected>@w.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@w.Name">@w.Name</option>
                                            }
                                        }
                                    }
                                </select>
                            </div>
                            <div>
                                <div class="data-label">KESİM BAŞLANGIÇ</div>
                                <input type="date" name="prod_kesim_baslangic" class="input-field" value="@GetProdVal("prod_kesim_baslangic")" />
                            </div>
                            <div>
                                <div class="data-label">KESİM BİTİŞ</div>
                                <input type="date" name="prod_kesim_bitis" class="input-field" value="@GetProdVal("prod_kesim_bitis")" />
                            </div>
                            <div>
                                <div class="data-label">KESİM MİKTARI</div>
                                <input type="number" name="prod_kesim_miktari" class="input-field" value="@GetProdVal("prod_kesim_miktari")" placeholder="Örn: 1000" />
                            </div>
                            <div>
                                <div class="data-label">DİKİM BAŞLANGIÇ</div>
                                <input type="date" name="prod_dikim_baslangic" class="input-field" value="@GetProdVal("prod_dikim_baslangic")" />
                            </div>
                            <div>
                                <div class="data-label">DİKİM BİTİŞ</div>
                                <input type="date" name="prod_dikim_bitis" class="input-field" value="@GetProdVal("prod_dikim_bitis")" />
                            </div>
                        </div>
                    </div>

                    <!-- Paket ve Lojistik Kartı -->
                    <div class="content-section">
                        <div class="section-title">
                            <i class="fa-solid fa-box-open"></i> Paket ve Lojistik
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 16px;">
                            <div>
                                <div class="data-label">PAKET BAŞLANGIÇ</div>
                                <input type="date" name="prod_paket_baslangic" class="input-field" value="@GetProdVal("prod_paket_baslangic")" />
                            </div>
                            <div>
                                <div class="data-label">PAKET BİTİŞ</div>
                                <input type="date" name="prod_paket_bitis" class="input-field" value="@GetProdVal("prod_paket_bitis")" />
                            </div>
                            <div>
                                <div class="data-label">GS GİDİŞİ</div>
                                <input type="date" name="prod_gs_gidisi" class="input-field" value="@GetProdVal("prod_gs_gidisi")" />
                            </div>
                            <div>
                                <div class="data-label">YOLA ÇIKIŞ</div>
                                <input type="date" name="prod_yola_cikis" class="input-field" value="@GetProdVal("prod_yola_cikis")" />
                            </div>
                            <div>
                                <div class="data-label">DEPO VARIŞ</div>
                                <input type="date" name="prod_depo_varis" class="input-field" value="@GetProdVal("prod_depo_varis")" />
                            </div>
                        </div>
                    </div>

                    <!-- Termin Kartı -->
                    <div class="content-section">
                        <div class="section-title">
                            <i class="fa-solid fa-calendar-check"></i> Termin Bilgileri
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 16px;">
                            <div>
                                <div class="data-label">Termin Tarihi</div>
                                @{
                                    var suAnkiTermin = GetProdVal("prod_suanki_termin");
                                    if (string.IsNullOrEmpty(suAnkiTermin) && Model.PlannedPackagingEndDate.HasValue)
                                    {
                                        suAnkiTermin = Model.PlannedPackagingEndDate.Value.ToString("yyyy-MM-dd");
                                    }
                                }
                                <input type="date" name="prod_suanki_termin" class="input-field" value="@suAnkiTermin" />
                            </div>
                            <div>
                                <div class="data-label">KNN REVİZE TERMİN</div>
                                <input type="date" name="prod_knn_revize_termin" class="input-field" value="@GetProdVal("prod_knn_revize_termin")" />
                            </div>
                        </div>
                    </div>
                </div>

                <div style="display: flex; justify-content: space-between; margin-top: 20px; align-items: center;">
                    <label style="display: flex; align-items: center; gap: 8px; font-weight: 600; color: #0f172a;">
                        <input type="checkbox" name="IsProductionCompleted" value="true" @(Model.IsProductionCompleted ? "checked" : "") /> 
                        <span style="color: #16a34a;"><i class="fa-solid fa-check-circle"></i> Üretim Aşaması Tamamlandı</span>
                    </label>
                    <button type="submit" class="btn-planner" style="background: #1d4ed8; color: white; border: none; padding: 10px 24px; border-radius: 6px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px;"><i class="fa-solid fa-save"></i> Üretim Planını Kaydet</button>
                </div>
            </form>
        </div>

        </div>
    }
    else
    {
        <div class="main-planning" style="display: flex; justify-content: center; align-items: center; min-height: 400px;">
            <div style="text-align: center; color: #64748b;">
                <i class="fa-solid fa-hand-pointer" style="font-size: 3rem; margin-bottom: 16px; color: #cbd5e1;"></i>
                <h3>Planlama Detayı İçin Sipariş Seçin</h3>
                <p>Sol taraftaki listeden planlamasını görmek istediğiniz siparişi seçiniz.</p>
            </div>
        </div>
    }
</div>

<script>
    function switchTab(tabId, element) {
        // Tüm sekmeleri inaktif yap
        document.querySelectorAll('.plan-tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
        
        // Seçileni aktif yap
        element.classList.add('active');
        document.getElementById('tab-' + tabId).classList.add('active');
    }

    // Sipariş arama ve filtreleme
    function filterOrders() {
        var searchValue = document.getElementById('orderSearch').value.toLowerCase();
        var showAll = document.getElementById('showAllOrders').checked;
        var items = document.querySelectorAll('.order-list-item');
        
        items.forEach(function(item) {
            var text = item.textContent.toLowerCase();
            var isActive = item.getAttribute('data-active') === 'true';
            var matchesSearch = text.includes(searchValue);
            var matchesFilter = showAll || isActive;
            
            item.style.display = (matchesSearch && matchesFilter) ? 'block' : 'none';
        });
    }

    document.getElementById('orderSearch').addEventListener('keyup', filterOrders);
    document.getElementById('showAllOrders').addEventListener('change', filterOrders);
</script>
