@model UretimPlanlama.Models.Order
@{
    ViewData["Title"] = "Sipariş Planlama";
    var allOrders = ViewBag.AllOrders as List<UretimPlanlama.Models.Order>;
}

<style>
    .planning-layout {
        display: flex;
        gap: 20px;
        align-items: flex-start;
    }
    
    .sidebar-orders {
        width: 300px;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
        overflow: hidden;
        flex-shrink: 0;
    }
    
    .sidebar-header {
        padding: 16px;
        border-bottom: 1px solid var(--border-color);
        background: #f8fafc;
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
        color: var(--text-main);
    }
    
    .order-list-item {
        padding: 16px;
        border-bottom: 1px solid var(--border-color);
        cursor: pointer;
        transition: background-color 0.2s;
        text-decoration: none;
        display: block;
        color: inherit;
    }
    
    .order-list-item:hover {
        background-color: #f1f5f9;
    }
    
    .order-list-item.active {
        border-left: 4px solid var(--primary-color);
        background-color: #f0f9ff;
    }
    
    .main-planning {
        flex-grow: 1;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
        padding: 24px;
    }
    
    .plan-tabs {
        display: flex;
        gap: 16px;
        margin-bottom: 24px;
    }
    
    .plan-tab {
        flex: 1;
        background: #f8fafc;
        border: 2px solid transparent;
        border-radius: 8px;
        padding: 20px;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
    }
    
    .plan-tab:hover {
        background: #f1f5f9;
    }
    
    .plan-tab.active {
        border-color: var(--primary-color);
        background: #f0f9ff;
    }
    
    .plan-tab i {
        font-size: 1.5rem;
        color: #64748b;
    }
    
    .plan-tab.active i {
        color: var(--primary-color);
    }
    
    .plan-tab-title {
        font-weight: 700;
        font-size: 0.9rem;
        color: var(--text-main);
    }
    
    .plan-tab-status {
        font-size: 0.75rem;
        font-weight: 700;
    }
    
    .status-complete { color: #16a34a; }
    .status-progress { color: #d97706; }
    .status-notstarted { color: #64748b; }
    
    .tab-content {
        display: none;
    }
    
    .tab-content.active {
        display: block;
    }
    
    .content-section {
        background: #fff;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 20px;
    }
    
    .section-title {
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-main);
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    
    .data-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
    }
    
    .data-item {
        background: #f8fafc;
        padding: 12px;
        border-radius: 6px;
        border: 1px solid #e2e8f0;
    }
    
    .data-label {
        font-size: 0.75rem;
        color: #64748b;
        margin-bottom: 4px;
        font-weight: 600;
        text-transform: uppercase;
    }
    
    .data-value {
        font-size: 1.1rem;
        font-weight: 700;
        color: #0f172a;
    }
    
    .input-field {
        width: 100%;
        padding: 8px;
        border: 1px solid #cbd5e1;
        border-radius: 4px;
        font-size: 0.9rem;
    }
    
    .table-details {
        width: 100%;
        border-collapse: collapse;
        margin-top: 16px;
    }
    
    .table-details th {
        background: #f8fafc;
        padding: 12px;
        text-align: left;
        font-size: 0.8rem;
        color: #64748b;
        font-weight: 600;
        border-bottom: 2px solid #e2e8f0;
    }
    
    .table-details td {
        padding: 12px;
        border-bottom: 1px solid #e2e8f0;
        font-size: 0.9rem;
    }
</style>

<div class="planning-layout">
    <!-- Sol Menü: Sipariş Listesi -->
    <div class="sidebar-orders">
        <div class="sidebar-header">
            <i class="fa-solid fa-list"></i> SİPARİŞ LİSTESİ
        </div>
        <div style="padding: 12px; border-bottom: 1px solid var(--border-color);">
            <div class="search-box" style="position: relative; margin-bottom: 8px;">
                <i class="fa-solid fa-search" style="position: absolute; left: 10px; top: 10px; color: #94a3b8;"></i>
                <input type="text" id="orderSearch" placeholder="Sipariş Ara..." class="input-field" style="padding-left: 32px;" />
            </div>
            <label style="font-size: 0.8rem; display: flex; align-items: center; gap: 6px; cursor: pointer; color: #475569;">
                <input type="checkbox" id="showAllOrders" /> Tümünü Gör
            </label>
        </div>
        <div class="order-list" style="max-height: calc(100vh - 200px); overflow-y: auto;">
            @if(allOrders != null)
            {
                foreach (var o in allOrders)
                {
                    bool isActive = o.Status != "Tamamlandı" && o.Status != "İptal Edildi";
                    string displayStyle = isActive ? "block" : "none";
                    <a href="/Planning/Plan/@o.Id" class="order-list-item @(o.Id == Model.Id ? "active" : "")" data-active="@isActive.ToString().ToLower()" style="display: @displayStyle;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                            <strong style="font-size: 1rem; color: #0f172a;">@o.OrderCode</strong>
                            @if(isActive) {
                                <span style="font-size: 0.7rem; font-weight: 700; color: #16a34a;">AKTİF</span>
                            } else {
                                <span style="font-size: 0.7rem; font-weight: 700; color: #64748b;">PASİF</span>
                            }
                        </div>
                        <div style="font-size: 0.8rem; color: #64748b; margin-bottom: 8px;">
                            @o.ModelName - @o.Color
                        </div>
                        <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: #475569; font-weight: 600;">
                            <span>MÜŞTERİ: @o.Customer</span>
                            <span>ADET: @o.Quantity.ToString("N0")</span>
                        </div>
                        <div style="font-size: 0.75rem; color: #475569; font-weight: 600; margin-top: 4px;">
                            TARİH: @o.OrderDate.ToString("dd.MM.yyyy")
                        </div>
                    </a>
                }
            }
        </div>
    </div>

    <!-- Sağ İçerik: Planlama Detayı -->
    @if (Model != null && Model.Id > 0)
    {
        <div class="main-planning">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
            <div>
                <span style="font-size: 0.75rem; color: #64748b; font-weight: 600; text-transform: uppercase;">PLANLAMA DETAYI</span>
                <h2 style="margin: 4px 0 0 0; color: #0f172a;">@Model.OrderCode</h2>
            </div>
            <div style="display: flex; gap: 8px;">
                <button class="btn-planner" style="background: #16a34a; border-color: #16a34a;"><i class="fa-solid fa-file-excel"></i> Excel</button>
                <button class="btn-secondary"><i class="fa-solid fa-clock-rotate-left"></i> Geçmiş</button>
            </div>
        </div>

        @{
            var activeTab = TempData["ActiveTab"]?.ToString() ?? "numune";
        }

        <!-- Aşama Kartları -->
        <div class="plan-tabs">
            <div class="plan-tab @(activeTab == "numune" ? "active" : "")" onclick="switchTab('numune', this)">
                <i class="fa-solid fa-clipboard-check"></i>
                <div class="plan-tab-title">1. NUMUNE/TEST PLANLAMA</div>
                @if (Model.IsSampleTestCompleted) {
                    <div class="plan-tab-status status-complete">%100 TAMAM</div>
                } else {
                    <div class="plan-tab-status status-notstarted">BEKLİYOR</div>
                }
            </div>
            <div class="plan-tab @(activeTab == "satinalma" ? "active" : "")" onclick="switchTab('satinalma', this)">
                <i class="fa-solid fa-cart-shopping"></i>
                <div class="plan-tab-title">2. SATIN ALMA PLANLAMA</div>
                @if (Model.IsPurchasingCompleted) {
                    <div class="plan-tab-status status-complete">%100 TAMAM</div>
                } else {
                    <div class="plan-tab-status status-notstarted">BEKLİYOR</div>
                }
            </div>
            <div class="plan-tab @(activeTab == "uretim" ? "active" : "")" onclick="switchTab('uretim', this)">
                <i class="fa-solid fa-industry"></i>
                <div class="plan-tab-title">3. ÜRETİM PLANLAMA</div>
                @if (Model.IsProductionCompleted) {
                    <div class="plan-tab-status status-complete">%100 TAMAM</div>
                } else {
                    <div class="plan-tab-status status-notstarted">BEKLİYOR</div>
                }
            </div>
        </div>

        <!-- Sekme 1: Numune/Test -->
        <div id="tab-numune" class="tab-content @(activeTab == "numune" ? "active" : "")">
            <form action="/Planning/UpdateSampleTestPlan" method="post">
                <input type="hidden" name="Id" value="@Model.Id" />
                <h3 style="font-size: 1.1rem; margin-bottom: 16px; color: #1e293b;">Numune ve Test Planlama Detayları</h3>
                
                @{
                    var sampleData = new System.Collections.Generic.Dictionary<string, string>();
                    if (!string.IsNullOrEmpty(Model.SampleTestJson))
                    {
                        try {
                            sampleData = System.Text.Json.JsonSerializer.Deserialize<System.Collections.Generic.Dictionary<string, string>>(Model.SampleTestJson);
                        } catch {}
                    }
                    string GetSampleVal(string key) => sampleData.ContainsKey(key) ? sampleData[key] : "";
                }

                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px;">
                    <!-- Ana Kumaş Kartı -->
                    <div class="content-section">
                        <div class="section-title">
                            <i class="fa-solid fa-layer-group"></i> Ana Kumaş
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 16px;">
                            <div>
                                <div class="data-label">NUMUNE KUMAŞ Y-TESTİ</div>
                                <input type="date" name="sample_kumas_ytesti" class="input-field" value="@GetSampleVal("sample_kumas_ytesti")" />
                            </div>
                            <div>
                                <div class="data-label">K-TUŞE RENK ONAYI test vr tarihi</div>
                                <input type="date" name="sample_tuse_renk" class="input-field" value="@GetSampleVal("sample_tuse_renk")" />
                            </div>
                            <div>
                                <div class="data-label">KUMAŞ KARIŞIMI</div>
                                <input type="text" name="sample_kumas_karisim" class="input-field" placeholder="Örn: %80 Pamuk %20 Polyester" value="@GetSampleVal("sample_kumas_karisim")" />
                            </div>
                        </div>
                    </div>

                    <!-- Düğme Kartı -->
                    <div class="content-section">
                        <div class="section-title">
                            <i class="fa-solid fa-circle-dot"></i> Düğme
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 16px;">
                            <div>
                                <div class="data-label">DÜĞME RENK KALİTE ONAY</div>
                                <input type="date" name="sample_dugme_renk" class="input-field" value="@GetSampleVal("sample_dugme_renk")" />
                            </div>
                            <div>
                                <div class="data-label">DÜĞME TESTİ</div>
                                <input type="date" name="sample_dugme_test" class="input-field" value="@GetSampleVal("sample_dugme_test")" />
                            </div>
                        </div>
                    </div>

                    <!-- FIT / PPS Numunesi Kartı -->
                    <div class="content-section">
                        <div class="section-title">
                            <i class="fa-solid fa-shirt"></i> FIT / PPS Numunesi
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 16px;">
                            <div>
                                <div class="data-label">PP ONAY (Üretim öncesi en kritik onay)</div>
                                <input type="date" name="sample_pp_onay" class="input-field" value="@GetSampleVal("sample_pp_onay")" />
                            </div>
                        </div>
                    </div>
                </div>
                
                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 20px;">
                    <label style="display: flex; align-items: center; gap: 8px; font-weight: 600; color: #0f172a;">
                        <input type="checkbox" name="IsSampleTestCompleted" value="true" @(Model.IsSampleTestCompleted ? "checked" : "") /> 
                        <span style="color: #16a34a;"><i class="fa-solid fa-check-circle"></i> Numune Aşaması Tamamlandı</span>
                    </label>
                    <button type="submit" class="btn-planner" style="background: var(--primary-color); color: white; border: none; padding: 10px 24px; border-radius: 6px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px;"><i class="fa-solid fa-save"></i> Numune/Test Planını Kaydet</button>
                </div>
            </form>
        </div>

        <!-- Sekme 2: Satın Alma (MRP) -->
        <div id="tab-satinalma" class="tab-content @(activeTab == "satinalma" ? "active" : "")">
            <form id="purchasing-form" action="/Planning/UpdatePurchasingPlan" method="post">
                <input type="hidden" name="Id" value="@Model.Id" />
                <input type="hidden" name="pur_has_missing_materials" id="pur_has_missing_materials" value="false" />
                <h3 style="font-size: 1.1rem; margin-bottom: 16px; color: #1e293b;">Kumaş ve Aksesuar Planlaması (MRP) <span style="font-size: 0.85rem; color: #64748b; font-weight: normal;">Kumaş ve aksesuar stok durumu ve hesaplamaları</span></h3>
            
            @{
                var purData = new System.Collections.Generic.Dictionary<string, string>();
                if (!string.IsNullOrEmpty(Model.PurchasingMaterialsJson))
                {
                    try {
                        purData = System.Text.Json.JsonSerializer.Deserialize<System.Collections.Generic.Dictionary<string, string>>(Model.PurchasingMaterialsJson);
                    } catch {}
                }
                string GetPurVal(string key, string def = "") => purData.ContainsKey(key) ? purData[key] : def;
            }

            <input type="hidden" name="ActualFabricMeterage" value="@Model.ActualFabricMeterage" />
            <input type="hidden" name="ActualFabricQty" value="@Model.ActualFabricQty" />
            <input type="hidden" name="AccessoryCompletionDate" value="@(Model.AccessoryCompletionDate?.ToString("yyyy-MM-dd"))" />
            <input type="hidden" name="PurchasingMaterialsJson" id="PurchasingMaterialsJson" value="@Model.PurchasingMaterialsJson" />

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                <!-- Ana Kumaş Kartı -->
                <div class="content-section" style="margin-bottom: 0;">
                    <div class="section-title">
                        <i class="fa-solid fa-layer-group"></i> Kumaş Metraj Hesabı
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                        <div style="grid-column: span 2;">
                            <div class="data-label">KUMAŞ TEDARİKÇİSİ</div>
                            <select name="FabricSupplier" class="input-field">
                                <option value="">-- Kumaşçı Seçin --</option>
                                @if (ViewBag.Fabricators != null)
                                {
                                    foreach (var f in (System.Collections.Generic.List<UretimPlanlama.Models.Fabricator>)ViewBag.Fabricators)
                                    {
                                        if (Model.FabricSupplier == f.Name)
                                        {
                                            <option value="@f.Name" selected>@f.Name</option>
                                        }
                                        else
                                        {
                                            <option value="@f.Name">@f.Name</option>
                                        }
                                    }
                                }
                            </select>
                        </div>
                        <div>
                            <div class="data-label">SEVK ANLAŞILAN</div>
                            <input type="date" name="FabricArrivalAgreedDate" class="input-field" value="@(Model.FabricArrivalAgreedDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div>
                            <div class="data-label">GELİŞ TARİHİ</div>
                            <input type="date" name="FabricArrivalActualDate" class="input-field" value="@(Model.FabricArrivalActualDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div style="grid-column: span 2; background: #fffbeb; padding: 10px; border-radius: 6px; border: 1px solid #fde68a;">
                            <div class="data-label" style="color: #b45309;">SİPARİŞ ADETİ</div>
                            <input type="text" name="pur_siparis_adeti" id="mrp_siparis_adeti" class="input-field mrp-input" value="@GetPurVal("pur_siparis_adeti", Model.Quantity.ToString())" />
                        </div>
                        <div style="grid-column: span 2; margin-top: 10px;">
                            <table class="table-details" style="margin-top:0;">
                                <thead>
                                    <tr>
                                        <th>CİNSİ</th>
                                        <th>MİKTAR</th>
                                        <th>METRAJ</th>
                                        <th>ÇIKACAK / AD</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr style="background-color: #e0e7ff;">
                                        <td style="font-weight: bold;">BEDEN İÇİN-</td>
                                        <td><input type="text" name="pur_beden_miktar" id="mrp_beden_miktar" class="input-field mrp-input" value="@GetPurVal("pur_beden_miktar", "0")" style="width: 100%; max-width: 120px; padding: 4px;"/></td>
                                        <td><input type="text" name="pur_beden_metraj" id="mrp_beden_metraj" class="input-field mrp-input" value="@GetPurVal("pur_beden_metraj", "1")" style="width: 100%; max-width: 120px; padding: 4px;"/></td>
                                        <td style="font-weight: bold; text-align: right; color: #1e40af; font-size: 1.1rem;" id="mrp_beden_cikacak">0</td>
                                    </tr>
                                    <tr style="background-color: #fef08a;">
                                        <td style="font-weight: bold;">İSTENEN KUMAŞ</td>
                                        <td style="font-weight: bold; text-align: right; color: #b45309; padding-right: 16px;" id="mrp_istenen_kumas_miktar">0</td>
                                        <td><input type="text" name="pur_istenen_metraj" id="mrp_istenen_metraj" class="input-field mrp-input" value="@GetPurVal("pur_istenen_metraj", "1")" style="width: 100%; max-width: 120px; padding: 4px;"/></td>
                                        <td style="font-weight: bold; text-align: right; color: #b45309; font-size: 1.1rem;" id="mrp_istenen_kumas_cikacak">0</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Aksesuar Tarihleri Kartı -->
                <div class="content-section" style="margin-bottom: 0;">
                    <div class="section-title">
                        <i class="fa-solid fa-calendar-days"></i> Aksesuar Geliş Tarihleri
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                        <div>
                            <div class="data-label">DÜĞME-GELİŞİ</div>
                            <input type="date" name="pur_dugme_gelisi" class="input-field" value="@GetPurVal("pur_dugme_gelisi")" />
                        </div>
                        <div>
                            <div class="data-label">DÜĞME DİKİŞ İPİ</div>
                            <input type="date" name="pur_dugme_dikis_ipi" class="input-field" value="@GetPurVal("pur_dugme_dikis_ipi")" />
                        </div>
                        <div>
                            <div class="data-label">ETİKET-GELİŞİ</div>
                            <input type="date" name="pur_etiket_gelisi" class="input-field" value="@GetPurVal("pur_etiket_gelisi")" />
                        </div>
                        <div>
                            <div class="data-label">YIK-TALİMAT-GELİŞİ</div>
                            <input type="date" name="pur_yik_talimat_gelisi" class="input-field" value="@GetPurVal("pur_yik_talimat_gelisi")" />
                        </div>
                        <div>
                            <div class="data-label">FİYAT KART-GELİŞİ</div>
                            <input type="date" name="pur_fiyat_kart_gelisi" class="input-field" value="@GetPurVal("pur_fiyat_kart_gelisi")" />
                        </div>
                        <div>
                            <div class="data-label">YK-İÇ GELİŞİ</div>
                            <input type="date" name="pur_yk_ic_gelisi" class="input-field" value="@GetPurVal("pur_yk_ic_gelisi")" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Malzeme İhtiyaç Tablosu -->
            <div class="content-section" style="padding: 0; overflow-x: auto;">
                <div class="section-title" style="padding: 16px 16px 0 16px;">
                    <i class="fa-solid fa-table-list"></i> Malzeme İhtiyaç Tablosu
                </div>
                <table class="table-details" id="mrp-table">
                    <thead>
                        <tr>
                            <th>CİNSİ</th>
                            <th style="width: 100px;">İŞ ADETİ</th>
                            <th style="width: 80px;">BİRİM</th>
                            <th style="width: 100px;">TOPLAM</th>
                            <th style="width: 60px;">%</th>
                            <th style="width: 80px; background:#e2e8f0;">% FAZLA</th>
                            <th style="width: 100px; background:#fef08a;">İSTENEN</th>
                            <th style="width: 100px; background:#bbf7d0;">GELEN</th>
                            <th style="width: 100px; background:#fef08a;">ARTI / EKSİ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var materials = new List<dynamic>();
                            var interlinings = new List<dynamic>();

                            if (Model.LargeButtonCount.HasValue && Model.LargeButtonCount > 0)
                                materials.Add(new { Name = "Büyük Düğme", DefaultUnit = Model.LargeButtonCount.Value.ToString(), Key = "buyuk_dugme" });

                            if (Model.SmallButtonCount.HasValue && Model.SmallButtonCount > 0)
                                materials.Add(new { Name = "Küçük Düğme", DefaultUnit = Model.SmallButtonCount.Value.ToString(), Key = "kucuk_dugme" });

                            if (Model.HasPriceCard)
                                materials.Add(new { Name = "Fiyat Kartı", DefaultUnit = "1", Key = "fiyat_karti" });

                            if (Model.HasWashingInstruction)
                                materials.Add(new { Name = "Yıkama Talimatı", DefaultUnit = "1", Key = "yikama_talimat" });

                            if (Model.HasInnerBarcode)
                                materials.Add(new { Name = "İç Barkod", DefaultUnit = "1", Key = "ic_barkod" });

                            if (Model.HasYokeLabel)
                                materials.Add(new { Name = "Roba Etiketi", DefaultUnit = "1", Key = "roba_etiket" });

                            if (Model.HasFifLabel)
                                materials.Add(new { Name = "Fif Etiketi", DefaultUnit = "1", Key = "fif_etiket" });

                            if (Model.HasOtherCard)
                                materials.Add(new { Name = "Diğer Kart", DefaultUnit = "1", Key = "diger_kart" });

                            // Telaları ayırıyoruz
                            if (Model.CollarInterliningMeterage.HasValue && Model.CollarInterliningMeterage > 0)
                                interlinings.Add(new { Name = "Yaka Telası", DefaultUnit = Model.CollarInterliningMeterage.Value.ToString("0.###").Replace(",", "."), Key = "yaka_tela" });

                            if (Model.CuffInterliningMeterage.HasValue && Model.CuffInterliningMeterage > 0)
                                interlinings.Add(new { Name = "Manşet Telası", DefaultUnit = Model.CuffInterliningMeterage.Value.ToString("0.###").Replace(",", "."), Key = "manset_tela" });

                            if (Model.PlacketInterliningMeterage.HasValue && Model.PlacketInterliningMeterage > 0)
                                interlinings.Add(new { Name = "Pat Telası", DefaultUnit = Model.PlacketInterliningMeterage.Value.ToString("0.###").Replace(",", "."), Key = "pat_tela" });

                            if (!materials.Any())
                            {
                                <tr>
                                    <td colspan="9" style="text-align: center; color: #64748b; padding: 20px;">Model detayında seçilmiş herhangi bir aksesuar bulunmamaktadır.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in materials)
                                {
                                    string unitVal = GetPurVal($"pur_birim_{item.Key}", item.DefaultUnit);
                                    string fireVal = GetPurVal($"pur_fire_{item.Key}", "0");
                                    string gelenVal = GetPurVal($"pur_gelen_{item.Key}", "0");

                                    <tr class="mrp-row">
                                        <td style="font-weight: 600;">@item.Name</td>
                                        <td class="row-is-adeti" style="text-align: right; color: #64748b; font-weight: 600;">0</td>
                                        <td><input type="text" name="pur_birim_@item.Key" class="input-field mrp-input row-birim" value="@unitVal" style="width: 100%; padding: 4px;" /></td>
                                        <td class="row-toplam" style="text-align: right; font-weight: 600; color: #0f172a;">0</td>
                                        <td><input type="text" name="pur_fire_@item.Key" class="input-field mrp-input row-fire" value="@fireVal" style="width: 100%; padding: 4px;" /></td>
                                        <td class="row-fazla" style="text-align: right; background:#e2e8f0; color: #0f172a; font-weight: 600;">0</td>
                                        <td class="row-istenen" style="text-align: right; font-weight: 700; color: #b45309; background:#fef08a;">0</td>
                                        <td style="background:#bbf7d0; padding: 4px;"><input type="text" name="pur_gelen_@item.Key" class="input-field mrp-input row-gelen" value="@gelenVal" style="width: 100%; padding: 4px; border-color: #4ade80;" /></td>
                                        <td class="row-arti-eksi" style="text-align: right; font-weight: 700; background:#fef08a;">0</td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Astar Tela İhtiyaç Tablosu -->
            <div class="content-section" style="padding: 0; overflow-x: auto; margin-top: 16px;">
                <div class="section-title" style="padding: 16px 16px 0 16px;">
                    <i class="fa-solid fa-layer-group"></i> Astar Tela İhtiyacı
                </div>
                <table class="table-details" id="interlining-table">
                    <thead>
                        <tr>
                            <th>CİNSİ</th>
                            <th style="width: 100px;">İŞ MİKTARI</th>
                            <th style="width: 80px;">BİRİM</th>
                            <th style="width: 100px; background:#fef08a;">İHTİYAÇ</th>
                            <th style="width: 100px;">TELA (METRE)</th>
                            <th style="width: 100px;">ADET</th>
                            <th style="width: 100px;">METRAJ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            if (!interlinings.Any())
                            {
                                <tr>
                                    <td colspan="7" style="text-align: center; color: #64748b; padding: 20px;">Model detayında seçilmiş herhangi bir tela bulunmamaktadır.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in interlinings)
                                {
                                    string unitVal = GetPurVal($"pur_tela_birim_{item.Key}", item.DefaultUnit);
                                    string metreVal = GetPurVal($"pur_tela_metre_{item.Key}", "0");
                                    string adetVal = GetPurVal($"pur_tela_adet_{item.Key}", "0");
                                    string metrajVal = GetPurVal($"pur_tela_metraj_{item.Key}", "0");

                                    <tr class="interlining-row">
                                        <td style="font-weight: 600;">@item.Name</td>
                                        <td class="row-is-miktari" style="text-align: right; color: #64748b; font-weight: 600;">0</td>
                                        <td><input type="text" name="pur_tela_birim_@item.Key" class="input-field interlining-input row-tela-birim" value="@unitVal" style="width: 100%; padding: 4px;" /></td>
                                        <td class="row-ihtiyac" style="text-align: right; font-weight: 700; color: #b45309; background:#fef08a;">0</td>
                                        <td><input type="text" name="pur_tela_metre_@item.Key" class="input-field" value="@metreVal" style="width: 100%; padding: 4px;" /></td>
                                        <td><input type="text" name="pur_tela_adet_@item.Key" class="input-field" value="@adetVal" style="width: 100%; padding: 4px;" /></td>
                                        <td><input type="text" name="pur_tela_metraj_@item.Key" class="input-field" value="@metrajVal" style="width: 100%; padding: 4px;" /></td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
            
            <div style="display: flex; justify-content: space-between; margin-top: 20px; align-items: center;">
                <label style="display: flex; align-items: center; gap: 8px; font-weight: 600; color: #0f172a;">
                    <input type="checkbox" name="IsPurchasingCompleted" value="true" @(Model.IsPurchasingCompleted ? "checked" : "") /> 
                    <span style="color: #16a34a;"><i class="fa-solid fa-check-circle"></i> Satın Alma Aşaması Tamamlandı</span>
                </label>
                <button type="submit" class="btn-planner" style="background: #1d4ed8; color: white; border: none; padding: 10px 24px; border-radius: 6px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px;"><i class="fa-solid fa-save"></i> Satın Alma Planını Kaydet</button>
            </div>
            </form>
        </div>

        <!-- Sekme 3: Üretim -->
        <div id="tab-uretim" class="tab-content @(activeTab == "uretim" ? "active" : "")">
            <form action="/Planning/UpdateProductionPlan" method="post">
                <input type="hidden" name="Id" value="@Model.Id" />
                <h3 style="font-size: 1.1rem; margin-bottom: 16px; color: #1e293b;">Üretim Planlama Detayları</h3>
                
                @{
                    var prodData = new System.Collections.Generic.Dictionary<string, string>();
                    if (!string.IsNullOrEmpty(Model.ProductionJson))
                    {
                        try {
                            prodData = System.Text.Json.JsonSerializer.Deserialize<System.Collections.Generic.Dictionary<string, string>>(Model.ProductionJson);
                        } catch {}
                    }
                    string GetProdVal(string key) => prodData.ContainsKey(key) ? prodData[key] : "";
                }

                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px;">
                    <!-- Kesim ve Dikim Kartı -->
                    <div class="content-section">
                        <div class="section-title">
                            <i class="fa-solid fa-scissors"></i> Kesim ve Dikim
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 16px;">
                            <div>
                                <div class="data-label">DİKİM ATÖLYESİ</div>
                                <select name="prod_dikim_atolyesi" class="input-field">
                                    <option value="">-- Atölye Seçin --</option>
                                    @if (ViewBag.Workshops != null)
                                    {
                                        var prodDikim = GetProdVal("prod_dikim_atolyesi");
                                        foreach (var w in (System.Collections.Generic.List<UretimPlanlama.Models.Workshop>)ViewBag.Workshops)
                                        {
                                            if (prodDikim == w.Name)
                                            {
                                                <option value="@w.Name" selected>@w.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@w.Name">@w.Name</option>
                                            }
                                        }
                                    }
                                </select>
                            </div>
                            <div>
                                <div class="data-label">KESİM BAŞLANGIÇ</div>
                                <input type="date" name="prod_kesim_baslangic" class="input-field" value="@GetProdVal("prod_kesim_baslangic")" />
                            </div>
                            <div>
                                <div class="data-label">KESİM BİTİŞ</div>
                                <input type="date" name="prod_kesim_bitis" class="input-field" value="@GetProdVal("prod_kesim_bitis")" />
                            </div>
                            <div>
                                <div class="data-label">KESİM MİKTARI</div>
                                <input type="number" name="prod_kesim_miktari" class="input-field" value="@GetProdVal("prod_kesim_miktari")" placeholder="Örn: 1000" />
                            </div>
                            <div>
                                <div class="data-label">DİKİM BAŞLANGIÇ</div>
                                <input type="date" name="prod_dikim_baslangic" class="input-field" value="@GetProdVal("prod_dikim_baslangic")" />
                            </div>
                            <div>
                                <div class="data-label">DİKİM BİTİŞ</div>
                                <input type="date" name="prod_dikim_bitis" class="input-field" value="@GetProdVal("prod_dikim_bitis")" />
                            </div>
                        </div>
                    </div>

                    <!-- Paket ve Lojistik Kartı -->
                    <div class="content-section">
                        <div class="section-title">
                            <i class="fa-solid fa-box-open"></i> Paket ve Lojistik
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 16px;">
                            <div>
                                <div class="data-label">PAKET BAŞLANGIÇ</div>
                                <input type="date" name="prod_paket_baslangic" class="input-field" value="@GetProdVal("prod_paket_baslangic")" />
                            </div>
                            <div>
                                <div class="data-label">PAKET BİTİŞ</div>
                                <input type="date" name="prod_paket_bitis" class="input-field" value="@GetProdVal("prod_paket_bitis")" />
                            </div>
                            <div>
                                <div class="data-label">GS GİDİŞİ</div>
                                <input type="date" name="prod_gs_gidisi" class="input-field" value="@GetProdVal("prod_gs_gidisi")" />
                            </div>
                            <div>
                                <div class="data-label">YOLA ÇIKIŞ</div>
                                <input type="date" name="prod_yola_cikis" class="input-field" value="@GetProdVal("prod_yola_cikis")" />
                            </div>
                            <div>
                                <div class="data-label">DEPO VARIŞ</div>
                                <input type="date" name="prod_depo_varis" class="input-field" value="@GetProdVal("prod_depo_varis")" />
                            </div>
                        </div>
                    </div>

                    <!-- Termin Kartı -->
                    <div class="content-section">
                        <div class="section-title">
                            <i class="fa-solid fa-calendar-check"></i> Termin Bilgileri
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 16px;">
                            <div>
                                <div class="data-label">Termin Tarihi</div>
                                @{
                                    var suAnkiTermin = GetProdVal("prod_suanki_termin");
                                    if (string.IsNullOrEmpty(suAnkiTermin) && Model.PlannedPackagingEndDate.HasValue)
                                    {
                                        suAnkiTermin = Model.PlannedPackagingEndDate.Value.ToString("yyyy-MM-dd");
                                    }
                                }
                                <input type="date" name="prod_suanki_termin" class="input-field" value="@suAnkiTermin" />
                            </div>
                            <div>
                                <div class="data-label">KNN REVİZE TERMİN</div>
                                <input type="date" name="prod_knn_revize_termin" class="input-field" value="@GetProdVal("prod_knn_revize_termin")" />
                            </div>
                        </div>
                    </div>
                </div>

                <div style="display: flex; justify-content: space-between; margin-top: 20px; align-items: center;">
                    <label style="display: flex; align-items: center; gap: 8px; font-weight: 600; color: #0f172a;">
                        <input type="checkbox" name="IsProductionCompleted" value="true" @(Model.IsProductionCompleted ? "checked" : "") /> 
                        <span style="color: #16a34a;"><i class="fa-solid fa-check-circle"></i> Üretim Aşaması Tamamlandı</span>
                    </label>
                    <button type="submit" class="btn-planner" style="background: #1d4ed8; color: white; border: none; padding: 10px 24px; border-radius: 6px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px;"><i class="fa-solid fa-save"></i> Üretim Planını Kaydet</button>
                </div>
            </form>
        </div>

        </div>
    }
    else
    {
        <div class="main-planning" style="display: flex; justify-content: center; align-items: center; min-height: 400px;">
            <div style="text-align: center; color: #64748b;">
                <i class="fa-solid fa-hand-pointer" style="font-size: 3rem; margin-bottom: 16px; color: #cbd5e1;"></i>
                <h3>Planlama Detayı İçin Sipariş Seçin</h3>
                <p>Sol taraftaki listeden planlamasını görmek istediğiniz siparişi seçiniz.</p>
            </div>
        </div>
    }
</div>

<script>
    function switchTab(tabId, element) {
        // Tüm sekmeleri inaktif yap
        document.querySelectorAll('.plan-tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
        
        // Seçileni aktif yap
        element.classList.add('active');
        document.getElementById('tab-' + tabId).classList.add('active');
    }

    // Sipariş arama ve filtreleme
    function filterOrders() {
        var searchValue = document.getElementById('orderSearch').value.toLowerCase();
        var showAll = document.getElementById('showAllOrders').checked;
        var items = document.querySelectorAll('.order-list-item');
        
        items.forEach(function(item) {
            var text = item.textContent.toLowerCase();
            var isActive = item.getAttribute('data-active') === 'true';
            var matchesSearch = text.includes(searchValue);
            var matchesFilter = showAll || isActive;
            
            item.style.display = (matchesSearch && matchesFilter) ? 'block' : 'none';
        });
    }

    document.getElementById('orderSearch').addEventListener('keyup', filterOrders);
    document.getElementById('showAllOrders').addEventListener('change', filterOrders);

    // Yardımcı Fonksiyon: Sayı çevirici (11.800,25 gibi Türkçe formatları destekler)
    function parseTurkishFloat(str) {
        if (!str) return 0;
        // Eğer içinde hem nokta hem virgül varsa (örn: 11.800,25) -> noktaları sil, virgülü noktaya çevir
        // Eğer sadece nokta varsa ve ondalık kısımsa veya binlik kısımsa -> duruma göre ele almak lazım.
        // Güvenli yöntem: Tüm noktaları sil, sadece virgülü ondalık olarak kabul et. (11.800 -> 11800)
        // Ancak kullanıcı bazen İngilizce formatta "11.8" girebilir.
        // Şöyle yapalım: Son ayırıcıyı bulalım.
        var s = str.trim();
        if(s === "") return 0;
        
        // Eğer string'de virgül varsa, noktaları binlik ayracı sayıp silelim, virgülü ondalık yapalım.
        if (s.indexOf(',') > -1) {
            s = s.replace(/\./g, '').replace(',', '.');
        } else {
            // Eğer string'de nokta varsa ve birden fazlaysa veya 3 haneden sonraysa, bunu binlik yap.
            // En iyisi Excel mantığı: Virgül ondalıktır. Nokta varsa binlik ayracıdır.
            // Ama kullanıcı ondalık için nokta kullanıyorsa? (Örn 1.23)
            // Noktadan sonra 2 hane veya 1 hane varsa genelde ondalıktır.
            // Biz basitçe virgülü ondalık nokta yapalım. Noktaları silelim.
            // Ancak kullanıcı "1.23" yazarsa bu 123 olur! 
            // O yüzden nokta varsa ve virgül yoksa, noktanın sonuncu olduğu duruma bakalım.
            var lastDot = s.lastIndexOf('.');
            if (lastDot > -1 && s.length - lastDot <= 3) {
                // Muhtemelen ondalık noktası
            } else {
                // Binlik ayracı
                s = s.replace(/\./g, '');
            }
        }
        return parseFloat(s) || 0;
    }

    // MRP Hesaplamaları
    function calculateMRP() {
        // Beden İçin Çıkacak İş Adeti
        var bedenMiktarStr = document.getElementById('mrp_beden_miktar')?.value || "0";
        var bedenMetrajStr = document.getElementById('mrp_beden_metraj')?.value || "1";
        
        var bedenMiktar = parseTurkishFloat(bedenMiktarStr);
        var bedenMetraj = parseTurkishFloat(bedenMetrajStr);
        if(bedenMetraj === 0) bedenMetraj = 1;
        
        var bedenCikacak = Math.floor(bedenMiktar / bedenMetraj);
        
        var bedenCikacakEl = document.getElementById('mrp_beden_cikacak');
        if(bedenCikacakEl) bedenCikacakEl.innerText = bedenCikacak.toLocaleString('tr-TR');

        // İstenen Kumaş Miktarı ve Çıkacak
        var siparisAdetiStr = document.getElementById('mrp_siparis_adeti')?.value || "0";
        var siparisAdeti = parseInt(parseTurkishFloat(siparisAdetiStr)) || 0;
        
        var istenenMetrajStr = document.getElementById('mrp_istenen_metraj')?.value || "1";
        var istenenMetraj = parseTurkishFloat(istenenMetrajStr);
        if(istenenMetraj === 0) istenenMetraj = 1;

        var istenenMiktar = siparisAdeti * istenenMetraj;
        var istenenMiktarEl = document.getElementById('mrp_istenen_kumas_miktar');
        if(istenenMiktarEl) istenenMiktarEl.innerText = istenenMiktar.toLocaleString('tr-TR', {minimumFractionDigits: 2, maximumFractionDigits: 2});

        // İstenen kumaş çıkacak adeti her zaman siparisAdeti'dir
        var istenenCikacakEl = document.getElementById('mrp_istenen_kumas_cikacak');
        if(istenenCikacakEl) istenenCikacakEl.innerText = siparisAdeti.toLocaleString('tr-TR');

        // Tablo hesaplamalarında kullanılacak genel "İş Adeti", Beden İçin çıkacak adettir.
        var jobQty = bedenCikacak;

        var hasMissing = false;

        // Tablo Satırları Hesaplamaları
        document.querySelectorAll('.mrp-row').forEach(function(row) {
            var birimInput = row.querySelector('.row-birim');
            var isAdetiEl = row.querySelector('.row-is-adeti');
            var toplamEl = row.querySelector('.row-toplam');
            var fireInput = row.querySelector('.row-fire');
            var fazlaEl = row.querySelector('.row-fazla');
            var istenenEl = row.querySelector('.row-istenen');
            var gelenInput = row.querySelector('.row-gelen');
            var artiEksiEl = row.querySelector('.row-arti-eksi');

            var birim = parseTurkishFloat(birimInput?.value || "0");
            var fire = parseTurkishFloat(fireInput?.value || "0");
            var gelen = parseTurkishFloat(gelenInput?.value || "0");

            // İş Adeti (Ana kumaştan hesaplanan)
            if(isAdetiEl) isAdetiEl.innerText = jobQty.toLocaleString('tr-TR');

            // Toplam
            var toplam = jobQty * birim;
            if(toplamEl) toplamEl.innerText = Math.round(toplam).toLocaleString('tr-TR');

            // % Fazla
            var fazla = Math.round(toplam * (fire / 100));
            if(fazlaEl) fazlaEl.innerText = fazla.toLocaleString('tr-TR');

            // İstenen = Toplam + Fazla
            var istenen = Math.round(toplam + fazla);
            if(istenenEl) istenenEl.innerText = istenen.toLocaleString('tr-TR');

            // Artı/Eksi
            var artiEksi = gelen - istenen;
            if(artiEksi < 0) hasMissing = true;

            if(artiEksiEl) {
                artiEksiEl.innerText = Math.round(artiEksi).toLocaleString('tr-TR');
                if(artiEksi < 0) {
                    artiEksiEl.style.color = '#dc2626'; // Kırmızı
                } else if (artiEksi > 0) {
                    artiEksiEl.style.color = '#16a34a'; // Yeşil
                } else {
                    artiEksiEl.style.color = '#0f172a'; // Siyah
                }
            }
        });

        // Astar Tela İhtiyacı Hesaplamaları
        document.querySelectorAll('.interlining-row').forEach(function(row) {
            var isMiktariEl = row.querySelector('.row-is-miktari');
            var birimInput = row.querySelector('.row-tela-birim');
            var ihtiyacEl = row.querySelector('.row-ihtiyac');

            var birim = parseTurkishFloat(birimInput?.value || "0");

            // İş Miktarı (Ana kumaştan hesaplanan)
            if(isMiktariEl) isMiktariEl.innerText = jobQty.toLocaleString('tr-TR');

            // İhtiyaç = İş Miktarı * Birim
            var ihtiyac = Math.round(jobQty * birim);
            if(ihtiyacEl) ihtiyacEl.innerText = ihtiyac.toLocaleString('tr-TR');
        });

        var missingInput = document.getElementById('pur_has_missing_materials');
        if(missingInput) missingInput.value = hasMissing ? "true" : "false";
    }

    document.querySelectorAll('.mrp-input').forEach(function(input) {
        input.addEventListener('input', calculateMRP);
    });

    document.querySelectorAll('.interlining-input').forEach(function(input) {
        input.addEventListener('input', calculateMRP);
    });

    document.addEventListener('DOMContentLoaded', function() {
        calculateMRP();

        var purForm = document.getElementById('purchasing-form');
        if(purForm) {
            purForm.addEventListener('submit', function(e) {
                var hasMissing = document.getElementById('pur_has_missing_materials').value === "true";
                var isCompleted = document.querySelector('input[name="IsPurchasingCompleted"]').checked;
                
                if (hasMissing && isCompleted) {
                    var result = confirm("Dikkat: Bu siparişte eksik malzemeler bulunmaktadır (kırmızı değerler). Yine de Satın Alma aşamasını tamamlanmış olarak işaretlemek istiyor musunuz? (Eksikler takip listesine eklenecektir)");
                    if (!result) {
                        e.preventDefault();
                    }
                }
            });
        }
    });
</script>
