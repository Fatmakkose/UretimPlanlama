@model UretimPlanlama.Controllers.ReportsViewModel
@{
    ViewData["Title"] = "Raporlama ve Analiz";
}

<style>
    /* Raporlama Sayfası Özel Stilleri */
    .filter-section {
        background: white;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 25px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
    }

    .filter-form {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        align-items: flex-end;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
        flex: 1;
        min-width: 200px;
    }

    .filter-group label {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .filter-control {
        padding: 10px 14px;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        font-size: 0.9rem;
        color: var(--text-main);
        outline: none;
        transition: all 0.2s;
        background-color: #f8fafc;
    }

    .filter-control:focus {
        border-color: var(--primary-color);
        background-color: white;
        box-shadow: 0 0 0 3px rgba(0, 71, 187, 0.1);
    }

    .stat-cards-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
        margin-bottom: 25px;
    }

    .report-stat-card {
        background: white;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 24px;
        display: flex;
        align-items: center;
        gap: 20px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
        transition: transform 0.2s;
    }

    .report-stat-card:hover {
        transform: translateY(-2px);
    }

    .report-stat-icon {
        width: 54px;
        height: 54px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        flex-shrink: 0;
    }

    .report-stat-info {
        display: flex;
        flex-direction: column;
    }

    .report-stat-label {
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .report-stat-value {
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--text-main);
        margin-top: 4px;
        line-height: 1.2;
    }

    .charts-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
        gap: 24px;
        margin-bottom: 25px;
    }

    .chart-card {
        background: white;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
        display: flex;
        flex-direction: column;
        align-items: center;
        min-height: 340px;
    }

    .chart-card h3 {
        font-size: 1.05rem;
        font-weight: 700;
        margin: 0 0 20px 0;
        color: var(--text-main);
        align-self: flex-start;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .chart-canvas-container {
        position: relative;
        width: 100%;
        height: 250px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    /* Boş veri ekranı */
    .empty-reports-state {
        grid-column: 1 / -1;
        background: white;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 60px 20px;
        text-align: center;
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
    }
</style>

<div class="dashboard-header" style="margin-bottom: 20px;">
    <div class="header-title">
        <h1 style="font-size: 1.8rem; margin: 0; color: var(--text-main);">Raporlama ve Analiz</h1>
    </div>
</div>

<!-- Filtreler Paneli -->
<div class="filter-section">
    <form method="get" action="/Reports" class="filter-form">
        <div class="filter-group">
            <label><i class="fa-regular fa-calendar"></i> Başlangıç Tarihi</label>
            <input type="date" name="startDate" class="filter-control" value="@ViewBag.StartDate" />
        </div>
        <div class="filter-group">
            <label><i class="fa-regular fa-calendar"></i> Bitiş Tarihi</label>
            <input type="date" name="endDate" class="filter-control" value="@ViewBag.EndDate" />
        </div>
        <div style="display: flex; gap: 12px;">
            <button type="submit" class="btn-planner" style="padding: 10px 24px; border-radius: 8px; height: 42px;">
                <i class="fa-solid fa-filter"></i> Filtrele
            </button>
            <a href="/Reports/ExportOrdersReport?startDate=@ViewBag.StartDate&endDate=@ViewBag.EndDate" class="btn-secondary" style="padding: 10px 24px; border-radius: 8px; height: 42px; display: inline-flex; align-items: center; gap: 8px; text-decoration: none; font-weight: 600;">
                <i class="fa-solid fa-file-excel" style="color: #16a34a;"></i> Excel Raporu Al
            </a>
        </div>
    </form>
</div>

@if (Model.TotalOrdersCount == 0)
{
    <div class="empty-reports-state">
        <i class="fa-solid fa-chart-pie" style="font-size: 4rem; color: var(--text-muted); opacity: 0.3; margin-bottom: 15px;"></i>
        <h3 style="margin: 0; font-size: 1.2rem; color: var(--text-main);">Seçilen Tarih Aralığında Veri Bulunamadı</h3>
        <p style="color: var(--text-muted); margin-top: 6px; font-size: 0.95rem;">Lütfen başka bir tarih aralığı filtreleyerek yeniden deneyin.</p>
    </div>
}
else
{
    <!-- İstatistik Kartları -->
    <div class="stat-cards-row">
        <div class="report-stat-card">
            <div class="report-stat-icon" style="background: #e0f2fe; color: #0284c7;">
                <i class="fa-solid fa-clipboard-list"></i>
            </div>
            <div class="report-stat-info">
                <span class="report-stat-label">Toplam Sipariş</span>
                <span class="report-stat-value">@Model.TotalOrdersCount.ToString("N0") <span style="font-size: 0.9rem; font-weight: 500; color: var(--text-muted);">Adet</span></span>
            </div>
        </div>
        <div class="report-stat-card">
            <div class="report-stat-icon" style="background: #ecfdf5; color: #16a34a;">
                <i class="fa-solid fa-shirt"></i>
            </div>
            <div class="report-stat-info">
                <span class="report-stat-label">Toplam Üretim Adedi</span>
                <span class="report-stat-value">@Model.TotalOrderQuantity.ToString("N0") <span style="font-size: 0.9rem; font-weight: 500; color: var(--text-muted);">Adet</span></span>
            </div>
        </div>
        <div class="report-stat-card">
            <div class="report-stat-icon" style="background: #fef2f2; color: #dc2626;">
                <i class="fa-solid fa-coins"></i>
            </div>
            <div class="report-stat-info">
                <span class="report-stat-label">Toplam Tutar</span>
                <span class="report-stat-value">@Model.TotalAmount.ToString("C0")</span>
            </div>
        </div>
    </div>

    <!-- Grafik Panelleri -->
    <div class="charts-grid">
        <!-- Sipariş Durum Dağılımı -->
        <div class="chart-card">
            <h3><i class="fa-solid fa-chart-pie" style="color: var(--primary-color);"></i> Sipariş Durum Dağılımı</h3>
            <div class="chart-canvas-container">
                <canvas id="statusChart"></canvas>
            </div>
        </div>

        <!-- Atölye Üretim Yükü -->
        <div class="chart-card">
            <h3><i class="fa-solid fa-chart-simple" style="color: #10b981;"></i> Atölye Üretim Yükü (Adet)</h3>
            <div class="chart-canvas-container">
                <canvas id="workshopChart"></canvas>
            </div>
        </div>

        <!-- Zamanında Teslimat Oranı -->
        <div class="chart-card">
            <h3><i class="fa-solid fa-business-time" style="color: #f59e0b;"></i> Teslimat Zamanlama Performansı</h3>
            <div class="chart-canvas-container">
                <canvas id="deliveryChart"></canvas>
            </div>
        </div>

        <!-- Kumaş Tedarik Durumları -->
        <div class="chart-card">
            <h3><i class="fa-solid fa-truck" style="color: #6366f1;"></i> Kumaş Tedarik Durum Dağılımı</h3>
            <div class="chart-canvas-container">
                <canvas id="fabricChart"></canvas>
            </div>
        </div>
    </div>
}

@section Scripts {
    @if (Model.TotalOrdersCount > 0)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            // Sipariş Durum Dağılımı
            const statusLabels = @Json.Serialize(Model.StatusCounts.Keys);
            const statusData = @Json.Serialize(Model.StatusCounts.Values);

            new Chart(document.getElementById('statusChart'), {
                type: 'doughnut',
                data: {
                    labels: statusLabels,
                    datasets: [{
                        data: statusData,
                        backgroundColor: [
                            '#3b82f6', // Mavi
                            '#10b981', // Yeşil
                            '#f59e0b', // Turuncu
                            '#ef4444', // Kırmızı
                            '#6366f1', // İndigo
                            '#8b5cf6'  // Mor
                        ],
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                boxWidth: 12,
                                font: { family: 'Inter', size: 12, weight: '500' }
                            }
                        }
                    },
                    cutout: '65%'
                }
            });

            // Atölye Üretim Yükü
            const wsLabels = @Json.Serialize(Model.WorkshopQuantities.Keys);
            const wsData = @Json.Serialize(Model.WorkshopQuantities.Values);

            new Chart(document.getElementById('workshopChart'), {
                type: 'bar',
                data: {
                    labels: wsLabels.length > 0 ? wsLabels : ["Atölye Yok"],
                    datasets: [{
                        label: 'Toplam Üretim',
                        data: wsData.length > 0 ? wsData : [0],
                        backgroundColor: 'rgba(16, 185, 129, 0.85)',
                        borderColor: '#10b981',
                        borderWidth: 1.5,
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: '#f1f5f9' },
                            ticks: { font: { family: 'Inter', size: 11 } }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { font: { family: 'Inter', size: 11, weight: '600' } }
                        }
                    }
                }
            });

            // Teslimat Zamanlama Performansı
            const deliveryData = [@Model.OnTimeCount, @Model.DelayedCount];
            new Chart(document.getElementById('deliveryChart'), {
                type: 'pie',
                data: {
                    labels: ['Zamanında Teslim', 'Gecikmeli Teslim / Gecikme Riski'],
                    datasets: [{
                        data: deliveryData,
                        backgroundColor: ['#10b981', '#ef4444'],
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                boxWidth: 12,
                                font: { family: 'Inter', size: 12, weight: '500' }
                            }
                        }
                    }
                }
            });

            // Kumaş Tedarik Durum Dağılımı
            const fabricLabels = @Json.Serialize(Model.FabricStatusCounts.Keys);
            const fabricData = @Json.Serialize(Model.FabricStatusCounts.Values);

            new Chart(document.getElementById('fabricChart'), {
                type: 'polarArea',
                data: {
                    labels: fabricLabels,
                    datasets: [{
                        data: fabricData,
                        backgroundColor: [
                            'rgba(99, 102, 241, 0.75)', // İndigo
                            'rgba(14, 165, 233, 0.75)', // Mavi
                            'rgba(234, 179, 8, 0.75)',  // Sarı
                            'rgba(244, 63, 94, 0.75)'   // Gül
                        ],
                        borderWidth: 1.5,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                boxWidth: 12,
                                font: { family: 'Inter', size: 11, weight: '500' }
                            }
                        }
                    },
                    scales: {
                        r: {
                            grid: { color: '#f1f5f9' },
                            ticks: { display: false }
                        }
                    }
                }
            });
        </script>
    }
}
