@using Microsoft.AspNetCore.Identity
@using UretimPlanlama.Models
@inject UserManager<ApplicationUser> UserManager
@{
    var currentUser = await UserManager.GetUserAsync(User);
    var fullName = currentUser?.FullName ?? "Misafir";
    var roleTitle = currentUser?.RoleTitle ?? "Kullanıcı";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kanuni Tekstil</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>    <div class="wrapper">
        <header class="top-navbar">
            <div class="navbar-logo">
                <a href="/">
                    <img src="~/images/logo.jpg" alt=" Kanuni Tekstil Logo " asp-append-version="true" />
                </a>
            </div>
            
            <ul class="navbar-menu">
                <li><a href="/Order" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Order" ? "active" : "")">Siparişler</a></li>
                <li><a href="/Planning" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Planning" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">Üretim Planlama</a></li>
                <li><a href="/Planning/Tracking" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Planning" && ViewContext.RouteData.Values["Action"]?.ToString() == "Tracking" ? "active" : "")">Üretim Takip</a></li>
                <li><a href="/WorkshopCapacity" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "WorkshopCapacity" ? "active" : "")">Atölye Takip</a></li>
                <li><a href="/Reports" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Reports" ? "active" : "")">Raporlar</a></li>
                
                @if (User.IsInRole("Admin"))
                {
                    <li>
                        <a href="#" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Definitions" || ViewContext.RouteData.Values["Controller"]?.ToString() == "ColorDef" || ViewContext.RouteData.Values["Controller"]?.ToString() == "Authorization" ? "active" : "")">Yönetim <i class="fa-solid fa-chevron-down"></i></a>
                        <ul class="submenu">
                            <li><a href="/Authorization" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Authorization" ? "active" : "")"><i class="fa-solid fa-user-shield"></i> Yetkilendirme</a></li>
                            <li class="divider"></li>
                            <li><a href="/ColorDef/Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "ColorDef" ? "active" : "")"><i class="fa-solid fa-palette"></i> Renk Tanımı</a></li>
                            <li><a href="/Definitions/Workshops" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Workshops" ? "active" : "")"><i class="fa-solid fa-industry"></i> Atölye Tanımı</a></li>
                            <li><a href="/Definitions/Fabricators" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Fabricators" ? "active" : "")"><i class="fa-solid fa-truck"></i> Kumaşçı Tanımı</a></li>
                            <li><a href="/Definitions/Customers" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Customers" ? "active" : "")"><i class="fa-solid fa-building"></i> Müşteri Tanımı</a></li>
                            <li><a href="/Definitions/Companies" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Companies" ? "active" : "")"><i class="fa-solid fa-building-user"></i> Firma Tanımı</a></li>
                            <li><a href="/Definitions/Accessories" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Accessories" ? "active" : "")"><i class="fa-solid fa-tags"></i> Aksesuar Tanımı</a></li>
                            <li><a href="/Definitions/Brands" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Brands" ? "active" : "")"><i class="fa-solid fa-copyright"></i> Marka Tanımı</a></li>
                        </ul>
                    </li>
                }
            </ul>

            <div class="topbar-right">
                <div class="notification-container">
                    <button class="bell-btn" id="notificationBellBtn">
                        <i class="fa-regular fa-bell"></i>
                        <span class="notification-badge" id="notificationBadge" style="display: none;">0</span>
                    </button>
                    <div class="notification-dropdown" id="notificationDropdown" style="display: none;">
                        <div class="notification-header">
                            <span>Bildirimler</span>
                            <button id="markAllReadBtn">Tümünü Okundu İşaretle</button>
                        </div>
                        <div class="notification-list" id="notificationList">
                            <div class="notification-empty">
                                <i class="fa-regular fa-bell-slash"></i>
                                <p>Henüz bildiriminiz yok.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="user-profile dropdown" id="userProfileDropdown">
                    <img src="https://ui-avatars.com/api/?name=@fullName&background=0047bb&color=fff" alt="User Profile" />
                    <div class="user-info">
                        <span class="user-name">@fullName</span>
                        <span class="user-role">@roleTitle</span>
                    </div>
                    <i class="fa-solid fa-chevron-down"></i>
                    
                    <div class="dropdown-menu" style="display: none;">
                        <a href="/Settings/Profile"><i class="fa-solid fa-user"></i> Profili Düzenle</a>
                        <div class="dropdown-divider"></div>
                        <a href="/Account/Logout" class="logout-link"><i class="fa-solid fa-right-from-bracket"></i> Çıkış Yap</a>
                    </div>
                </div>
            </div>
        </header>

        <main class="main-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function() {
            // Açılır menüler (dropdown), üst gezinti çubuğunda CSS hover ile stillendirilmiştir

            
            $('#userProfileDropdown').click(function(e) {
                e.stopPropagation();
                const $dropdownMenu = $(this).find('.dropdown-menu');
                const isOpen = $dropdownMenu.is(':visible');
                
                // Diğer açılır menüleri kapat
                $('#notificationDropdown').fadeOut(150);
                $('#notificationBellBtn').removeClass('active');
                
                if (isOpen) {
                    $dropdownMenu.fadeOut(150);
                    $(this).removeClass('active');
                } else {
                    $dropdownMenu.fadeIn(150);
                    $(this).addClass('active');
                }
            });

            $(document).click(function() {
                $('#userProfileDropdown .dropdown-menu').fadeOut(150);
                $('#userProfileDropdown').removeClass('active');
                $('#notificationDropdown').fadeOut(150);
                $('#notificationBellBtn').removeClass('active');
            });

            $('#userProfileDropdown .dropdown-menu').click(function(e) {
                e.stopPropagation();
            });

            // --- Gerçek Zamanlı Bildirim Sistemi JS ---
            const $bellBtn = $('#notificationBellBtn');
            const $dropdown = $('#notificationDropdown');
            const $badge = $('#notificationBadge');
            const $list = $('#notificationList');
            const $markAllBtn = $('#markAllReadBtn');
            
            // Açılır menüyü aç/kapat
            $bellBtn.on('click', function(e) {
                e.stopPropagation();
                const isOpen = $dropdown.is(':visible');
                
                // Diğer açılır menüleri kapat
                $('#userProfileDropdown .dropdown-menu').fadeOut(150);
                $('#userProfileDropdown').removeClass('active');
                
                if (isOpen) {
                    $dropdown.fadeOut(150);
                    $bellBtn.removeClass('active');
                } else {
                    $dropdown.fadeIn(150);
                    $bellBtn.addClass('active');
                }
            });
            
            $dropdown.on('click', function(e) {
                e.stopPropagation();
            });
            
            // Bildirimleri getir
            function loadNotifications() {
                $.ajax({
                    url: '/Notifications/GetUnread',
                    type: 'GET',
                    success: function(data) {
                        renderNotifications(data.notifications, data.unreadCount);
                    }
                });
            }
            
            function renderNotifications(notifications, unreadCount) {
                if (unreadCount > 0) {
                    $badge.text(unreadCount).show();
                } else {
                    $badge.hide();
                }
                
                if (!notifications || notifications.length === 0) {
                    $list.html(`
                        <div class="notification-empty">
                            <i class="fa-regular fa-bell-slash"></i>
                            <p>Henüz bildiriminiz yok.</p>
                        </div>
                    `);
                    return;
                }
                
                let html = '';
                notifications.forEach(function(notif) {
                    let icon = 'fa-bell';
                    let bg = '#f1f5f9';
                    let color = '#475569';
                    
                    if (notif.type === 'Kesim') {
                        icon = 'fa-scissors';
                        bg = '#fffbeb';
                        color = '#d97706';
                    } else if (notif.type === 'Dikim') {
                        icon = 'fa-shirt';
                        bg = '#ecfeff';
                        color = '#0891b2';
                    } else if (notif.type === 'Kumaş') {
                        icon = 'fa-truck';
                        bg = '#e0e7ff';
                        color = '#4f46e5';
                    } else if (notif.type === 'Paket') {
                        icon = 'fa-box';
                        bg = '#fdf2f8';
                        color = '#db2777';
                    }
                    
                    const unreadClass = !notif.isRead ? 'unread' : '';
                    
                    html += `
                        <div class="notification-item ${unreadClass}" data-id="${notif.id}">
                            <div class="notification-icon-wrapper" style="background: ${bg}; color: ${color};">
                                <i class="fa-solid ${icon}"></i>
                            </div>
                            <div class="notification-info">
                                <div class="notification-title-row">
                                    <strong class="notification-title">${notif.title}</strong>
                                    <span class="notification-time">${notif.createdAt}</span>
                                </div>
                                <p class="notification-message">${notif.message}</p>
                            </div>
                        </div>
                    `;
                });
                
                $list.html(html);
                
                $('.notification-item').off('click').on('click', function() {
                    const id = $(this).data('id');
                    const $item = $(this);
                    $.ajax({
                        url: '/Notifications/MarkAsRead',
                        type: 'POST',
                        data: { id: id },
                        success: function() {
                            $item.removeClass('unread');
                            loadNotifications();
                        }
                    });
                });
            }
            
            $markAllBtn.on('click', function(e) {
                e.preventDefault();
                $.ajax({
                    url: '/Notifications/MarkAllAsRead',
                    type: 'POST',
                    success: function() {
                        loadNotifications();
                    }
                });
            });
            
            loadNotifications();
            
            // SignalR Kurulumu
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/notificationHub")
                .configureLogging(signalR.LogLevel.Information)
                .build();
                
            connection.on("ReceiveNotification", function(notif) {
                showLiveToast(notif.title, notif.message, notif.type);
                loadNotifications();
            });
            
            connection.start().catch(function(err) {
                return console.error(err.toString());
            });
            
            function showLiveToast(title, message, type) {
                let icon = 'fa-bell';
                let bg = 'var(--primary-color)';
                
                if (type === 'Kesim') {
                    icon = 'fa-scissors';
                    bg = '#eab308';
                } else if (type === 'Dikim') {
                    icon = 'fa-shirt';
                    bg = '#06b6d4';
                } else if (type === 'Kumaş') {
                    icon = 'fa-truck';
                    bg = '#6366f1';
                } else if (type === 'Paket') {
                    icon = 'fa-box';
                    bg = '#ec4899';
                }
                
                const toastId = 'toast-' + Date.now();
                const $toast = $(`
                    <div id="${toastId}" class="live-toast">
                        <div class="live-toast-icon" style="background: ${bg};">
                            <i class="fa-solid ${icon}"></i>
                        </div>
                        <div class="live-toast-content">
                            <div class="live-toast-header">
                                <strong class="live-toast-title">${title}</strong>
                                <button class="live-toast-close" onclick="$('#${toastId}').fadeOut(300, function(){ $(this).remove(); })">
                                    <i class="fa-solid fa-xmark"></i>
                                </button>
                            </div>
                            <p class="live-toast-message">${message}</p>
                        </div>
                    </div>
                `);
                
                $('body').append($toast);
                
                setTimeout(function() {
                    $(`#${toastId}`).fadeOut(400, function() {
                        $(this).remove();
                    });
                }, 5000);
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
